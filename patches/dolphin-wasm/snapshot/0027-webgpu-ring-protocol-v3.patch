diff --git a/Source/Core/VideoBackends/WebGPU/WebGPUCommandStream.h b/Source/Core/VideoBackends/WebGPU/WebGPUCommandStream.h
index f9dba06ff1..94145ed6c2 100644
--- a/Source/Core/VideoBackends/WebGPU/WebGPUCommandStream.h
+++ b/Source/Core/VideoBackends/WebGPU/WebGPUCommandStream.h
@@ -183,14 +183,19 @@ struct CmdRingHeader
   // makes the expanded header backward-compatible with older workers: they
   // use the explicitly messaged slots pointer and leave this word at zero.
   std::atomic<u32> protocol_flags;
+  // Protocol v3 consumer liveness. Older workers never negotiate the v3
+  // flag, so these words remain inert and retain bounded v2 behavior.
+  std::atomic<u32> consumer_state;
+  std::atomic<u32> consumer_error;
 };
 // The JS consumer maps write@i32[0], read@i32[1], capacity@i32[2],
-// upload_read@i32[3], protocol_flags@i32[4]
-// over this header — it MUST stay 20 bytes (5×u32; std::atomic<u32>
+// upload_read@i32[3], protocol_flags@i32[4], consumer_state@i32[5],
+// consumer_error@i32[6]
+// over this header — it MUST stay 28 bytes (7×u32; std::atomic<u32>
 // is 4 bytes / 4-aligned on wasm32). Guardrail flagged by the Day-27
 // transport audit.
-static_assert(sizeof(CmdRingHeader) == 20,
-              "CmdRingHeader must stay 20 bytes (JS bridge assumes fixed layout)");
+static_assert(sizeof(CmdRingHeader) == 28,
+              "CmdRingHeader must stay 28 bytes (JS bridge assumes fixed layout)");
 
 // A nonzero count means an immediate command publication failed. Passes are
 // committed transactionally below, so a failed pass never becomes visible.
@@ -356,6 +361,10 @@ public:
   u32 AllocId() { return m_next_id++; }
 
 private:
+  bool ProtocolV3Active() const;
+  bool ConsumerFailed() const;
+  bool WaitForRingSpace(u32 write, u32 count);
+  bool WaitForUploadSpace(u32 end);
   bool StagePassRecord(const CmdRecord& rec);
   void PoisonPass();
   void ResetPassStaging();
