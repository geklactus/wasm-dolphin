@@ -405,30 +486,41 @@ u32 WebGPUCommandStream::ReserveUpload(size_t len, u32 align)
   if ((m_header->protocol_flags.load(std::memory_order_acquire) &
        kProtocolUploadWatermark) != 0)
   {
-    u32 waits = 0;
-    constexpr u32 kMaxUploadWaits = 250u;
-    while (end - m_header->upload_read.load(std::memory_order_acquire) > m_upload_size)
+    if (ProtocolV3Active())
