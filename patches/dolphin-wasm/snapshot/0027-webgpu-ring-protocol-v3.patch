 }
 
+bool WebGPUCommandStream::ProtocolV3Active() const
+{
+  return m_header &&
+         (m_header->protocol_flags.load(std::memory_order_acquire) &
+          kProtocolNonDroppingBackpressure) != 0;
+}
+
+bool WebGPUCommandStream::ConsumerFailed() const
+{
+  return ProtocolV3Active() &&
+         m_header->consumer_state.load(std::memory_order_acquire) == kConsumerStateFailed;
+}
+
+bool WebGPUCommandStream::WaitForRingSpace(u32 write, u32 count)
+{
+  if (ConsumerFailed())
+    return false;
+
+  const auto is_full = [&] {
+    return write - m_header->read.load(std::memory_order_acquire) > m_capacity - count;
+  };
+  if (!is_full())
+    return true;
+
+  if (ProtocolV3Active())
+  {
+    while (is_full())
+    {
+      if (ConsumerFailed())
+        return false;
+      const u32 observed = m_header->read.load(std::memory_order_acquire);
+      emscripten_futex_wait(reinterpret_cast<volatile void*>(&m_header->read), observed, 4.0);
+    }
+    return !ConsumerFailed();
+  }
+
+  constexpr u32 kMaxSpins = 500000u;
+  u32 spins = 0;
+  while (is_full())
+  {
+    if (++spins >= kMaxSpins)
+      return false;
+  }
+  return true;
+}
+
+bool WebGPUCommandStream::WaitForUploadSpace(u32 end)
+{
+  const auto is_full = [&] {
+    return end - m_header->upload_read.load(std::memory_order_acquire) > m_upload_size;
+  };
+  if (!is_full())
+    return !ConsumerFailed();
+
+  if (ProtocolV3Active())
+  {
+    while (is_full())
+    {
+      if (ConsumerFailed())
+        return false;
+      const u32 observed = m_header->upload_read.load(std::memory_order_acquire);
+      emscripten_futex_wait(
+          reinterpret_cast<volatile void*>(&m_header->upload_read), observed, 4.0);
+    }
+    return !ConsumerFailed();
+  }
+
+  constexpr u32 kMaxUploadWaits = 250u;
+  u32 waits = 0;
+  while (is_full())
+  {
+    const u32 observed = m_header->upload_read.load(std::memory_order_acquire);
+    emscripten_futex_wait(
+        reinterpret_cast<volatile void*>(&m_header->upload_read), observed, 4.0);
+    if (++waits >= kMaxUploadWaits)
+      return false;
+  }
+  return true;
+}
