+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <memory>
+#include <string>
+
+#include <emscripten/html5_webgl.h>
+
+#include "Common/GL/GLContext.h"
+
+class GLContextEmscripten final : public GLContext
+{
+public:
+  ~GLContextEmscripten() override;
+
+  bool IsHeadless() const override;
+  std::unique_ptr<GLContext> CreateSharedContext() override;
+
+  bool MakeCurrent() override;
+  bool ClearCurrent() override;
+
+  void Update() override;
+  void Swap() override;
+  void SwapInterval(int interval) override;
+  void* GetFuncAddress(const std::string& name) override;
+
+protected:
+  bool Initialize(const WindowSystemInfo& wsi, bool stereo, bool core) override;
+
+private:
+  EMSCRIPTEN_WEBGL_CONTEXT_HANDLE m_context = 0;
+  // True when the GL context was created via direct JS getContext + GL.registerContext
+  // (the worker-mode path that bypasses Emscripten's proxy machinery). For these
+  // contexts, emscripten_webgl_commit_frame returns -3 (INVALID_TARGET) because
+  // explicitSwapControl is not on the registered context. Rely on the
+  // OffscreenCanvas auto-mirror at task boundary instead. Without this gate,
+  // PE_FINISH never fires → Melee CPU stuck in FastMeleeIdlePollLoop forever.
+  bool m_context_created_via_direct_js = false;
+};
