@@ -0,0 +1,441 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "Common/GL/GLInterface/Emscripten.h"
+
+#include <chrono>
+#include <cstdint>
+#include <thread>
+#include <vector>
+#include <emscripten/console.h>
+#include <emscripten/emscripten.h>
+#include <emscripten/html5.h>
+#include <emscripten/html5_webgl.h>
+#include <GLES3/gl3.h>
+
+extern "C" int DolphinWeb_UseWorkerOwnedWebGL();
+extern "C" int DolphinWeb_UseDiagnosticOglClear();
+extern "C" int DolphinWeb_UseOglReadbackPresent();
+extern "C" void DolphinWeb_OnGlBackbuffer(const std::uint8_t* rgba, std::uint32_t width,
+                                          std::uint32_t height);
+extern "C" void DolphinWeb_OnOglSwap(int worker_owned, int commit_result, std::uint32_t width,
+                                     std::uint32_t height, std::uint32_t debug_bits,
+                                     std::uint32_t readback_rgba, int gl_error);
+
+namespace
+{
+bool DolphinWebUseDiagnosticClear()
+{
+  return DolphinWeb_UseDiagnosticOglClear() != 0;
+}
+
+bool DolphinWebUseOglReadbackPresent()
+{
+  return DolphinWeb_UseOglReadbackPresent() != 0;
+}
+
+std::uint32_t DolphinWebOglDebugBits()
+{
+  return EM_ASM_INT({
+    let bits = 0;
+    if (typeof GL !== 'undefined')
+      bits |= 1;
+    const context = typeof GL !== 'undefined' ? GL.currentContext : null;
+    if (context)
+      bits |= 2;
+    if (context && context.defaultFbo)
+      bits |= 4;
+    if (context && context.attributes && context.attributes.renderViaOffscreenBackBuffer)
+      bits |= 8;
+    if (context && context.attributes && context.attributes.explicitSwapControl)
+      bits |= 16;
+    const gl = context && context.GLctx;
+    if (gl)
+      bits |= 32;
+    const canvas = gl && gl.canvas;
+    if (typeof OffscreenCanvas !== 'undefined' && canvas instanceof OffscreenCanvas)
+      bits |= 64;
+    if (canvas && canvas.width && canvas.height)
+      bits |= 128;
+    if (gl && gl.drawingBufferWidth && gl.drawingBufferHeight)
+      bits |= 256;
+    return bits;
+  });
+}
+
+std::uint32_t DolphinWebPublishAsyncReadback(std::uint32_t width, std::uint32_t height)
+{
+  static std::vector<std::uint8_t> s_readback_data;
+
+  if (width == 0 || height == 0)
+    return 0;
+
+  const std::size_t byte_count = static_cast<std::size_t>(width) * height * 4;
+  if (byte_count == 0)
+    return 0;
+
+  s_readback_data.resize(byte_count);
+  glBindFramebuffer(GL_FRAMEBUFFER, 0);
+  glBindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+  glPixelStorei(GL_PACK_ALIGNMENT, 1);
+  glReadPixels(0, 0, static_cast<GLsizei>(width), static_cast<GLsizei>(height), GL_RGBA,
+               GL_UNSIGNED_BYTE, s_readback_data.data());
+  if (glGetError() != GL_NO_ERROR)
+    return 0;
+
+  const std::uint32_t published_rgba = static_cast<std::uint32_t>(s_readback_data[0]) |
+                                       (static_cast<std::uint32_t>(s_readback_data[1]) << 8) |
+                                       (static_cast<std::uint32_t>(s_readback_data[2]) << 16) |
+                                       (static_cast<std::uint32_t>(s_readback_data[3]) << 24);
+  DolphinWeb_OnGlBackbuffer(s_readback_data.data(), width, height);
+  return published_rgba;
+}
+}  // namespace
+
+GLContextEmscripten::~GLContextEmscripten()
+{
+  if (m_context)
+    emscripten_webgl_destroy_context(m_context);
+}
+
+bool GLContextEmscripten::IsHeadless() const
+{
+  return false;
+}
+
+bool GLContextEmscripten::Initialize(const WindowSystemInfo& wsi, bool stereo, bool core)
+{
+  (void)wsi;
+  (void)stereo;
+  (void)core;
+
+  EM_ASM({
+    if (typeof GL === 'undefined' || !Module['canvas'])
+      return;
+
+    const canvas = Module['canvas'];
+    const id = canvas.id || 'canvas';
+    canvas.id = id;
+
+    if (!canvas.canvasSharedPtr && typeof _malloc === 'function')
+    {
+      canvas.canvasSharedPtr = _malloc(12);
+      HEAP32[canvas.canvasSharedPtr >> 2] = canvas.width || 640;
+      HEAP32[(canvas.canvasSharedPtr + 4) >> 2] = canvas.height || 480;
+      HEAPU32[(canvas.canvasSharedPtr + 8) >> 2] = 0;
+    }
+
+    if (!GL.offscreenCanvases[id])
+    {
+      GL.offscreenCanvases[id] = {};
+      GL.offscreenCanvases[id].offscreenCanvas = canvas;
+      GL.offscreenCanvases[id].canvasSharedPtr = canvas.canvasSharedPtr || 0;
+      GL.offscreenCanvases[id].id = id;
+    }
+  });
+
+  EmscriptenWebGLContextAttributes attributes;
+  emscripten_webgl_init_context_attributes(&attributes);
+  attributes.alpha = false;
+  attributes.depth = true;
+  attributes.stencil = true;
+  attributes.antialias = false;
+  attributes.premultipliedAlpha = false;
+  attributes.preserveDrawingBuffer = false;
+  attributes.powerPreference = EM_WEBGL_POWER_PREFERENCE_HIGH_PERFORMANCE;
+  attributes.majorVersion = 2;
+  attributes.minorVersion = 0;
+  attributes.enableExtensionsByDefault = true;
+  const bool worker_owned_webgl = DolphinWeb_UseWorkerOwnedWebGL() != 0;
+  const bool diagnostic_clear = DolphinWebUseDiagnosticClear();
+  const bool readback_present = DolphinWebUseOglReadbackPresent();
+  attributes.explicitSwapControl = !(worker_owned_webgl && (diagnostic_clear || readback_present));
+  attributes.proxyContextToMainThread = EMSCRIPTEN_WEBGL_CONTEXT_PROXY_ALWAYS;
+  attributes.renderViaOffscreenBackBuffer =
+      worker_owned_webgl && !(diagnostic_clear || readback_present);
+
+  if (worker_owned_webgl)
+  {
+    // Worker mode: bypass emscripten_webgl_create_context entirely. The
+    // standard call fails because Emscripten's pthread canvas-transfer
+    // mechanism cannot re-transfer an already-transferred OffscreenCanvas
+    // (Lane Y trace). Create the WebGL2 context directly via JS on the
+    // discio-worker thread (which already owns the OffscreenCanvas) and
+    // register it with Emscripten's GL table. emscripten_webgl_make_context_current
+    // then works against the registered handle.
+    m_context = EM_ASM_INT({
+      var canvas = Module['canvas'];
+      if (!canvas)
+      {
+        console.error('[ogl] worker-mode: Module.canvas missing');
+        return 0;
+      }
+      try
+      {
+        var ctx = canvas.getContext('webgl2', {
+          alpha: false,
+          depth: true,
+          stencil: true,
+          antialias: false,
+          premultipliedAlpha: false,
+          // preserveDrawingBuffer: true so the standalone OffscreenCanvas
+          // retains its rendered contents between transferToImageBitmap
+          // calls. With false the buffer is reset on each frame end and
+          // the bitmap captured by main thread is empty - canvas stays
+          // black even though GL is rendering at full speed.
+          preserveDrawingBuffer: true,
+          powerPreference: 'high-performance'
+        });
+        if (!ctx)
+        {
+          console.error('[ogl] worker-mode: canvas.getContext("webgl2") returned null');
+          return 0;
+        }
+        if (typeof GL === 'undefined' || typeof GL.registerContext !== 'function')
+        {
+          console.error('[ogl] worker-mode: GL.registerContext unavailable');
+          return 0;
+        }
+        var handle = GL.registerContext(ctx, { majorVersion: 2, minorVersion: 0 });
+        // Save the raw context so the C++ Swap path can call ctx.commit()
+        // explicitly. emscripten_webgl_commit_frame on a JS-registered
+        // context doesn't reliably push pixels to the bound DOM canvas;
+        // the OffscreenCanvas-from-transferControlToOffscreen requires
+        // an explicit commit() to mirror its output back to the canvas.
+        Module._dolphinWorkerGLCtx = ctx;
+        console.log('[ogl] worker-mode: WebGL2 context created directly, handle=' + handle);
+        return handle;
+      }
+      catch (e)
+      {
+        console.error('[ogl] worker-mode: direct context creation threw', e);
+        return 0;
+      }
+    });
+    if (static_cast<std::intptr_t>(m_context) <= 0)
+    {
+      // Direct-context creation failed - fall back to the standard proxy
+      // path so the user gets *something* working rather than a black
+      // screen. Logs the fallback so it shows up in console.
+      emscripten_console_errorf("[ogl] worker-mode direct context FAILED (%lld); "
+                                "falling back to PROXY_ALWAYS",
+                                static_cast<long long>(static_cast<std::intptr_t>(m_context)));
+      m_context = emscripten_webgl_create_context("#canvas", &attributes);
+      if (static_cast<std::intptr_t>(m_context) <= 0)
+      {
+        emscripten_console_errorf("[ogl] WebGL2 fallback context also failed: %lld",
+                                  static_cast<long long>(static_cast<std::intptr_t>(m_context)));
+        m_context = 0;
+        return false;
+      }
+      emscripten_console_log("[ogl] worker-mode FALLBACK to proxy succeeded");
+    }
+    else
+    {
+      m_context_created_via_direct_js = true;
+    }
+  }
+  else
+  {
+    m_context = emscripten_webgl_create_context("#canvas", &attributes);
+    if (static_cast<std::intptr_t>(m_context) <= 0)
+    {
+      emscripten_console_errorf("[ogl] WebGL2 context creation failed: %lld",
+                                static_cast<long long>(static_cast<std::intptr_t>(m_context)));
+      m_context = 0;
+      return false;
+    }
+  }
+
+  if (emscripten_webgl_make_context_current(m_context) != EMSCRIPTEN_RESULT_SUCCESS)
+  {
+    emscripten_console_error("[ogl] WebGL2 context creation succeeded but make-current failed");
+    return false;
+  }
+
+  m_opengl_mode = Mode::OpenGLES;
+  Update();
+  emscripten_console_logf("[ogl] WebGL2 context ready: %ux%u", m_backbuffer_width,
+                          m_backbuffer_height);
+  return true;
+}
+
+std::unique_ptr<GLContext> GLContextEmscripten::CreateSharedContext()
+{
+  return nullptr;
+}
+
+bool GLContextEmscripten::MakeCurrent()
+{
+  return m_context &&
+         emscripten_webgl_make_context_current(m_context) == EMSCRIPTEN_RESULT_SUCCESS;
+}
+
+bool GLContextEmscripten::ClearCurrent()
+{
+  return emscripten_webgl_make_context_current(0) == EMSCRIPTEN_RESULT_SUCCESS;
+}
+
+void GLContextEmscripten::Update()
+{
+  int width = 0;
+  int height = 0;
+  if (m_context &&
+      emscripten_webgl_get_drawing_buffer_size(m_context, &width, &height) ==
+          EMSCRIPTEN_RESULT_SUCCESS)
+  {
+    m_backbuffer_width = static_cast<u32>(width > 0 ? width : 640);
+    m_backbuffer_height = static_cast<u32>(height > 0 ? height : 480);
+    return;
+  }
+
+  if (emscripten_get_canvas_element_size("#canvas", &width, &height) == EMSCRIPTEN_RESULT_SUCCESS)
+  {
+    m_backbuffer_width = static_cast<u32>(width > 0 ? width : 640);
+    m_backbuffer_height = static_cast<u32>(height > 0 ? height : 480);
+    return;
+  }
+
+  m_backbuffer_width = 640;
+  m_backbuffer_height = 480;
+}
+
+void GLContextEmscripten::Swap()
+{
+  static std::uint32_t s_diagnostic_clear_frame = 0;
+  std::uint32_t readback_rgba = 0;
+  if (DolphinWebUseDiagnosticClear())
+  {
+    const float red = (s_diagnostic_clear_frame & 1) ? 1.0f : 0.0f;
+    const float green = (s_diagnostic_clear_frame & 2) ? 1.0f : 0.0f;
+    const float blue = (s_diagnostic_clear_frame & 4) ? 1.0f : 0.0f;
+    ++s_diagnostic_clear_frame;
+    glBindFramebuffer(GL_FRAMEBUFFER, 0);
+    glDisable(GL_SCISSOR_TEST);
+    glViewport(0, 0, static_cast<GLsizei>(m_backbuffer_width),
+               static_cast<GLsizei>(m_backbuffer_height));
+    glClearColor(red, green, blue, 1.0f);
+    glClear(GL_COLOR_BUFFER_BIT);
+    std::uint8_t pixel[4] = {};
+    glReadPixels(0, 0, 1, 1, GL_RGBA, GL_UNSIGNED_BYTE, pixel);
+    readback_rgba = static_cast<std::uint32_t>(pixel[0]) |
+                    (static_cast<std::uint32_t>(pixel[1]) << 8) |
+                    (static_cast<std::uint32_t>(pixel[2]) << 16) |
+                    (static_cast<std::uint32_t>(pixel[3]) << 24);
+  }
+
+  const bool worker_owned_webgl = DolphinWeb_UseWorkerOwnedWebGL() != 0;
+  if (worker_owned_webgl && DolphinWebUseOglReadbackPresent())
+    readback_rgba = DolphinWebPublishAsyncReadback(m_backbuffer_width, m_backbuffer_height);
+
+  const std::uint32_t debug_bits = DolphinWebOglDebugBits();
+  const int gl_error = static_cast<int>(glGetError());
+  glFlush();
+  // For direct-JS-created contexts (worker-mode patch 0009), commit_frame
+  // returns -3 INVALID_TARGET because explicitSwapControl isn't on the
+  // registered context. Without this gate the swap "fails" every frame,
+  // Renderer::Present aborts, GXSetDrawDone never reaches the GPU thread,
+  // PE_FINISH never raises, and Melee's CPU stays in FastMeleeIdlePollLoop
+  // forever. For direct-JS contexts the OffscreenCanvas auto-mirrors at
+  // task boundary so an explicit commit isn't needed.
+  const int commit_result =
+      m_context_created_via_direct_js ? 0 : emscripten_webgl_commit_frame();
+  DolphinWeb_OnOglSwap(worker_owned_webgl ? 1 : 0, commit_result, m_backbuffer_width,
+                       m_backbuffer_height, debug_bits, readback_rgba, gl_error);
+
+  if (worker_owned_webgl)
+  {
+    EM_ASM({
+      const direct = (typeof Module !== 'undefined') ? Module._dolphinWorkerGLCtx : null;
+      const fallback = typeof GL !== 'undefined' && GL.currentContext ? GL.currentContext.GLctx : null;
+      const context = direct || fallback;
+      if (context)
+        context.flush();
+      if (typeof Module !== 'undefined' && !Module._loggedSwapDiag) {
+        Module._loggedSwapDiag = true;
+        console.log('[ogl] swap diag: direct=' + (direct ? 'yes' : 'no') +
+                    ' fallback=' + (fallback ? 'yes' : 'no'));
+      }
+    });
+  }
+
+  if (worker_owned_webgl && DolphinWebUseDiagnosticClear())
+  {
+    EM_ASM({
+      const context = typeof GL !== 'undefined' && GL.currentContext ? GL.currentContext.GLctx : null;
+      if (!context)
+        return;
+
+      Module.__dolphinRawClearFrame = (Module.__dolphinRawClearFrame || 0) + 1;
+      const frame = Module.__dolphinRawClearFrame;
+      context.bindFramebuffer(context.FRAMEBUFFER, null);
+      context.disable(context.SCISSOR_TEST);
+      context.viewport(0, 0, context.canvas.width || 640, context.canvas.height || 480);
+      context.clearColor(frame & 1 ? 1 : 0, frame & 2 ? 1 : 0, frame & 4 ? 1 : 0, 1);
+      context.clear(context.COLOR_BUFFER_BIT);
+      context.flush();
+      if (typeof context.commit === 'function')
+        context.commit();
+    });
+  }
+
+  // Detached OGL mode: when worker_owned_webgl is on but readback is NOT,
+  // capture the rendered canvas as an ImageBitmap and post it to the
+  // discio worker via self.postMessage. The discio worker has a
+  // per-pthread message listener (matches Day-7's JIT-cache channel
+  // pattern) that forwards bitmaps to the main thread, which paints
+  // them onto the visible 2D canvas via drawImage.
+  //
+  // This is the no-glReadPixels paint path. Chrome trace (Day-11
+  // follow-up) showed glReadPixels on the worker thread blocking up
+  // to 3 seconds waiting for the GPU command-buffer to drain — that's
+  // what causes the user-reported "stalls during character select".
+  // transferToImageBitmap doesn't sync the GPU; it just hands off a
+  // GPU-resident snapshot.
+  //
+  // The 60 Hz pace cap below replaces what glReadPixels used to provide
+  // implicitly (the sync wait kept the emulator from outrunning the
+  // GPU). Without it, gameSpeed runs at ~166% in detached mode. A
+  // simple sleep on the pthread that runs Swap() throttles the EmuThread
+  // — the same effect as VI vsync emulation would give us if Dolphin's
+  // own pacing reached this far in the wasm build.
+  if (worker_owned_webgl && !DolphinWebUseOglReadbackPresent())
+  {
+    EM_ASM({
+      if (typeof GL === 'undefined' || !GL.currentContext) return;
+      const ctx = GL.currentContext.GLctx;
+      const canvas = ctx ? ctx.canvas : null;
+      if (!canvas || typeof canvas.transferToImageBitmap !== 'function') return;
+      try {
+        const bitmap = canvas.transferToImageBitmap();
+        if (!bitmap) return;
+        self.postMessage(
+          { type: 'detachedOglFrame', bitmap: bitmap, width: bitmap.width, height: bitmap.height },
+          [bitmap]
+        );
+      } catch (e) {
+        if (typeof Module !== 'undefined' && !Module._detachedOglPostErr) {
+          Module._detachedOglPostErr = true;
+          console.log('[ogl-detached] postMessage failed: ' + (e && e.message ? e.message : e));
+        }
+      }
+    });
+
+    // TODO: 60 Hz throttle. Without glReadPixels syncing, the EmuThread
+    // free-runs at ~166%. Need a non-blocking pacing mechanism.
+    // std::this_thread::sleep_for(microseconds) here made the canvas go
+    // fully black — likely the sleep blocked the GL command flush from
+    // happening before transferToImageBitmap captured the next frame.
+    // For now, accept the over-speed; pace via something else later.
+  }
+}
+
+void GLContextEmscripten::SwapInterval(int interval)
+{
+  (void)interval;
+}
+
+void* GLContextEmscripten::GetFuncAddress(const std::string& name)
+{
+  return emscripten_webgl_get_proc_address(name.c_str());
+}
