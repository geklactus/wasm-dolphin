From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: wasm-dolphin patch snapshot <snapshot@local.invalid>
Date: Thu, 22 Oct 2026 14:17:30 +0000
Subject: [PATCH] 0007-hermetic-build-inputs


diff --git a/Source/Core/Core/CMakeLists.txt b/Source/Core/Core/CMakeLists.txt
index 26bd330a3f..014e0026ba 100644
--- a/Source/Core/Core/CMakeLists.txt
+++ b/Source/Core/Core/CMakeLists.txt
@@ -874,20 +874,23 @@ if(EMSCRIPTEN AND DOLPHIN_WASM_CORE_SOURCE)
   # wgpuDeviceCreateShaderModule. Linked here as a full-archive blob
   # so the `naga_spirv_to_wgsl` / `naga_free_wgsl` C symbols survive
   # to WebGPUShaderTranslator.cpp.
-  # Absolute path to the wasm-dolphin project root (CMAKE_SOURCE_DIR
-  # here is the vendored Dolphin tree, not the project). Same hardcode
-  # style as the jit-cache pre-js path below.
-  set(NAGA_WGSL_LIB
-    "C:/Users/douglaswhittingham/wasm-dolphin/tools/naga-spirv-wgsl/target/wasm32-unknown-emscripten/release/libnaga_spirv_wgsl.a")
-  if(EXISTS "${NAGA_WGSL_LIB}")
-    target_link_libraries(dolphin_web_core PRIVATE "${NAGA_WGSL_LIB}")
-  else()
-    message(WARNING
-      "naga-spirv-wgsl staticlib not found at ${NAGA_WGSL_LIB}; "
-      "WebGPU shader translation will fall back to the Software path. "
-      "Build it: cd tools/naga-spirv-wgsl && cargo build --release "
-      "--target wasm32-unknown-emscripten")
+  if(NOT DOLPHIN_WASM_NAGA_WGSL_LIB OR NOT EXISTS "${DOLPHIN_WASM_NAGA_WGSL_LIB}")
+    message(FATAL_ERROR
+      "DOLPHIN_WASM_NAGA_WGSL_LIB must name the pinned Naga static library. "
+      "Run the wasm-dolphin configure script; it builds the crate with --locked first.")
+  endif()
+  target_link_libraries(dolphin_web_core PRIVATE "${DOLPHIN_WASM_NAGA_WGSL_LIB}")
+
+  if(NOT DOLPHIN_WASM_JIT_CACHE_PRE_JS OR NOT EXISTS "${DOLPHIN_WASM_JIT_CACHE_PRE_JS}")
+    message(FATAL_ERROR "DOLPHIN_WASM_JIT_CACHE_PRE_JS must name the tracked pre-js file")
+  endif()
+
+  if(NOT DOLPHIN_WASM_MEMORY_PAGES MATCHES "^[0-9]+$")
+    message(FATAL_ERROR "DOLPHIN_WASM_MEMORY_PAGES must be a positive integer")
   endif()
+  math(EXPR DOLPHIN_WASM_INITIAL_MEMORY_BYTES "${DOLPHIN_WASM_MEMORY_PAGES} * 65536")
+  target_compile_definitions(core PRIVATE DOLPHIN_WASM_MEMORY_PAGES=${DOLPHIN_WASM_MEMORY_PAGES})
+  target_compile_definitions(dolphin_web_core PRIVATE DOLPHIN_WASM_MEMORY_PAGES=${DOLPHIN_WASM_MEMORY_PAGES})
 
   # Day-14 (wasm-dolphin): enable the WebGPU scaffold backend on the
   # wasm target. HAS_WEBGPU gates both the include of WebGPU/VideoBackend.h
@@ -915,7 +918,7 @@ if(EMSCRIPTEN AND DOLPHIN_WASM_CORE_SOURCE)
     # works in both browsers. (Memory-growth + pthread was tried and
     # produced a slow non-wasm warning plus broke ROM mount.)
     "-sALLOW_MEMORY_GROWTH=0"
-    "-sINITIAL_MEMORY=1610612736"
+    "-sINITIAL_MEMORY=${DOLPHIN_WASM_INITIAL_MEMORY_BYTES}"
     "-sFILESYSTEM=1"
     "-lworkerfs.js"
     "-lnodefs.js"
@@ -951,6 +954,6 @@ if(EMSCRIPTEN AND DOLPHIN_WASM_CORE_SOURCE)
     # local Module object so the EM_JS compile body can hit it. See
     # patches/dolphin-wasm/SESSION-2026-05-12-DAY-7-NOTES.md.
     "--pre-js"
-    "C:/Users/douglaswhittingham/wasm-dolphin/tools/jit-cache-prejs.js"
+    "${DOLPHIN_WASM_JIT_CACHE_PRE_JS}"
   )
 endif()
diff --git a/Source/Core/Core/PowerPC/CachedInterpreter/CachedInterpreter.cpp b/Source/Core/Core/PowerPC/CachedInterpreter/CachedInterpreter.cpp
index baa8630d0b..89cba88e6a 100644
--- a/Source/Core/Core/PowerPC/CachedInterpreter/CachedInterpreter.cpp
+++ b/Source/Core/Core/PowerPC/CachedInterpreter/CachedInterpreter.cpp
@@ -7381,8 +7381,11 @@ std::vector<u8> BuildWasmCachedInterpreterBlock(std::span<const PPCAnalyst::Code
   // max 16384") at JIT warmup, which is exactly when blocks first compile
   // (~frame 700). Crash blocked wasmjit=1 in software backend; bumping the
   // ceiling also unblocks block compilation for OGL+forcejit=1.
-  EmitU32Leb(imports, 24576);
-  EmitU32Leb(imports, 24576);
+#ifndef DOLPHIN_WASM_MEMORY_PAGES
+#error "DOLPHIN_WASM_MEMORY_PAGES must be supplied by the pinned CMake configuration"
+#endif
+  EmitU32Leb(imports, DOLPHIN_WASM_MEMORY_PAGES);
+  EmitU32Leb(imports, DOLPHIN_WASM_MEMORY_PAGES);
   EmitSection(bytes, 2, imports);
 
   EmitSection(bytes, 3, {0x01, 0x00});
