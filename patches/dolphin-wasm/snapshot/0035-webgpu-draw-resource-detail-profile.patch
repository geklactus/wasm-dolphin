diff --git a/Source/Core/VideoCommon/WasmWebGpuDrawProfile.h b/Source/Core/VideoCommon/WasmWebGpuDrawProfile.h
new file mode 100644
index 0000000000..c84d50ebce
--- /dev/null
+++ b/Source/Core/VideoCommon/WasmWebGpuDrawProfile.h
@@ -0,0 +1,168 @@
+// Copyright 2026 Dolphin Emulator Project (wasm-dolphin fork)
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+
+namespace DolphinWeb::WebGpuDrawProfile
+{
+// These scopes are intentionally independent. Some phases are nested in broader
+// renderer work, so their estimated totals must not be summed.
+enum class Phase : std::size_t
+{
+  PipelineUidBuild = 0,
+  PipelineCacheLookup,
+  DrawResourceInit,
+  UniformPrepare,
+  TextureSamplerResolve,
+  BindResourceRecord,
+  CommandStage,
+  Count,
+};
+
+constexpr std::size_t PHASE_COUNT = static_cast<std::size_t>(Phase::Count);
+constexpr std::array<std::uint32_t, PHASE_COUNT> SAMPLE_PERIODS = {
+    64, 64, 256, 64, 64, 64, 256,
+};
+constexpr std::array<std::uint32_t, PHASE_COUNT> SAMPLE_STRIDES = {
+    17, 29, 37, 43, 53, 59, 61,
+};
+constexpr std::array<std::uint32_t, PHASE_COUNT> SAMPLE_SEEDS = {
+    3, 7, 11, 13, 19, 23, 31,
+};
+constexpr std::uint32_t ENABLE_REFRESH_PERIOD = 1024;
+constexpr bool ValidSampleConfiguration()
+{
+  for (std::size_t index = 0; index < PHASE_COUNT; ++index)
+  {
+    const std::uint32_t period = SAMPLE_PERIODS[index];
+    if (period == 0 || (period & (period - 1)) != 0 || (SAMPLE_STRIDES[index] & 1) == 0)
+      return false;
+  }
+  return true;
+}
+static_assert(ValidSampleConfiguration(),
+              "draw profile periods must be powers of two and strides must be odd");
+
+struct PhaseCounters
+{
+  std::atomic<std::uint64_t> calls{0};
+  std::atomic<std::uint64_t> samples{0};
+  std::atomic<std::uint64_t> sampled_total_ns{0};
+  std::atomic<std::uint64_t> sampled_max_ns{0};
+};
+
+constexpr std::uint64_t ENABLED_MASK = 1;
+inline std::atomic<std::uint64_t> s_control{0};
+inline std::array<PhaseCounters, PHASE_COUNT> s_counters{};
+
+struct ThreadEnableCache
+{
+  std::uint64_t control_snapshot = std::numeric_limits<std::uint64_t>::max();
+  std::uint32_t calls_until_refresh = 0;
+  bool enabled = false;
+};
+inline thread_local ThreadEnableCache s_thread_enable_cache{};
+
+inline void SetEnabled(bool enabled)
+{
+  const std::uint64_t enabled_bit = enabled ? ENABLED_MASK : 0;
+  std::uint64_t control = s_control.load(std::memory_order_acquire);
+  while ((control & ENABLED_MASK) != enabled_bit)
+  {
+    const std::uint64_t next_epoch = (control >> 1) + 1;
+    const std::uint64_t desired = (next_epoch << 1) | enabled_bit;
+    if (s_control.compare_exchange_weak(control, desired, std::memory_order_release,
+                                        std::memory_order_acquire))
+      return;
+  }
+}
+
+inline bool IsEnabled()
+{
+  return (s_control.load(std::memory_order_acquire) & ENABLED_MASK) != 0;
+}
+
+inline std::uint64_t GetEpoch()
+{
+  return s_control.load(std::memory_order_acquire) >> 1;
+}
+
+inline bool IsEnabledCached()
+{
+  ThreadEnableCache& cache = s_thread_enable_cache;
+  if (cache.calls_until_refresh == 0)
+  {
+    const std::uint64_t control = s_control.load(std::memory_order_acquire);
+    if (cache.control_snapshot != control)
+    {
+      cache.enabled = (control & ENABLED_MASK) != 0;
+      cache.control_snapshot = control;
+    }
+    cache.calls_until_refresh = ENABLE_REFRESH_PERIOD;
+  }
+  --cache.calls_until_refresh;
+  return cache.enabled;
+}
+
+inline const PhaseCounters& GetCounters(Phase phase)
+{
+  return s_counters[static_cast<std::size_t>(phase)];
+}
+
+inline std::uint32_t GetSamplePeriod(Phase phase)
+{
+  return SAMPLE_PERIODS[static_cast<std::size_t>(phase)];
+}
+
+inline bool ShouldSample(Phase phase, std::uint64_t call)
+{
+  const std::size_t index = static_cast<std::size_t>(phase);
+  const std::uint64_t period = SAMPLE_PERIODS[index];
+  const std::uint64_t mask = period - 1;
+  const std::uint64_t block = call / period;
+  const std::uint64_t slot = call & mask;
+  const std::uint64_t target =
+      (block * SAMPLE_STRIDES[index] + SAMPLE_SEEDS[index]) & mask;
+  return slot == target;
+}
