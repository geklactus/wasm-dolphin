+
+      EmitLocalGet(body, 2);
+      body.push_back(0x45);
+      EmitLocalGet(body, 3);
+      EmitI32Const(body, 0x80000000);
+      body.push_back(0x46);
+      EmitLocalGet(body, 2);
+      EmitI32Const(body, 0xffffffff);
+      body.push_back(0x46);
+      body.push_back(0x71);
+      body.push_back(0x72);
+      body.push_back(0x04);
+      body.push_back(0x7f);
