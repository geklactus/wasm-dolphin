+void EmitFpuAvailableOrFallback(std::vector<u8>& body, const PPCAnalyst::CodeOp& op,
+                                const WasmStateLayout& layout, u32 downcount)
+{
+  EmitStateLoadU32(body, layout.msr_offset);
+  EmitI32Const(body, 1u << 13);
+  body.push_back(0x71);
+  body.push_back(0x04);
