+      EmitI32Const(body, 32);
+      EmitLocalGet(body, 2);
+      body.push_back(0x6b);
+      body.push_back(0x74);
+      EmitLocalGet(body, 3);
+      body.push_back(0x71);
+      EmitI32Const(body, 0);
+      body.push_back(0x47);
+      body.push_back(0x71);
+      EmitLocalSet(body, 2);
+      body.push_back(0x0b);
