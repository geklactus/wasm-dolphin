+  EmitLocalSet(body, 2);
+  if (l1_cache)
+    EmitStoreU32BigEndianToL1AddressOffset(body, layout, 0);
+  else
+    EmitStoreU32BigEndianToRamAddressOffset(body, layout, 0);
+}
