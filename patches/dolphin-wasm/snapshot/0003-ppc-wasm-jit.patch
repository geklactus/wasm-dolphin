+      EmitLocalGet(body, 2);
+      body.push_back(0x6a);
+      EmitLocalSet(body, 3);
+      EmitStateStoreU32Prefix(body);
+      EmitLocalGet(body, 3);
+      EmitStateStoreU32Suffix(body, GprOffset(layout, inst.RD));
+
+      EmitStateStoreU32Prefix(body);
+      EmitLocalGet(body, 2);
+      EmitLocalGet(body, 3);
+      body.push_back(0x45);
+      body.push_back(0x71);
