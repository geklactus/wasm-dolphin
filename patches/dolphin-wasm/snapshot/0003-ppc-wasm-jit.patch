diff --git a/Source/Core/Common/LazyMemoryRegionBitSet.cpp b/Source/Core/Common/LazyMemoryRegionBitSet.cpp
index 89f707daa0..804dc4409d 100644
--- a/Source/Core/Common/LazyMemoryRegionBitSet.cpp
+++ b/Source/Core/Common/LazyMemoryRegionBitSet.cpp
@@ -93,4 +93,46 @@ void LazyMemoryRegionBitSet::ClearBits(size_t bits_start, size_t bits_end)
     m_pointer[bits_end / 32] &= extra_last_word;
 }
 
+bool LazyMemoryRegionBitSet::ClearBitsAndTestAny(size_t bits_start, size_t bits_end)
+{
+  if (bits_start >= bits_end)
+    return false;
+
+  CheckBitIndicesWriteable(bits_start, bits_end);
+
+  const u32 extra_first_word = ~(0xFFFFFFFF << bits_start % 32);
+  const u32 extra_last_word = 0xFFFFFFFF << bits_end % 32;
+  bool any = false;
+
+  if (bits_start / 32 == bits_end / 32)
+  {
+    const u32 keep = extra_first_word | extra_last_word;
+    any = (m_pointer[bits_start / 32] & ~keep) != 0;
+    m_pointer[bits_start / 32] &= keep;
+    return any;
+  }
+
+  if (bits_start % 32 != 0)
+  {
+    any |= (m_pointer[bits_start / 32] & ~extra_first_word) != 0;
+    m_pointer[bits_start / 32] &= extra_first_word;
+  }
+
+  const size_t start_index = Common::DivideRoundingUp(bits_start, 32);
+  const size_t end_index = bits_end / 32;
+  for (size_t i = start_index; i < end_index; ++i)
+  {
+    any |= m_pointer[i] != 0;
+    m_pointer[i] = 0;
+  }
+
+  if (bits_end % 32 != 0)
+  {
+    any |= (m_pointer[bits_end / 32] & ~extra_last_word) != 0;
+    m_pointer[bits_end / 32] &= extra_last_word;
+  }
+
+  return any;
+}
+
 }  // namespace Common
