+  body.push_back(0x47);
+
+  EmitStateLoadU32(body, layout.msr_offset);
+  EmitI32Const(body, 1);
+  body.push_back(0x71);
+  body.push_back(0x45);
+  body.push_back(0x71);
+
+  EmitLocalGet(body, 1);
+  EmitI32Const(body, 3);
+  body.push_back(0x71);
+  body.push_back(0x45);
+  body.push_back(0x71);
+
+  EmitLocalGet(body, 1);
+  EmitI32Const(body, 0x0ffff000);
+  body.push_back(0x71);
+  EmitI32Const(body, GPFifo::GATHER_PIPE_PHYSICAL_ADDRESS);
+  body.push_back(0x46);
+  body.push_back(0x71);
+}
