+  LR(ppc_state) = return_pc;
+  if (function_pc == 0 ||
+      !ExecuteFastOsInterruptInline(ppc_state, system.GetPowerPC(), function_pc, return_pc, mode,
+                                    cycles_primary, cycles_secondary))
+  {
+    ppc_state.npc = function_pc;
+    ++s_fast_os_interrupt_inline_fallbacks;
+  }
+  return 0;
