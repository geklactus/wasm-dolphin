diff --git a/Source/Core/VideoBackends/WebGPU/WebGPUCommandStream.h b/Source/Core/VideoBackends/WebGPU/WebGPUCommandStream.h
index 0b8745dd48..3c7c729fc8 100644
--- a/Source/Core/VideoBackends/WebGPU/WebGPUCommandStream.h
+++ b/Source/Core/VideoBackends/WebGPU/WebGPUCommandStream.h
@@ -63,7 +63,7 @@ enum class CmdOp : u32
 
   // ---- Phase A (Day-33): full AbstractGfx opcode set --------------
   // Resource creation / upload.
-  //   CreateBuffer:   u0=id u1=size u2=usageFlags
+  //   CreateBuffer:   u0=id u1=size u2=usageFlags u3=BufferResourceRole
   CreateBuffer = 5,
   //   UploadBuffer:   u0=id u1=dstOffset u2=srcHeapPtr u3=len u4=BufferUploadRole
   //   (srcHeapPtr is an absolute wasm-heap offset into the upload
@@ -139,6 +139,17 @@ enum class BufferUploadRole : u32
   Count = 7,
 };
 
+// Stable identity for buffers whose consumer-side usage or replay strategy
+// differs from ordinary resources. This travels in CreateBuffer's previously
+// unused fourth payload word; old producers and consumers therefore remain
+// compatible through the Unknown zero value.
+enum class BufferResourceRole : u32
+{
+  Unknown = 0,
+  UboRing = 1,
+  Count = 2,
+};
+
 struct UploadPacket
 {
   u32 src_heap_ptr = 0;
@@ -331,7 +342,8 @@ public:
       const DenseUboPacketPlan& plan,
       const std::array<DenseUboClass, kDenseUboClassCount>& classes);
 
-  u32 PushCreateBuffer(u32 size, u32 usage_flags);
+  u32 PushCreateBuffer(u32 size, u32 usage_flags,
+                       BufferResourceRole role = BufferResourceRole::Unknown);
   bool PushUploadBuffer(u32 id, u32 dst_offset, u32 src_heap_ptr, u32 len,
                         BufferUploadRole role);
   u32 PushCreateTexture(u32 w, u32 h, u32 wgpu_format, u32 usage_flags, u32 layers = 1);
