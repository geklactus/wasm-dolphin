   }
 }
 
-u32 WebGPUCommandStream::PushCreateBuffer(u32 size, u32 usage_flags)
+u32 WebGPUCommandStream::PushCreateBuffer(u32 size, u32 usage_flags, BufferResourceRole role)
 {
   if (!m_header)
   {
@@ -1023,6 +1023,7 @@ u32 WebGPUCommandStream::PushCreateBuffer(u32 size, u32 usage_flags)
