diff --git a/Source/Core/VideoCommon/WasmWebGpuProducerProfile.h b/Source/Core/VideoCommon/WasmWebGpuProducerProfile.h
new file mode 100644
index 0000000000..e6a7e80cb9
--- /dev/null
+++ b/Source/Core/VideoCommon/WasmWebGpuProducerProfile.h
@@ -0,0 +1,126 @@
+// Copyright 2026 Dolphin Emulator Project (wasm-dolphin fork)
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+
+namespace DolphinWeb::WebGpuProducerProfile
+{
+// Scopes are intentionally inclusive and non-additive: nested phase timings can overlap.
+// Sampled totals are per-phase estimates and must not be summed into a producer total.
+// FifoTailFlush covers the dual-core idle-tail Flush/RefreshPeekCache path; RunGpuOnCpu has
+// no equivalent final flush pair.
+enum class Phase : std::size_t
+{
+  RingPublish = 0,
+  UploadCopy,
+  GeometryCommit,
+  DrawResources,
+  ShaderTranslateEmit,
+  PipelineSerializeEmit,
+  BindGroupPrepare,
+  XfbShowImage,
+  BackbufferPresent,
+  FifoDecode,
+  FifoTailFlush,
+  Reserved,
+  Count,
+};
+
+constexpr std::size_t PHASE_COUNT = static_cast<std::size_t>(Phase::Count);
+constexpr std::array<std::uint32_t, PHASE_COUNT> SAMPLE_PERIODS = {
+    256, 256, 64, 64, 1, 1, 1, 1, 1, 256, 64, 1,
+};
+
+struct PhaseCounters
+{
+  std::atomic<std::uint64_t> calls{0};
+  std::atomic<std::uint64_t> samples{0};
+  std::atomic<std::uint64_t> sampled_total_ns{0};
+  std::atomic<std::uint64_t> sampled_max_ns{0};
+};
+
+inline std::atomic<bool> s_enabled{false};
+inline std::atomic<std::uint64_t> s_epoch{0};
+inline std::array<PhaseCounters, PHASE_COUNT> s_counters{};
+
+inline void SetEnabled(bool enabled)
+{
+  const bool previous = s_enabled.exchange(enabled, std::memory_order_acq_rel);
+  if (previous != enabled)
+    s_epoch.fetch_add(1, std::memory_order_relaxed);
+}
+
+inline bool IsEnabled()
+{
+  return s_enabled.load(std::memory_order_relaxed);
+}
+
+inline std::uint64_t GetEpoch()
+{
+  return s_epoch.load(std::memory_order_relaxed);
+}
+
+inline const PhaseCounters& GetCounters(Phase phase)
+{
+  return s_counters[static_cast<std::size_t>(phase)];
+}
+
+inline std::uint32_t GetSamplePeriod(Phase phase)
+{
+  return SAMPLE_PERIODS[static_cast<std::size_t>(phase)];
+}
+
+class ScopedSample final
+{
+public:
+  explicit ScopedSample(Phase phase) : m_phase(phase)
+  {
+    if (!IsEnabled())
+      return;
+
+    PhaseCounters& counters = s_counters[static_cast<std::size_t>(phase)];
+    const std::uint64_t call = counters.calls.fetch_add(1, std::memory_order_relaxed);
+    if (call % GetSamplePeriod(phase) != 0)
+      return;
+
+    m_sampled = true;
+    m_start = Clock::now();
+  }
+
+  ~ScopedSample()
+  {
+    if (!m_sampled)
+      return;
+
+    const auto duration =
+        std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now() - m_start).count();
+    const std::uint64_t duration_ns = static_cast<std::uint64_t>(duration);
+    PhaseCounters& counters = s_counters[static_cast<std::size_t>(m_phase)];
+    counters.samples.fetch_add(1, std::memory_order_relaxed);
+    counters.sampled_total_ns.fetch_add(duration_ns, std::memory_order_relaxed);
+
+    std::uint64_t previous_max = counters.sampled_max_ns.load(std::memory_order_relaxed);
+    while (previous_max < duration_ns &&
+           !counters.sampled_max_ns.compare_exchange_weak(previous_max, duration_ns,
+                                                          std::memory_order_relaxed))
+    {
+    }
+  }
+
+  ScopedSample(const ScopedSample&) = delete;
+  ScopedSample& operator=(const ScopedSample&) = delete;
+
+private:
+  using Clock = std::chrono::steady_clock;
+
+  Phase m_phase;
+  Clock::time_point m_start{};
+  bool m_sampled = false;
+};
+}  // namespace DolphinWeb::WebGpuProducerProfile
