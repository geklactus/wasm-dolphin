From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: wasm-dolphin patch snapshot <snapshot@local.invalid>
Date: Thu, 22 Oct 2026 14:39:05 +0000
Subject: [PATCH] 0068-emscripten-lazy-memory-region

Emscripten implementation of Common::LazyMemoryRegion (upstream #14804 made
JitBaseBlockCache::valid_block and the three JitBase instruction bit sets
LazyMemoryRegionBitSets). The Unix implementation's Clear() remaps with
MAP_FIXED, which Emscripten's mmap rejects (any address hint is EINVAL), and
its anonymous mmap is memalign + memset over the whole length, committing
every page of sets that are almost entirely empty (3 x 128 MiB + 16 MiB).

Regions now come straight from sbrk: the wasm linear memory is a fixed size
(-sALLOW_MEMORY_GROWTH=0) and bytes above the program break have never been
written, so they read as zero without the browser backing them. Writers
already announce their pages through EnsureMemoryPageWritable (the Windows
build relies on the same invariant), so Clear() zeroes only the dirty pages.
sbrk can't give memory back; Release() pools the zeroed region for the next
Create() of the same size.

diff --git a/Source/Core/Common/MemArena.h b/Source/Core/Common/MemArena.h
index 188164beff..8add5a99d6 100644
--- a/Source/Core/Common/MemArena.h
+++ b/Source/Core/Common/MemArena.h
@@ -161,6 +161,7 @@ class LazyMemoryRegion final
 {
 public:
   constexpr static size_t WINDOWS_BLOCK_SIZE = 1024 * 1024;  // size of allocated memory blocks
+  constexpr static size_t EMSCRIPTEN_PAGE_SIZE = 64 * 1024;  // wasm linear memory page
 
   LazyMemoryRegion();
   ~LazyMemoryRegion();
@@ -203,6 +204,9 @@ public:
     const size_t block_index = offset / WINDOWS_BLOCK_SIZE;
     if (m_writable_block_handles[block_index] == nullptr)
       MakeMemoryBlockWritable(block_index);
+#elif defined(__EMSCRIPTEN__)
+    // Nothing to commit (see MemArenaUnix.cpp), but Clear() only zeroes pages that were written.
+    m_dirty_pages[offset / EMSCRIPTEN_PAGE_SIZE] = 1;
 #endif
   }
 
@@ -215,6 +219,13 @@ public:
     {
       EnsureMemoryPageWritable(i);
     }
+#elif defined(__EMSCRIPTEN__)
+    const size_t end_offset = offset + size;
+    for (size_t i = Common::AlignDown(offset, EMSCRIPTEN_PAGE_SIZE); i < end_offset;
+         i += EMSCRIPTEN_PAGE_SIZE)
+    {
+      EnsureMemoryPageWritable(i);
+    }
 #endif
   }
 
@@ -228,6 +239,8 @@ private:
   std::vector<void*> m_writable_block_handles;
 
   void MakeMemoryBlockWritable(size_t offset);
+#elif defined(__EMSCRIPTEN__)
+  std::vector<u8> m_dirty_pages;  // one entry per EMSCRIPTEN_PAGE_SIZE page of the region
 #endif
 };
 
diff --git a/Source/Core/Common/MemArenaUnix.cpp b/Source/Core/Common/MemArenaUnix.cpp
index 26a123c081..3bec2a721b 100644
--- a/Source/Core/Common/MemArenaUnix.cpp
+++ b/Source/Core/Common/MemArenaUnix.cpp
@@ -15,6 +15,13 @@
 #include <sys/mman.h>
 #include <unistd.h>
 
+#ifdef __EMSCRIPTEN__
+#include <algorithm>
+#include <mutex>
+#include <utility>
+#include <vector>
+#endif
+
 #include "Common/Assert.h"
 #include "Common/CommonFuncs.h"
 #include "Common/CommonTypes.h"
@@ -136,6 +143,104 @@ LazyMemoryRegion::~LazyMemoryRegion()
   Release();
 }
 
+#ifdef __EMSCRIPTEN__
+
+// Emscripten's mmap can't place a mapping at a given address (any hint is EINVAL), so the
+// MAP_FIXED remap that Clear() uses below can never work there, and its anonymous mmap is just
+// memalign plus a memset of the whole length, which commits every page of regions that are
+// almost entirely empty (the JIT's instruction bit sets cover the full 4 GiB address space).
+//
+// What wasm does give us: the linear memory is a fixed size (the core links with
+// -sALLOW_MEMORY_GROWTH=0), every byte above the program break has never been written, so it
+// reads as zero and the browser has not had to back it with real memory. A region is therefore
+// taken straight from sbrk and never zeroed up front. Writers announce the pages they are about
+// to touch through EnsureMemoryPageWritable, exactly as the Windows implementation requires, so
+// Clear() only has to zero those. sbrk can't give memory back, so a released region goes into a
+// pool, already zeroed, for the next Create() of the same size.
+
+namespace
+{
+std::mutex s_lazy_region_pool_mutex;
+std::vector<std::pair<void*, size_t>> s_lazy_region_pool;  // zeroed regions by size
+
+void* TakePooledRegion(size_t size)
+{
+  std::lock_guard lock(s_lazy_region_pool_mutex);
+  const auto it = std::find_if(s_lazy_region_pool.begin(), s_lazy_region_pool.end(),
+                               [size](const auto& entry) { return entry.second == size; });
+  if (it == s_lazy_region_pool.end())
+    return nullptr;
+  void* const memory = it->first;
+  s_lazy_region_pool.erase(it);
+  return memory;
+}
+
+void* TakeFreshRegion(size_t size)
+{
+  // One extra page so the start can be rounded up to a page boundary whatever sbrk hands out.
+  void* const raw = sbrk(size + LazyMemoryRegion::EMSCRIPTEN_PAGE_SIZE);
+  if (raw == reinterpret_cast<void*>(-1))
+    return nullptr;
+  return reinterpret_cast<void*>(
+      Common::AlignUp(reinterpret_cast<uintptr_t>(raw), LazyMemoryRegion::EMSCRIPTEN_PAGE_SIZE));
+}
+}  // namespace
+
+void* LazyMemoryRegion::Create(size_t size)
+{
+  ASSERT(!m_memory);
+
+  if (size == 0)
+    return nullptr;
+
+  const size_t region_size = Common::AlignUp(size, EMSCRIPTEN_PAGE_SIZE);
+  void* memory = TakePooledRegion(region_size);
+  if (!memory)
+    memory = TakeFreshRegion(region_size);
+  if (!memory)
+  {
+    NOTICE_LOG_FMT(MEMMAP, "Memory allocation of {} bytes failed.", size);
+    return nullptr;
+  }
+
+  m_memory = memory;
+  m_size = region_size;
+  m_dirty_pages.assign(region_size / EMSCRIPTEN_PAGE_SIZE, 0);
+
+  return memory;
+}
+
+void LazyMemoryRegion::Clear()
+{
+  ASSERT(m_memory);
+
+  u8* const base = static_cast<u8*>(m_memory);
+  for (size_t page = 0; page < m_dirty_pages.size(); ++page)
+  {
+    if (!m_dirty_pages[page])
+      continue;
+    std::memset(base + page * EMSCRIPTEN_PAGE_SIZE, 0, EMSCRIPTEN_PAGE_SIZE);
+    m_dirty_pages[page] = 0;
+  }
+}
+
+void LazyMemoryRegion::Release()
+{
+  if (m_memory)
+  {
+    Clear();
+    {
+      std::lock_guard lock(s_lazy_region_pool_mutex);
+      s_lazy_region_pool.emplace_back(m_memory, m_size);
+    }
+    m_memory = nullptr;
+    m_size = 0;
+    m_dirty_pages.clear();
+  }
+}
+
+#else  // !__EMSCRIPTEN__
+
 #if !defined MAP_NORESERVE && (defined __FreeBSD__ || defined __OpenBSD__ || defined __NetBSD__)
 // BSD does not implement MAP_NORESERVE, so define the flag to nothing.
 // See https://reviews.freebsd.org/rS273250
@@ -182,4 +287,6 @@ void LazyMemoryRegion::Release()
   }
 }
 
+#endif  // !__EMSCRIPTEN__
+
 }  // namespace Common
