-void WebGPUCommandStream::PushClear(float r, float g, float b, float a)
+bool WebGPUCommandStream::PushBatch(const CmdRecord* records, u32 count)
+{
+  if (!m_header || !records || count == 0)
+  {
+    ++m_batch_abort_count;
+    return false;
+  }
+  if (count > m_capacity)
+  {
+    ++m_batch_abort_count;
+    ++m_batch_oversize_count;
+    return false;
+  }
+
+  // Single producer: no other write can advance while this pass waits. Keep
+  // the published write fixed until all slots are populated, then make the
+  // whole pass visible with one release-store.
+  const u32 w = m_header->write.load(std::memory_order_relaxed);
+  constexpr u32 kMaxSpins = 500000u;
+  u32 spins = 0;
+  while (w - m_header->read.load(std::memory_order_acquire) > m_capacity - count)
+  {
+    if (++spins >= kMaxSpins)
+    {
+      ++m_batch_abort_count;
+      return false;
+    }
+  }
+
+  for (u32 i = 0; i < count; ++i)
+    m_slots[(w + i) % m_capacity] = records[i];
+  m_header->write.store(w + count, std::memory_order_release);
+  return true;
+}
+
+bool WebGPUCommandStream::StagePassRecord(const CmdRecord& rec)
+{
+  if (!m_pass_staging || m_pass_poisoned)
+    return false;
+  m_pass_records.push_back(rec);
+  return true;
+}
+
+void WebGPUCommandStream::PoisonPass()
+{
+  if (m_pass_staging)
+    m_pass_poisoned = true;
+  else
+    m_required_publication_failed = true;
+}
+
+void WebGPUCommandStream::ResetPassStaging()
+{
+  m_pass_records.clear();
+  m_pass_staging = false;
+  m_pass_poisoned = false;
+}
+
+void WebGPUCommandStream::AbortPass()
+{
+  if (!m_pass_staging)
+    return;
+  ++m_batch_abort_count;
+  ResetPassStaging();
+}
+
