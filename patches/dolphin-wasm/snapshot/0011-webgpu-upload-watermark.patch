--- a/Source/Core/VideoBackends/WebGPU/WebGPUCommandStream.h
+++ b/Source/Core/VideoBackends/WebGPU/WebGPUCommandStream.h
@@ -152,14 +152,22 @@ struct CmdRingHeader
   std::atomic<u32> write;  // next slot the producer will fill
   std::atomic<u32> read;   // next slot the consumer will drain
   u32 capacity;            // number of CmdRecord slots
-  u32 reserved;
+  // Monotonic byte position immediately after the last upload payload
+  // copied by the JS consumer. The producer must not recycle any arena
+  // byte at or after this position until the consumer advances it.
+  std::atomic<u32> upload_read;
+  // Capability bits are written by the JS consumer. Keeping this separate
+  // makes the expanded header backward-compatible with older workers: they
+  // use the explicitly messaged slots pointer and leave this word at zero.
+  std::atomic<u32> protocol_flags;
 };
-// The JS consumer maps write@i32[0], read@i32[1], capacity@i32[2]
-// over this header — it MUST stay 16 bytes (4×u32; std::atomic<u32>
+// The JS consumer maps write@i32[0], read@i32[1], capacity@i32[2],
+// upload_read@i32[3], protocol_flags@i32[4]
+// over this header — it MUST stay 20 bytes (5×u32; std::atomic<u32>
 // is 4 bytes / 4-aligned on wasm32). Guardrail flagged by the Day-27
 // transport audit.
-static_assert(sizeof(CmdRingHeader) == 16,
-              "CmdRingHeader must stay 16 bytes (JS bridge assumes fixed layout)");
+static_assert(sizeof(CmdRingHeader) == 20,
+              "CmdRingHeader must stay 20 bytes (JS bridge assumes fixed layout)");
 
 class WebGPUCommandStream
 {
@@ -194,11 +202,11 @@ public:
   void PushDrawTest(u32 pipeline_id, u32 vertex_count);
 
   // ---- Phase A producer API --------------------------------------
-  // Bump-allocate `len` bytes into the per-frame upload arena, copy
+  // Ring-allocate `len` bytes into the upload arena, copy
   // `data` in, and return the ABSOLUTE wasm-heap offset of the copy
   // (what the consumer reads from for UploadBuffer/UploadTexture), or
-  // 0 on failure. Offsets recycle (the arena wraps) — sized so the
-  // consumer (1-2 frames behind) never reads a recycled region.
+  // 0 on failure. Offsets recycle only after the JS consumer publishes
+  // upload_read, so queued records never observe overwritten bytes.
   u32 UploadAlloc(const void* data, size_t len, u32 align = 4);
 
   u32 PushCreateBuffer(u32 size, u32 usage_flags);
@@ -246,6 +254,8 @@ public:
   u32 AllocId() { return m_next_id++; }
 
 private:
+  void RollbackLastUpload(u32 src_heap_ptr, u32 len);
+
   CmdRingHeader* m_header = nullptr;
   CmdRecord* m_slots = nullptr;
   u32 m_capacity = 0;
@@ -253,7 +263,14 @@ private:
   // Per-frame upload arena (DESIGN §payload). Bump-allocated, wraps.
   u8* m_upload_base = nullptr;
   u32 m_upload_size = 0;
-  u32 m_upload_head = 0;
+  // Monotonic byte position; modulo m_upload_size is the physical offset.
+  u32 m_upload_write = 0;
+  u32 m_upload_wait_timeouts = 0;
+  u32 m_upload_handshake_timeouts = 0;
+  u32 m_last_upload_write_before = 0;
+  u32 m_last_upload_write_after = 0;
+  u32 m_last_upload_ptr = 0;
+  u32 m_last_upload_len = 0;
 
   // Producer-assigned resource ids. One space is fine — opcode
   // implies class on the consumer. Starts at 1 (0 = none/sentinel).
