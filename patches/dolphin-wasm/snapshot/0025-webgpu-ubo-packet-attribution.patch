   return s_geometry_upload_pack_epoch.load(std::memory_order_acquire);
 }
 
+void RecordUboPrepareCpu(u32 class_index, double start_ms)
+{
+  if (!s_ubo_cache_metrics_enabled.load(std::memory_order_relaxed))
+    return;
+  const double elapsed_ms = emscripten_get_now() - start_ms;
+  const u64 elapsed_ns = static_cast<u64>(std::max(0.0, elapsed_ms) * 1000000.0);
+  s_ubo_prepare_cpu_calls[class_index].fetch_add(1, std::memory_order_relaxed);
+  s_ubo_prepare_cpu_ns[class_index].fetch_add(elapsed_ns, std::memory_order_relaxed);
+}
+
+void RecordUboPacketOpportunity(u32 change_mask, const std::array<u32, 3>& payload_sizes)
+{
+  if (!s_ubo_cache_metrics_enabled.load(std::memory_order_relaxed))
+    return;
+
+  change_mask &= 7;
+  s_ubo_change_mask_histogram[change_mask].fetch_add(1, std::memory_order_relaxed);
+  u32 changed_count = 0;
+  u64 payload_bytes = 0;
+  u64 aligned_bytes = 0;
+  for (u32 index = 0; index < payload_sizes.size(); ++index)
+  {
+    if ((change_mask & (1u << index)) == 0)
+      continue;
+    ++changed_count;
+    payload_bytes += payload_sizes[index];
+    aligned_bytes += (payload_sizes[index] + 255u) & ~255u;
+  }
+  if (changed_count >= 2)
+  {
+    s_ubo_packet_eligible_count.fetch_add(1, std::memory_order_relaxed);
+    s_ubo_packet_theoretical_calls_removed.fetch_add(changed_count - 1,
+                                                      std::memory_order_relaxed);
+  }
+  s_ubo_packet_payload_bytes.fetch_add(payload_bytes, std::memory_order_relaxed);
+  s_ubo_packet_aligned_bytes.fetch_add(aligned_bytes, std::memory_order_relaxed);
+}
+
