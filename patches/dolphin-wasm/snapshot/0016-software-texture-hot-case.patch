   const int tlutAddress = texTlut.tmem_offset << 9;
   const std::span<const u8> tlut = TexDecoder_GetTmemSpan(tlutAddress);
 
+#ifdef __EMSCRIPTEN__
+  // These two exact cases account for roughly three quarters of sampled texture decode work in
+  // the fixed Melee battle profile (keys 0xd38a01e and 0xd34a01e). TLUT state is part of those keys
+  // even though CMPR does not consult a palette. Keep the predicate deliberately narrow so every
+  // unmeasured mode continues through the generic sampler.
+  const bool is_measured_cmpr_hot_case =
+      mip == 0 && linear && texfmt == TextureFormat::CMPR &&
+      tm0.mipmap_filter == MipMode::None && tm0.min_filter == FilterMode::Linear &&
+      tm0.mag_filter == FilterMode::Linear && tm0.wrap_s == WrapMode::Repeat &&
+      tm0.wrap_t == WrapMode::Repeat && !texUnit.texImage1.cache_manually_managed &&
+      (tlutfmt == TLUTFormat::RGB565 || tlutfmt == TLUTFormat::RGB5A3) &&
+      IsPowerOfTwo(static_cast<u32>(image_width_minus_1 + 1)) &&
+      IsPowerOfTwo(static_cast<u32>(image_height_minus_1 + 1));
+  if (is_measured_cmpr_hot_case)
+  {
+    HotCase::SampleCmprLinearRepeatPow2(image_src, image_width_minus_1, image_height_minus_1, s, t,
+                                        sample);
+    return;
+  }
+#endif
