+      " nz:" + std::to_string(s_web_ai_nonzero_sample_count.load(std::memory_order_relaxed)) +
+      " last:" + std::to_string(s_web_ai_last_frames.load(std::memory_order_relaxed)) + "/" +
+      std::to_string(s_web_ai_last_nonzero_samples.load(std::memory_order_relaxed));
+  return s_web_audio_common_stats.c_str();
+}
+#endif
