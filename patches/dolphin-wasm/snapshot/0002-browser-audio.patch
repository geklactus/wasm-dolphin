@@ -196,6 +225,24 @@ void SendAIBuffer(Core::System& system, const short* samples, unsigned int num_s
 {
   const SoundStream* const sound_stream = system.GetSoundStream();
 
+#ifdef __EMSCRIPTEN__
+  std::uint32_t nonzero_samples = 0;
+  if (samples)
+  {
+    const std::size_t sample_count = static_cast<std::size_t>(num_samples) * 2;
+    for (std::size_t index = 0; index < sample_count; ++index)
+    {
+      if (samples[index] != 0)
+        ++nonzero_samples;
+    }
+  }
+  s_web_ai_buffer_count.fetch_add(1, std::memory_order_relaxed);
+  s_web_ai_frame_count.fetch_add(num_samples, std::memory_order_relaxed);
+  s_web_ai_nonzero_sample_count.fetch_add(nonzero_samples, std::memory_order_relaxed);
+  s_web_ai_last_frames.store(num_samples, std::memory_order_relaxed);
+  s_web_ai_last_nonzero_samples.store(nonzero_samples, std::memory_order_relaxed);
+#endif
+
   if (!sound_stream)
     return;
 
@@ -212,6 +259,19 @@ void SendAIBuffer(Core::System& system, const short* samples, unsigned int num_s
   }
 }
 
