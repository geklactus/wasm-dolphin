diff --git a/Source/Core/AudioCommon/WebAudioStream.cpp b/Source/Core/AudioCommon/WebAudioStream.cpp
new file mode 100644
index 0000000000..6c2a51a425
--- /dev/null
+++ b/Source/Core/AudioCommon/WebAudioStream.cpp
@@ -0,0 +1,59 @@
+// Copyright 2026
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "AudioCommon/WebAudioStream.h"
+
+#include <algorithm>
+#include <cstring>
+
+WebAudioStream::WebAudioStream() = default;
+
+WebAudioStream::~WebAudioStream()
+{
+  m_running.store(false, std::memory_order_release);
+}
+
+bool WebAudioStream::Init()
+{
+  GetMixer()->SetSampleRate(48000);
+  return true;
+}
+
+bool WebAudioStream::SetRunning(bool running)
+{
+  m_running.store(running, std::memory_order_release);
+  return true;
+}
+
+void WebAudioStream::SetVolume(int volume)
+{
+  m_volume.store(std::clamp(volume, 0, 100), std::memory_order_release);
+}
+
+std::size_t WebAudioStream::Mix(s16* samples, std::size_t frames)
+{
+  if (!samples || frames == 0)
+    return 0;
+
+  if (!m_running.load(std::memory_order_acquire))
+  {
+    std::memset(samples, 0, frames * 2 * sizeof(s16));
+    return frames;
+  }
+
+  const std::size_t mixed = GetMixer()->Mix(samples, frames);
+  const int volume = m_volume.load(std::memory_order_acquire);
+  if (volume <= 0)
+  {
+    std::memset(samples, 0, mixed * 2 * sizeof(s16));
+    return mixed;
+  }
+
+  if (volume < 100)
+  {
+    for (std::size_t index = 0; index < mixed * 2; ++index)
+      samples[index] = static_cast<s16>((static_cast<int>(samples[index]) * volume) / 100);
+  }
+
+  return mixed;
+}
diff --git a/Source/Core/AudioCommon/WebAudioStream.h b/Source/Core/AudioCommon/WebAudioStream.h
new file mode 100644
index 0000000000..c07dd18862
