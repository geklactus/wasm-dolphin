@@ -2561,14 +2564,12 @@ void WebGPUGfx::Draw(u32 base_vertex, u32 num_vertices)
     if (!SetRecordedPipeline(m_cur_pipeline_id))
     {
       AbortRecordedPass();
-      m_util_uniform_mode = false;
       return;
     }
   }
   if (!PrepareDrawResources())
   {
     AbortRecordedPass();
-    m_util_uniform_mode = false;
     return;
   }
   const auto* vm = static_cast<const VertexManager*>(g_vertex_manager.get());
@@ -2576,17 +2577,13 @@ void WebGPUGfx::Draw(u32 base_vertex, u32 num_vertices)
       !SetRecordedVertexBuffer(0, vm->GetVertexBufferId(), 0))
   {
     AbortRecordedPass();
-    m_util_uniform_mode = false;
     return;
   }
   if (!m_cmd_stream.PushDraw(num_vertices, 1, base_vertex))
   {
     AbortRecordedPass();
-    m_util_uniform_mode = false;
     return;
   }
