@@ -2594,13 +2591,11 @@ void WebGPUGfx::DrawIndexed(u32 base_index, u32 num_indices, u32 base_vertex)
   if (m_cur_pipeline_id == 0 || num_indices == 0)
   {
     DiscardOrAbortPendingGeometryRange();
-    m_util_uniform_mode = false;
     return;
   }
   if (!BeginPassIfNeeded())
   {
     DiscardOrAbortPendingGeometryRange();
-    m_util_uniform_mode = false;
     return;
   }
   if (m_last_set_pipeline_id != m_cur_pipeline_id)
@@ -2608,38 +2603,31 @@ void WebGPUGfx::DrawIndexed(u32 base_index, u32 num_indices, u32 base_vertex)
     if (!SetRecordedPipeline(m_cur_pipeline_id))
     {
       AbortRecordedPass();
-      m_util_uniform_mode = false;
       return;
     }
   }
   if (!PrepareDrawResources())
   {
     AbortRecordedPass();
-    m_util_uniform_mode = false;
     return;
