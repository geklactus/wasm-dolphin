     {
       static u32 s_pd = 0;
       const u32 n = s_pd++;
@@ -2245,6 +2248,8 @@ void WebGPUGfx::SetPipeline(const AbstractPipeline* pipeline)
 {
   m_cur_pipeline_id =
       pipeline ? static_cast<const WebGPUPipeline*>(pipeline)->GetBridgeId() : 0;
