@@ -11147,7 +11218,7 @@ extern "C" const char* GetPpcWasmHelperStats()
                     [](const auto& lhs, const auto& rhs) { return lhs.first > rhs.first; });
 
   std::ostringstream out;
-  out << (s_wasm_jit_direct_only ? "tier:guarded " : "tier:mixed ");
