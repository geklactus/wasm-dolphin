+  s_deferred_wasm_queues.erase(this);
+#endif
   m_block_cache.Clear();
   m_block_cache.ClearRangesToFree();
   ClearCodeSpace();
diff --git a/Source/Core/Core/PowerPC/CachedInterpreter/WasmDeferredCompileQueue.h b/Source/Core/Core/PowerPC/CachedInterpreter/WasmDeferredCompileQueue.h
new file mode 100644
index 0000000000..ae423e8354
--- /dev/null
+++ b/Source/Core/Core/PowerPC/CachedInterpreter/WasmDeferredCompileQueue.h
@@ -0,0 +1,73 @@
+// Copyright 2026 wasm-dolphin contributors
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// CPU-thread-only queue. Exactly one node per pending address/feature key.
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <iterator>
+#include <list>
+#include <unordered_map>
+
+namespace DeferredJit
+{
+struct Entry
+{
+  std::uint32_t address;
+  std::uint32_t features;
+  const void* normal_entry;
+};
+
+class Queue
+{
+public:
+  Queue() = default;
+  Queue(const Queue&) = delete;
+  Queue& operator=(const Queue&) = delete;
+  Queue(Queue&&) = default;
+  Queue& operator=(Queue&&) = default;
+  void Defer(std::uint32_t address, std::uint32_t features, const void* entry)
+  {
+    const auto key = Key(address, features);
+    const auto found = m_pending.find(key);
+    if (found != m_pending.end())
+    {
+      found->second->normal_entry = entry;
+      return;
+    }
+    m_queue.push_back({address, features, entry});
+    m_pending.emplace(key, std::prev(m_queue.end()));
+  }
+  void Recompiled(std::uint32_t address, std::uint32_t features)
+  {
+    const auto found = m_pending.find(Key(address, features));
+    if (found == m_pending.end())
+      return;
+    m_queue.erase(found->second);
+    m_pending.erase(found);
+  }
+  template <typename Invalidate>
+  void Drain(std::size_t limit, Invalidate invalidate)
+  {
+    for (std::size_t work = 0; work < limit && !m_queue.empty(); ++work)
+    {
+      const Entry item = m_queue.front();
+      m_pending.erase(Key(item.address, item.features));
+      m_queue.pop_front();
+      invalidate(item);
+    }
+  }
+  void Clear() { m_pending.clear(); m_queue.clear(); }
+  bool Empty() const { return m_queue.empty(); }
+  std::size_t Pending() const { return m_pending.size(); }
+  std::size_t Stored() const { return m_queue.size(); }
+
+private:
+  static std::uint64_t Key(std::uint32_t address, std::uint32_t features)
+  {
+    return (std::uint64_t{features} << 32) | address;
+  }
+  std::list<Entry> m_queue;
+  std::unordered_map<std::uint64_t, std::list<Entry>::iterator> m_pending;
+};
+}
