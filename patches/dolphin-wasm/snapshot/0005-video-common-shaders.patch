@@ -341,7 +341,59 @@ void WritePixelShaderCommonHeader(ShaderCode& out, APIType api_type,
             "int3 iround(float3 x) {{ return int3(round(x)); }}\n"
             "int4 iround(float4 x) {{ return int4(round(x)); }}\n\n");
 
-  out.Write("SAMPLER_BINDING(0) uniform sampler2DArray samp[8];\n");
+  // Day-30 (wasm-dolphin): WGSL/WebGPU has no combined image-samplers,
+  // and Naga's SPIR-V frontend can't split a combined `sampler2DArray`
+  // global (every Dolphin pixel shader tripped Naga's "invalid id" on
+  // the OpLoad of the combined sampler). For the Vulkan dialect (what
+  // the WebGPU backend selects; the desktop Vulkan backend isn't built
+  // in the wasm target so this is WebGPU-only in practice) emit
+  // SEPARATE `texture2DArray` + `sampler` and combine them at the use
+  // site via the `SAMP_AT` macro. glslang then produces separate
+  // OpTypeImage/OpTypeSampler globals + OpSampledImage-at-use — the
+  // exact shape WGSL and Naga accept — while every readTexture/
+  // sampleTexture helper keeps its `in sampler2DArray` parameter
+  // unchanged (the combined object is constructed locally). Other
+  // APIs (OGL/GLSL-ES, no separate-sampler support) keep the combined
+  // form, behaviour-identical to before.
+  // GLSL forbids passing a sampler constructed from a separate
+  // texture+sampler as a function argument ("sampler constructor must
+  // appear at point of use"). Dolphin's TEV helpers
+  // (readTexture/sampleTexture) take a sampler param and are passed
+  // SAMP_AT(texmap) through 3 call levels. So thread the texture +
+  // sampler SEPARATELY via macros: SAMP_PARAM (param list),
+  // SAMP_FWD (forward to a nested helper), SAMP_USE (the combined
+  // expression, only ever placed directly inside a texture()/
+  // texelFetch()/textureSize() builtin — the one legal point of use).
+  // Helper-local names dtex/dsmp avoid clashing with the texture
+  // globals.
+  //
+  // Day-30: Naga's spv frontend also rejects indexing a global
+  // texture *array* ("invalid global var Access"). In every code
+  // path that reaches SAMP_AT the texmap is a compile-time constant
+  // (specialized PixelShaderGen emits `sampleTextureWrapper({}u,…)`;
+  // the ubershader uses a `switch` over constant cases since this
+  // backend reports no dynamic sampler indexing). So declare 8
+  // SEPARATE textures `tex_0u`..`tex_7u` (no array) and let SAMP_AT
+  // token-paste-select the right one — WGSL/Naga-friendly, and the
+  // constants make the paste well-defined.
+  if (api_type == APIType::Vulkan)
+  {
+    for (u32 i = 0; i < 8; i++)
+      out.Write("SAMPLER_BINDING({}) uniform texture2DArray tex_{}u;\n", i, i);
+    out.Write("SAMPLER_BINDING(8) uniform sampler samp_ss;\n");
+    out.Write("#define SAMP_PARAM texture2DArray dtex, sampler dsmp\n");
+    out.Write("#define SAMP_USE sampler2DArray(dtex, dsmp)\n");
+    out.Write("#define SAMP_FWD dtex, dsmp\n");
+    out.Write("#define SAMP_AT(i) tex_##i, samp_ss\n");
+  }
+  else
+  {
+    out.Write("SAMPLER_BINDING(0) uniform sampler2DArray samp[8];\n");
+    out.Write("#define SAMP_PARAM in sampler2DArray dtex\n");
+    out.Write("#define SAMP_USE dtex\n");
+    out.Write("#define SAMP_FWD dtex\n");
+    out.Write("#define SAMP_AT(i) samp[i]\n");
+  }
   out.Write("\n");
 
   out.Write("UBO_BINDING(std140, 1) uniform PSBlock {{\n");
@@ -383,13 +435,51 @@ void WritePixelShaderCommonHeader(ShaderCode& out, APIType api_type,
             "\tuint  logic_op_mode;\n"
             "\tuint  time_ms;\n"
             "}};\n\n");
-  out.Write("#define bpmem_combiners(i) (bpmem_pack1[(i)].xy)\n"
-            "#define bpmem_tevind(i) (bpmem_pack1[(i)].z)\n"
-            "#define bpmem_iref(i) (bpmem_pack1[(i)].w)\n"
-            "#define bpmem_tevorder(i) (bpmem_pack2[(i)].x)\n"
-            "#define bpmem_tevksel(i) (bpmem_pack2[(i)].y)\n"
-            "#define samp_texmode0(i) (bpmem_pack2[(i)].z)\n"
-            "#define samp_texmode1(i) (bpmem_pack2[(i)].w)\n\n");
+  // §28cx: Naga's SPIR-V frontend rejects a RUNTIME OpAccessChain into a
+  // uniform-block array global ("invalid global var Access"). The uber TEV
+  // loop indexes bpmem_pack1/bpmem_pack2 (by `stage`) and konstLookup (by a
+  // runtime bitfield) — that dynamic-index shape is exactly the 27 pixel-shader
+  // Naga failures (the specialized path bakes constant indices, so it
+  // translates fine). Route the dynamically-indexed reads through
+  // switch-over-constant-index fetchers so every emitted access carries a
+  // LITERAL index — the WGSL/Naga-friendly shape, same principle as the Day-30
+  // separate-texture fix. Vulkan-only; other backends keep direct indexing.
+  // Specialized shaders pass constant indices, which glslang const-folds
+  // through the switch (no cost / no behavior change there).
+  if (api_type == APIType::Vulkan)
+  {
+    out.Write("uint4 dolphin_fetch_pack1(uint i) {{ switch (i) {{\n");
+    for (u32 k = 0; k < 16; k++)
+      out.Write("  case {}u: return bpmem_pack1[{}];\n", k, k);
+    out.Write("  default: return bpmem_pack1[0]; }} }}\n");
+    out.Write("uint4 dolphin_fetch_pack2(uint i) {{ switch (i) {{\n");
+    for (u32 k = 0; k < 8; k++)
+      out.Write("  case {}u: return bpmem_pack2[{}];\n", k, k);
+    out.Write("  default: return bpmem_pack2[0]; }} }}\n");
+    out.Write("int4 dolphin_fetch_konst(uint i) {{ switch (i) {{\n");
+    for (u32 k = 0; k < 32; k++)
+      out.Write("  case {}u: return konstLookup[{}];\n", k, k);
+    out.Write("  default: return konstLookup[0]; }} }}\n");
+    out.Write("#define bpmem_combiners(i) (dolphin_fetch_pack1(i).xy)\n"
+              "#define bpmem_tevind(i) (dolphin_fetch_pack1(i).z)\n"
+              "#define bpmem_iref(i) (dolphin_fetch_pack1(i).w)\n"
+              "#define bpmem_tevorder(i) (dolphin_fetch_pack2(i).x)\n"
+              "#define bpmem_tevksel(i) (dolphin_fetch_pack2(i).y)\n"
+              "#define samp_texmode0(i) (dolphin_fetch_pack2(i).z)\n"
+              "#define samp_texmode1(i) (dolphin_fetch_pack2(i).w)\n"
+              "#define KONST_AT(i) (dolphin_fetch_konst(i))\n\n");
+  }
+  else
