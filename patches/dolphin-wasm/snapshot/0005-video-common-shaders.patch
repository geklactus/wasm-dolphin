diff --git a/Source/Core/VideoCommon/PixelShaderGen.cpp b/Source/Core/VideoCommon/PixelShaderGen.cpp
index 669d80e317..3cc17fa0d6 100644
--- a/Source/Core/VideoCommon/PixelShaderGen.cpp
