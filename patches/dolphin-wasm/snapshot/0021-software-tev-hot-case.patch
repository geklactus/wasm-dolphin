index 0000000000..580beb2979
--- /dev/null
+++ b/Source/Core/VideoBackends/Software/TevHotCase.h
@@ -0,0 +1,87 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <array>
+#include <cstdint>
+
+namespace TevHotCase
+{
+using ExactTuple = std::array<std::uint32_t, 9>;
+
+enum class Kind : std::uint8_t
+{
+  None,
+  TextureModulateRgbRasterAlpha,
+  PassThroughGenMode10,
+  PassThroughGenMode4010,
+};
+
+inline constexpr std::uint32_t MODE_EXECUTE = 1u << 0;
+inline constexpr std::uint32_t MODE_SHADOW = 1u << 1;
+
+inline constexpr ExactTuple TEXTURE_MODULATE_RGB_RASTER_ALPHA = {
+    0x4011, 0x0, 0x40, 0x0, 0x8fa8f, 0x8ffd0, 0x0, 0xe4, 0xe4,
+};
+inline constexpr ExactTuple PASS_THROUGH_GENMODE_10 = {
+    0x10, 0x0, 0x0, 0x0, 0x8fffa, 0x8ffd0, 0x0, 0xe4, 0xe4,
+};
+inline constexpr ExactTuple PASS_THROUGH_GENMODE_4010 = {
+    0x4010, 0x0, 0x0, 0x0, 0x8fffa, 0x8ffd0, 0x0, 0xe4, 0xe4,
+};
+
+constexpr Kind Classify(const ExactTuple& tuple)
+{
+  if (tuple == TEXTURE_MODULATE_RGB_RASTER_ALPHA)
+    return Kind::TextureModulateRgbRasterAlpha;
+  if (tuple == PASS_THROUGH_GENMODE_10)
+    return Kind::PassThroughGenMode10;
+  if (tuple == PASS_THROUGH_GENMODE_4010)
+    return Kind::PassThroughGenMode4010;
+  return Kind::None;
+}
+
+constexpr std::int16_t Clamp255(std::int32_t value)
+{
+  return static_cast<std::int16_t>(value < 0 ? 0 : value > 255 ? 255 : value);
+}
+
+// This is the exact regular-combiner arithmetic for
+//   prev.rgb = lerp(0, ras.rgb, tex.rgb), clamp
+// used by the measured one-stage tuple. Inputs are the canonical post-swap
+// TEV values, so both operands are in [0, 255].
+constexpr std::int16_t Modulate(std::int16_t raster, std::int16_t texture)
+{
+  const std::uint16_t c = static_cast<std::uint16_t>(texture) +
+                          (static_cast<std::uint16_t>(texture) >> 7);
+  const std::int32_t value =
+      (static_cast<std::int32_t>(raster) * static_cast<std::int32_t>(c) + 128) >> 8;
+  return Clamp255(value);
+}
+
+// Color must expose signed a/b/g/r members. Only the destination Prev register
+// is mutated; callers preserve the other three TEV registers unchanged.
+template <typename Color>
+constexpr void Evaluate(Kind kind, Color& previous, const Color& texture, const Color& raster)
+{
+  switch (kind)
+  {
+  case Kind::TextureModulateRgbRasterAlpha:
+    previous.r = Modulate(raster.r, texture.r);
+    previous.g = Modulate(raster.g, texture.g);
+    previous.b = Modulate(raster.b, texture.b);
+    previous.a = Clamp255(raster.a);
+    return;
+  case Kind::PassThroughGenMode10:
+  case Kind::PassThroughGenMode4010:
+    previous.r = Clamp255(raster.r);
+    previous.g = Clamp255(raster.g);
+    previous.b = Clamp255(raster.b);
+    previous.a = Clamp255(raster.a);
+    return;
+  case Kind::None:
+    return;
+  }
+}
+}  // namespace TevHotCase
