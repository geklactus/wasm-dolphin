+static u32 PackTevSwapWord(const auto& swap)
+{
+  return static_cast<u32>(swap[ColorChannel::Red]) |
+         (static_cast<u32>(swap[ColorChannel::Green]) << 2) |
+         (static_cast<u32>(swap[ColorChannel::Blue]) << 4) |
+         (static_cast<u32>(swap[ColorChannel::Alpha]) << 6);
+}
+
+static TevHotCase::ExactTuple BuildSingleStageExactTuple()
+{
+  const TwoTevStageOrders& order = bpmem.tevorders[0];
+  const TevStageCombiner::ColorCombiner& cc = bpmem.combiners[0].colorC;
+  const TevStageCombiner::AlphaCombiner& ac = bpmem.combiners[0].alphaC;
+  const bool texture_enabled = order.getEnable(0) != 0;
+  const u32 order_word = order.getTexMap(0) | (order.getTexCoord(0) << 3) |
+                         (static_cast<u32>(texture_enabled) << 6) |
+                         (static_cast<u32>(order.getColorChan(0)) << 7);
+  const u32 konst_word = static_cast<u32>(bpmem.tevksel.GetKonstColor(0)) |
+                         (static_cast<u32>(bpmem.tevksel.GetKonstAlpha(0)) << 8);
+  return {
+      bpmem.genMode.hex,
+      bpmem.tevindref.hex,
+      order_word,
+      bpmem.tevind[0].fullhex & 0x1fffff,
+      cc.hex,
+      ac.hex,
+      konst_word,
+      PackTevSwapWord(bpmem.tevksel.GetSwapTable(ac.rswap.Value())),
+      PackTevSwapWord(bpmem.tevksel.GetSwapTable(ac.tswap.Value())),
+  };
+}
+
+Tev::RegisterSnapshot Tev::CaptureRegisters() const
+{
+  RegisterSnapshot snapshot;
+  for (u32 i = 0; i < snapshot.size(); ++i)
+    snapshot[i] = Reg[static_cast<TevOutput>(i)];
+  return snapshot;
+}
+
+void Tev::RestoreRegisters(const RegisterSnapshot& snapshot)
+{
+  for (u32 i = 0; i < snapshot.size(); ++i)
+    Reg[static_cast<TevOutput>(i)] = snapshot[i];
+}
+
+bool Tev::RegistersEqual(const RegisterSnapshot& snapshot) const
+{
+  for (u32 i = 0; i < snapshot.size(); ++i)
+  {
+    const TevColor& value = Reg[static_cast<TevOutput>(i)];
+    if (value.a != snapshot[i].a || value.b != snapshot[i].b || value.g != snapshot[i].g ||
+        value.r != snapshot[i].r)
+    {
+      return false;
+    }
+  }
+  return true;
+}
+
+void Tev::EvaluateHotCase()
+{
+  TevHotCase::Evaluate(m_hot_case, Reg[TevOutput::Prev], TexColor, RasColor);
+}
+
+void Tev::ClassifyHotCaseDraw()
+{
+#ifdef __EMSCRIPTEN__
+  m_hot_case_metrics_enabled = DolphinWeb::RasterProfile::Enabled();
+#else
+  m_hot_case_metrics_enabled = false;
+#endif
+  const u32 generation = DolphinWeb_SoftwareTevHotCaseGeneration();
+  if (generation != m_hot_case_mode_generation)
+  {
+    m_hot_case_mode_generation = generation;
+    m_hot_case_latched_off = false;
+  }
+
+  m_hot_case_mode = static_cast<u32>(DolphinWeb_SoftwareTevHotCaseMode()) & 0x3;
+  m_hot_case = TevHotCase::Kind::None;
+  if (m_hot_case_mode == 0 || m_hot_case_latched_off)
+    return;
+
+  m_hot_case = TevHotCase::Classify(BuildSingleStageExactTuple());
+#ifdef __EMSCRIPTEN__
+  if (m_hot_case_metrics_enabled && m_hot_case != TevHotCase::Kind::None)
+    DolphinWeb::RasterProfile::RecordTevHotCaseClassifiedBatch();
+#endif
+}
