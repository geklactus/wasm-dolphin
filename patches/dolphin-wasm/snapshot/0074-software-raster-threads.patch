+// The vertex fields the pixel loop reads. Triangles are queued for the duration of a batch
+// (see EndBatch) and the clipper reuses its vertex storage, so every queued triangle owns a
+// copy of what it needs.
+struct RasterVertex
+{
+  Common::Vec3 screenPosition;
+  float w;  // projectedPosition.w
+  std::array<std::array<u8, 4>, 2> color;
+  std::array<Common::Vec3, 8> texCoords;
+
+  static RasterVertex From(const OutputVertexData* v)
+  {
+    RasterVertex out;
+    out.screenPosition = v->screenPosition;
+    out.w = v->projectedPosition.w;
+    out.color = v->color;
+    out.texCoords = v->texCoords;
+    return out;
+  }
+};
