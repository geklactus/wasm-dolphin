+  RasterContext& ctx = LocalContext();
+  s_pool.started.fetch_add(1, std::memory_order_acq_rel);
+  for (;;)
+  {
+    u32 band = 0;
+    u32 generation = 0;
+    if (ClaimBand(&band, &generation))
+    {
+      if (ctx.prepared_generation != generation)
+        PrepareContextForJob(ctx, generation);
+      ProcessClaimedBand(ctx, band);
+      s_pool.worker_bands.fetch_add(1, std::memory_order_relaxed);
+      continue;
+    }
+    // Between jobs: the next one must re-copy the batch constants whatever its generation.
+    ctx.prepared_generation = GENERATION_UNPREPARED;
+    if (s_pool.quit.load(std::memory_order_acquire))
+      return;
+
+    const u32 observed = s_pool.state.load(std::memory_order_acquire);
+    const auto spin_until = std::chrono::steady_clock::now() + WORKER_SPIN;
+    bool woke = false;
+    for (u32 i = 0;; ++i)
+    {
+      if (s_pool.state.load(std::memory_order_acquire) != observed ||
+          s_pool.quit.load(std::memory_order_acquire))
+      {
+        woke = true;
+        break;
+      }
+      if ((i & 255u) == 255u && std::chrono::steady_clock::now() >= spin_until)
+        break;
+    }
+    if (!woke)
+      WaitForNewWork(observed);
+  }
+}
+
+static void RunQueuedOps()
+{
+  if (s_ops.empty())
+    return;
+
+  RasterContext& ctx = LocalContext();
+  const bool parallel = !s_pool.threads.empty() && s_queued_area >= PARALLEL_MIN_AREA;
+  if (!parallel)
+  {
+    for (const RasterOp& op : s_ops)
+      ExecuteOpInline(ctx, op);
+    MergeContextStats(ctx);
+  }
+  else
+  {
+    // Publish the job, then take part in it: bands are handed out dynamically, so the GPU
+    // thread never waits on a worker that has not been scheduled yet.
+    s_pool.ops = s_ops.data();
+    s_pool.op_count = s_ops.size();
+    s_pool.initial_zslope = ctx.ZSlope;
+    s_pool.master_tev = &ctx.tev;
+    s_pool.bands_done.store(0, std::memory_order_relaxed);
+    const u32 generation = ((s_pool.state.load(std::memory_order_relaxed) >> 8) + 1) & 0xFFFFFFu;
+    s_pool.state.store(generation << 8, std::memory_order_release);
+#ifdef __EMSCRIPTEN__
+    if (s_pool.sleepers.load(std::memory_order_acquire) != 0)
+      emscripten_futex_wake(reinterpret_cast<volatile void*>(&s_pool.state), INT_MAX);
+#endif
+
+    ctx.prepared_generation = generation;
+    u32 band = 0;
+    u32 claimed_generation = 0;
+    while (ClaimBand(&band, &claimed_generation))
+      ProcessClaimedBand(ctx, band);
+    while (s_pool.bands_done.load(std::memory_order_acquire) < BAND_COUNT)
+    {
+    }
+
+    FinishZSlope(ctx, s_ops.back());
+  }
+
+  s_ops.clear();
+  s_queued_area = 0;
+}
+
+// Rows and bounding-box area a triangle can touch, over the union of the scissor rectangles.
+// Mirrors the rejection in DrawTriangleFrontFace so the band scan never misses a row.
+static void ComputeOpBounds(RasterOp* op)
+{
+  s32 miny = static_cast<s32>(EFB_HEIGHT);
+  s32 maxy = 0;
+  u64 area = 0;
+  for (const auto& scissor : scissors)
+  {
+    const s32 Y1 = iround(16.0f * (op->v[0].screenPosition.y - scissor.y_off)) - 9;
+    const s32 Y2 = iround(16.0f * (op->v[1].screenPosition.y - scissor.y_off)) - 9;
+    const s32 Y3 = iround(16.0f * (op->v[2].screenPosition.y - scissor.y_off)) - 9;
+    const s32 X1 = iround(16.0f * (op->v[0].screenPosition.x - scissor.x_off)) - 9;
+    const s32 X2 = iround(16.0f * (op->v[1].screenPosition.x - scissor.x_off)) - 9;
+    const s32 X3 = iround(16.0f * (op->v[2].screenPosition.x - scissor.x_off)) - 9;
+
+    const s32 tminx = std::max((std::min(std::min(X1, X2), X3) + 0xF) >> 4, scissor.rect.left);
+    const s32 tmaxx = std::min((std::max(std::max(X1, X2), X3) + 0xF) >> 4, scissor.rect.right);
+    const s32 tminy = std::max((std::min(std::min(Y1, Y2), Y3) + 0xF) >> 4, scissor.rect.top);
+    const s32 tmaxy = std::min((std::max(std::max(Y1, Y2), Y3) + 0xF) >> 4, scissor.rect.bottom);
+    if (tminx >= tmaxx || tminy >= tmaxy)
+      continue;
+    miny = std::min(miny, tminy);
+    maxy = std::max(maxy, tmaxy);
+    area += static_cast<u64>(tmaxx - tminx) * static_cast<u64>(tmaxy - tminy);
+  }
+  op->miny = static_cast<s16>(miny);
+  op->maxy = static_cast<s16>(maxy);
+  s_queued_area += area;
+}
+
+static void Enqueue(RasterOp&& op)
+{
+  s_ops.push_back(std::move(op));
+  if (s_ops.size() >= QUEUE_FLUSH_OPS)
+    RunQueuedOps();
+}
+
+void BeginBatch()
+{
+  RasterContext& ctx = LocalContext();
+  ctx.rasterized_pixels = 0;
+  ctx.tev.ResetBatchAccumulators();
+  s_ops.clear();
+  s_queued_area = 0;
+  s_batch_active = true;
+}
+
+void EndBatch()
+{
+  RunQueuedOps();
+  s_batch_active = false;
+}
+
+void UpdateZSlope(const OutputVertexData* v0, const OutputVertexData* v1,
+                  const OutputVertexData* v2, s32 x_off, s32 y_off)
+{
+  RasterOp op;
+  op.v[0] = RasterVertex::From(v0);
+  op.v[1] = RasterVertex::From(v1);
+  op.v[2] = RasterVertex::From(v2);
+  op.zslope_only = true;
+  op.x_off = x_off;
+  op.y_off = y_off;
+  if (!s_batch_active)
+  {
+    ExecuteOpInline(LocalContext(), op);
+    return;
+  }
+  Enqueue(std::move(op));
+}
+
 void DrawTriangleFrontFace(const OutputVertexData* v0, const OutputVertexData* v1,
                            const OutputVertexData* v2)
 {
   INCSTAT(g_stats.this_frame.num_triangles_drawn);
 
-  for (const auto& scissor : scissors)
-    DrawTriangleFrontFace(v0, v1, v2, scissor);
+  RasterOp op;
+  op.v[0] = RasterVertex::From(v0);
+  op.v[1] = RasterVertex::From(v1);
+  op.v[2] = RasterVertex::From(v2);
+  if (!s_batch_active)
+  {
+    RasterContext& ctx = LocalContext();
+    ExecuteOpInline(ctx, op);
+    MergeContextStats(ctx);
+    return;
+  }
+  ComputeOpBounds(&op);
+  Enqueue(std::move(op));
+}
+
+void Init()
+{
+  // The other slopes are set each for each primitive drawn, but zfreeze means that the z slope
+  // needs to be set to an (untested) default value.
+  LocalContext().ZSlope = Slope();
+  s_ops.clear();
+  s_ops.reserve(1024);
+  s_queued_area = 0;
+  s_batch_active = false;
+
+  Shutdown();
+  const int requested = std::clamp(DolphinWeb_SoftwareRasterThreads(), 0, static_cast<int>(MAX_WORKERS));
+  s_pool.quit.store(false, std::memory_order_release);
+  s_pool.state.store(BAND_COUNT, std::memory_order_release);
+  s_pool.bands_done.store(0, std::memory_order_release);
+  s_pool.started.store(0, std::memory_order_release);
+  s_pool.worker_bands.store(0, std::memory_order_release);
+  for (int i = 0; i < requested; ++i)
+    s_pool.threads.emplace_back(WorkerMain, static_cast<u32>(i));
+  DolphinWeb_SetSoftwareRasterThreadsActive(requested);
+}
+
+void Shutdown()
+{
+  if (s_pool.threads.empty())
+    return;
+  s_pool.quit.store(true, std::memory_order_release);
+#ifdef __EMSCRIPTEN__
+  emscripten_futex_wake(reinterpret_cast<volatile void*>(&s_pool.state), INT_MAX);
+#endif
+  for (std::thread& thread : s_pool.threads)
+    thread.join();
+  s_pool.threads.clear();
+  s_pool.quit.store(false, std::memory_order_release);
+  DolphinWeb_SetSoftwareRasterThreadsActive(0);
 }
