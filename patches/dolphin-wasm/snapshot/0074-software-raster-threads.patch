+  // BBoxManager by the rasterizer, which may be running this Tev on a worker thread.
+  bbox_left = std::min(bbox_left, static_cast<u16>(Position[0] & ~1));
+  bbox_right = std::max(bbox_right, static_cast<u16>(Position[0] | 1));
+  bbox_top = std::min(bbox_top, static_cast<u16>(Position[1] & ~1));
+  bbox_bottom = std::max(bbox_bottom, static_cast<u16>(Position[1] | 1));
+
+  ++stats_pixels_out;
   EfbInterface::IncPerfCounterQuadCount(PQ_BLEND_INPUT);
 
   EfbInterface::BlendTev(Position[0], Position[1], output);
 }
 
+void Tev::ResetBatchAccumulators()
+{
+  stats_pixels_in = 0;
+  stats_pixels_out = 0;
+  bbox_left = 0xFFFF;
+  bbox_right = 0;
+  bbox_top = 0xFFFF;
+  bbox_bottom = 0;
+}
+
+void Tev::CopyBatchState(const Tev& master)
+{
+  KonstantColors = master.KonstantColors;
+  m_hot_case = master.m_hot_case;
+  m_hot_case_mode = master.m_hot_case_mode;
+  m_hot_case_mode_generation = master.m_hot_case_mode_generation;
+  m_hot_case_latched_off = master.m_hot_case_latched_off;
+  m_hot_case_metrics_enabled = master.m_hot_case_metrics_enabled;
+}
