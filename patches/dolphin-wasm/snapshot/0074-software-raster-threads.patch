+// Bands must be a multiple of 4 rows: the fastsw post-pass fills 4x4 cells from their top-left
+// pixel and the 2x2 raster blocks never straddle a band, so every EFB row is written by exactly
+// one thread per job.
+constexpr u32 BAND_HEIGHT = 24;
+constexpr u32 BAND_COUNT = (EFB_HEIGHT + BAND_HEIGHT - 1) / BAND_HEIGHT;
+static_assert(BAND_HEIGHT % 4 == 0);
+static_assert(BAND_COUNT < 256, "the band index shares a 32-bit word with the job generation");
+constexpr u32 MAX_WORKERS = 8;
+// Queue bound; a batch longer than this is rasterized in several jobs, still in order.
+constexpr std::size_t QUEUE_FLUSH_OPS = 8192;
+// Below this many bounding-box EFB pixels a job is cheaper to rasterize inline than to hand out.
+constexpr u64 PARALLEL_MIN_AREA = 4096;
+// How long an idle worker spins for the next job before parking on the futex. Batches arrive
+// every few hundred microseconds while a frame is being drawn.
+constexpr auto WORKER_SPIN = std::chrono::microseconds(150);
+constexpr u32 GENERATION_UNPREPARED = 0xFFFFFFFFu;
+
+struct WorkerPool
+{
+  std::vector<std::thread> threads;
+  // (job generation << 8) | next unclaimed band. Claiming a band and learning which job it
+  // belongs to is a single compare-exchange, so a worker can never apply one job's state to
+  // another job's band.
+  std::atomic<u32> state{BAND_COUNT};
+  std::atomic<u32> bands_done{0};
+  std::atomic<u32> sleepers{0};
+  std::atomic<u32> started{0};
+  std::atomic<u64> worker_bands{0};
+  std::atomic<bool> quit{false};
+
+  // The current job. Written by the GPU thread before it publishes the generation in `state`;
+  // immutable until bands_done reaches BAND_COUNT.
+  const RasterOp* ops = nullptr;
+  std::size_t op_count = 0;
+  Slope initial_zslope;
+  const Tev* master_tev = nullptr;
+};
+
+WorkerPool s_pool;
+std::atomic_flag s_merge_lock = ATOMIC_FLAG_INIT;
