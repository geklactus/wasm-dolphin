+// Folds a thread's per-batch counters into the shared statistics, perf-query counters and
+// bounding box. These are all sums or min/max, so merging per band gives the same totals as
+// upstream's per-pixel updates. The lock also covers the inline (single-threaded) path, where
+// it is uncontended.
+static void MergeContextStats(RasterContext& ctx)
+{
+  while (s_merge_lock.test_and_set(std::memory_order_acquire))
+  {
+  }
+  ADDSTAT(g_stats.this_frame.rasterized_pixels, ctx.rasterized_pixels);
+  ADDSTAT(g_stats.this_frame.tev_pixels_in, ctx.tev.stats_pixels_in);
+  ADDSTAT(g_stats.this_frame.tev_pixels_out, ctx.tev.stats_pixels_out);
+  if (ctx.tev.bbox_left <= ctx.tev.bbox_right)
+  {
+    BBoxManager::Update(ctx.tev.bbox_left, ctx.tev.bbox_right, ctx.tev.bbox_top,
+                        ctx.tev.bbox_bottom);
+  }
+  EfbInterface::FlushPerfCounters();
+  s_merge_lock.clear(std::memory_order_release);
+
+  ctx.rasterized_pixels = 0;
+  ctx.tev.ResetBatchAccumulators();
+}
+
+// Upstream order and the whole EFB: used when no worker threads exist or the batch is small.
+static void ExecuteOpInline(RasterContext& ctx, const RasterOp& op)
+{
+  if (op.zslope_only)
+  {
+    UpdateZSlope(ctx, &op.v[0], &op.v[1], &op.v[2], op.x_off, op.y_off);
+    return;
+  }
+  for (const auto& scissor : scissors)
+  {
+    DrawTriangleFrontFace(ctx, &op.v[0], &op.v[1], &op.v[2], scissor, 0,
+                          static_cast<s32>(EFB_HEIGHT));
+  }
+}
+
+// Within one batch the z slope has no cross-triangle dependency: with zfreeze off every
+// triangle derives it from its own vertices, with zfreeze on nothing updates it. Only the
+// value left behind for the next batch matters, and this restores exactly what sequential
+// execution would have left.
+static void FinishZSlope(RasterContext& ctx, const RasterOp& last)
+{
+  if (last.zslope_only)
+  {
+    UpdateZSlope(ctx, &last.v[0], &last.v[1], &last.v[2], last.x_off, last.y_off);
+  }
+  else if (!scissors.empty())
+  {
+    const auto& scissor = scissors.back();
+    UpdateZSlope(ctx, &last.v[0], &last.v[1], &last.v[2], scissor.x_off, scissor.y_off);
+  }
+}
+
+static void RasterizeBand(RasterContext& ctx, u32 band)
+{
+  const s32 band_top = static_cast<s32>(band * BAND_HEIGHT);
+  const s32 band_bottom =
+      std::min(band_top + static_cast<s32>(BAND_HEIGHT), static_cast<s32>(EFB_HEIGHT));
+  const RasterOp* ops = s_pool.ops;
+  const std::size_t count = s_pool.op_count;
+  for (std::size_t i = 0; i < count; ++i)
+  {
+    const RasterOp& op = ops[i];
+    if (op.zslope_only || op.maxy <= band_top || op.miny >= band_bottom)
+      continue;
+    for (const auto& scissor : scissors)
+      DrawTriangleFrontFace(ctx, &op.v[0], &op.v[1], &op.v[2], scissor, band_top, band_bottom);
+  }
+}
+
+static void PrepareContextForJob(RasterContext& ctx, u32 generation)
+{
+  ctx.ZSlope = s_pool.initial_zslope;
+  ctx.tev.CopyBatchState(*s_pool.master_tev);
+  ctx.tev.ResetBatchAccumulators();
+  ctx.rasterized_pixels = 0;
+  ctx.prepared_generation = generation;
+}
+
+// Claims the next unprocessed band of the published job, or returns false when none is left.
+static bool ClaimBand(u32* band, u32* generation)
+{
+  u32 s = s_pool.state.load(std::memory_order_acquire);
+  for (;;)
+  {
+    if ((s & 0xFFu) >= BAND_COUNT)
+      return false;
+    if (s_pool.state.compare_exchange_weak(s, s + 1, std::memory_order_acq_rel,
+                                           std::memory_order_acquire))
+    {
+      *band = s & 0xFFu;
+      *generation = s >> 8;
+      return true;
+    }
+  }
+}
+
+static void ProcessClaimedBand(RasterContext& ctx, u32 band)
+{
+  RasterizeBand(ctx, band);
+  MergeContextStats(ctx);
+  s_pool.bands_done.fetch_add(1, std::memory_order_acq_rel);
+}
+
+static void WaitForNewWork(u32 observed_state)
+{
+#ifdef __EMSCRIPTEN__
+  s_pool.sleepers.fetch_add(1, std::memory_order_acq_rel);
+  if (s_pool.state.load(std::memory_order_acquire) == observed_state &&
+      !s_pool.quit.load(std::memory_order_acquire))
+  {
+    // The futex compares the word itself, so a publish between the check above and this wait
+    // returns immediately; the timeout only bounds a missed wake.
+    emscripten_futex_wait(reinterpret_cast<volatile void*>(&s_pool.state), observed_state, 20.0);
+  }
+  s_pool.sleepers.fetch_sub(1, std::memory_order_acq_rel);
+#else
+  (void)observed_state;
+  std::this_thread::sleep_for(std::chrono::microseconds(200));
+#endif
+}
+
+static void WorkerMain(u32 index)
+{
+  char name[32];
+  std::snprintf(name, sizeof(name), "SW raster %u", index);
+  Common::SetCurrentThreadName(name);
