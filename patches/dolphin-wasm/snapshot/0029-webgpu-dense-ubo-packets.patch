+      s_ubo_packet_enabled.load(std::memory_order_relaxed), ubo_cache_enabled);
   u32 ubo_change_mask = 0;
   std::array<u32, 3> ubo_payload_sizes{};
 
@@ -1115,6 +1127,92 @@ bool WebGPUGfx::PrepareDrawResources()
   if (m_ubo_ring == 0 || m_ssbo_bbox == 0 || m_dummy_tex == 0)
     return false;
 
+  // Dense packets are deliberately incompatible with the independent-class
+  // UBO cache. Plan all three classes before touching renderer-visible state,
+  // reserve one monotonically owned destination interval, and publish every
+  // offset/serial/dirty/shadow field only after the single upload record is
+  // accepted. A failed allocation or PushUploadBuffer therefore leaves the
+  // entire draw preparation transaction unchanged.
+  if (dense_ubo_enabled)
+  {
+    auto& dense_vsm = system.GetVertexShaderManager();
+    auto& dense_psm = system.GetPixelShaderManager();
+    auto& dense_gsm = system.GetGeometryShaderManager();
+    static_assert(sizeof(dense_vsm.constants) <= sizeof(m_vs_shadow));
+    static_assert(sizeof(dense_psm.constants) <= sizeof(m_ps_shadow));
+    static_assert(sizeof(dense_gsm.constants) <= sizeof(m_gs_shadow));
+
+    const bool dense_vs_changed =
+        dense_vsm.dirty || m_vs_off == kUboOffNone || !m_vs_shadow_valid ||
+        std::memcmp(m_vs_shadow.data(), &dense_vsm.constants, sizeof(dense_vsm.constants)) != 0;
+    const bool dense_ps_changed =
+        dense_psm.dirty || m_ps_off == kUboOffNone || !m_ps_shadow_valid ||
+        std::memcmp(m_ps_shadow.data(), &dense_psm.constants, sizeof(dense_psm.constants)) != 0;
+    const bool dense_gs_changed =
+        dense_gsm.dirty || m_gs_off == kUboOffNone || !m_gs_shadow_valid ||
+        std::memcmp(m_gs_shadow.data(), &dense_gsm.constants, sizeof(dense_gsm.constants)) != 0;
+    ubo_change_mask = (dense_vs_changed ? 1u : 0u) | (dense_ps_changed ? 2u : 0u) |
+                      (dense_gs_changed ? 4u : 0u);
+    ubo_payload_sizes = {dense_vs_changed ? static_cast<u32>(sizeof(dense_vsm.constants)) : 0u,
+                         dense_ps_changed ? static_cast<u32>(sizeof(dense_psm.constants)) : 0u,
+                         dense_gs_changed ? static_cast<u32>(sizeof(dense_gsm.constants)) : 0u};
+
+    if (ubo_change_mask != 0)
+    {
+      const std::array<DenseUboClass, 3> classes = {
+          DenseUboClass{&dense_vsm.constants, static_cast<u32>(sizeof(dense_vsm.constants))},
+          DenseUboClass{&dense_psm.constants, static_cast<u32>(sizeof(dense_psm.constants))},
+          DenseUboClass{&dense_gsm.constants, static_cast<u32>(sizeof(dense_gsm.constants))}};
+      const DenseUboPacketPlan plan =
+          PlanDenseUboPacket(m_ubo_ring_off, kUboRingSize, classes, ubo_change_mask);
+      if (!plan.valid)
+      {
+        m_cmd_stream.FailRequiredPublication();
+        return false;
+      }
+      const double cpu_start_ms = s_ubo_cache_metrics_enabled.load(std::memory_order_relaxed) ?
+                                      emscripten_get_now() : 0.0;
+      const u32 src = m_cmd_stream.UploadAllocUboPacket(plan, classes);
+      if (src == 0 ||
+          !m_cmd_stream.PushUploadBuffer(m_ubo_ring, plan.destination_start, src,
+                                         plan.packet_size, BufferUploadRole::Ubo))
+        return false;
+
+      // Transaction commit begins here. No renderer-visible UBO state is
+      // changed above this point.
+      m_ubo_ring_off = plan.destination_end;
+      const u64 publication_serial = ++m_ubo_publication_serial;
+      m_last_ubo_slice_serial = publication_serial;
+      if (dense_vs_changed)
+      {
+        m_vs_off = plan.destination_offsets[0];
+        m_vs_publication_serial = publication_serial;
+        dense_vsm.dirty = false;
+        std::memcpy(m_vs_shadow.data(), &dense_vsm.constants, sizeof(dense_vsm.constants));
+        m_vs_shadow_valid = true;
+        RecordUboPrepareCpu(0, cpu_start_ms);
+      }
+      if (dense_ps_changed)
+      {
+        m_ps_off = plan.destination_offsets[1];
