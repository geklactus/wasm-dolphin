+u32 WebGPUCommandStream::UploadAllocUboPacket(
+    const DenseUboPacketPlan& plan,
+    const std::array<DenseUboClass, kDenseUboClassCount>& classes)
+{
+  if (!plan.valid || plan.packet_size == 0)
+  {
+    PoisonPass();
+    return 0;
+  }
+  const u32 ptr = ReserveUpload(plan.packet_size, 16);
+  if (ptr == 0)
+    return 0;
+
+  u8* const destination = reinterpret_cast<u8*>(static_cast<uintptr_t>(ptr));
+  std::memset(destination, 0, plan.packet_size);
+  for (u32 index = 0; index < classes.size(); ++index)
+  {
+    if ((plan.change_mask & (1u << index)) == 0)
+      continue;
+    const DenseUboClass& ubo = classes[index];
+    const u32 offset = plan.relative_offsets[index];
+    if (ubo.data == nullptr || ubo.size == 0 || offset > plan.packet_size ||
+        ubo.size > plan.packet_size - offset)
+    {
+      RollbackLastUpload(ptr, plan.packet_size);
+      PoisonPass();
+      return 0;
+    }
+    std::memcpy(destination + offset, ubo.data, ubo.size);
+  }
+  return ptr;
+}
