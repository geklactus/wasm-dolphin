+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <array>
+#include <limits>
+
+#include "Common/CommonTypes.h"
+
+namespace WebGPU
+{
+constexpr u32 kDenseUboAlignment = 256;
+constexpr u32 kDenseUboClassCount = 3;
+
+struct DenseUboClass
+{
+  const void* data = nullptr;
+  u32 size = 0;
+};
+
+struct DenseUboPacketPlan
+{
+  std::array<u32, kDenseUboClassCount> relative_offsets{};
+  std::array<u32, kDenseUboClassCount> destination_offsets{};
+  u32 change_mask = 0;
+  u32 destination_start = 0;
+  u32 destination_end = 0;
+  u32 packet_size = 0;
+  bool valid = false;
+};
+
+constexpr u32 AlignDenseUbo(u32 value, u32 alignment)
+{
+  return (value + alignment - 1) & ~(alignment - 1);
+}
+
+inline DenseUboPacketPlan PlanDenseUboPacket(
+    u32 cursor, u32 ring_size, const std::array<DenseUboClass, kDenseUboClassCount>& classes,
+    u32 change_mask)
+{
+  DenseUboPacketPlan plan{};
+  plan.relative_offsets.fill(std::numeric_limits<u32>::max());
+  plan.destination_offsets.fill(std::numeric_limits<u32>::max());
+  plan.change_mask = change_mask & 7u;
+
+  // Logical class indices are VS, PS, GS. Physical PS, GS, VS order reduces
+  // alignment padding for Dolphin's real 4112/1536/64-byte blocks.
+  constexpr std::array<u32, 3> order = {1, 2, 0};
+  u32 packet_size = 0;
+  for (const u32 index : order)
+  {
+    if ((plan.change_mask & (1u << index)) == 0)
+      continue;
+    const DenseUboClass& ubo = classes[index];
+    if (ubo.data == nullptr || ubo.size == 0)
+      return plan;
+    if (packet_size > std::numeric_limits<u32>::max() - (kDenseUboAlignment - 1))
+      return plan;
+    packet_size = AlignDenseUbo(packet_size, kDenseUboAlignment);
+    if (ubo.size > std::numeric_limits<u32>::max() - packet_size)
+      return plan;
+    plan.relative_offsets[index] = packet_size;
+    packet_size += ubo.size;
+  }
+
+  if (packet_size == 0)
+  {
+    plan.destination_start = cursor;
+    plan.destination_end = cursor;
+    plan.valid = true;
+    return plan;
+  }
+  if (packet_size > std::numeric_limits<u32>::max() - (kDenseUboAlignment - 1))
+    return plan;
+  // The next utility or legacy allocation begins at destination_end. Align
+  // the whole owned interval, not only individual class starts, so every
+  // later dynamic offset inherits WebGPU's 256-byte requirement.
+  packet_size = AlignDenseUbo(packet_size, kDenseUboAlignment);
+  if (packet_size > ring_size)
+    return plan;
+
+  u32 start = AlignDenseUbo(cursor, kDenseUboAlignment);
+  if (start > ring_size || packet_size > ring_size - start)
+    start = 0;
+  plan.destination_start = start;
+  plan.destination_end = start + packet_size;
+  plan.packet_size = packet_size;
+  for (u32 index = 0; index < classes.size(); ++index)
+  {
+    if ((plan.change_mask & (1u << index)) != 0)
+      plan.destination_offsets[index] = start + plan.relative_offsets[index];
+  }
+  plan.valid = true;
+  return plan;
+}
+
+constexpr bool ShouldUseDenseUboPackets(bool requested, bool ubo_cache_enabled)
+{
+  return requested && !ubo_cache_enabled;
+}
+}  // namespace WebGPU
