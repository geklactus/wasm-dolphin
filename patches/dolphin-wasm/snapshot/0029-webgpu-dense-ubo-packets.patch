+}
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE int RunWebGpuDenseUboPacketSmoke()
+{
+  s_dense_ubo_smoke_error = "ok";
+  std::array<u8, 37> vs{};
+  std::array<u8, 73> ps{};
+  std::array<u8, 19> gs{};
+  for (u32 index = 0; index < vs.size(); ++index)
+    vs[index] = static_cast<u8>(0x10 + index);
+  for (u32 index = 0; index < ps.size(); ++index)
+    ps[index] = static_cast<u8>(0x40 + index);
+  for (u32 index = 0; index < gs.size(); ++index)
+    gs[index] = static_cast<u8>(0x90 + index);
+  const std::array<DenseUboClass, 3> classes = {
+      DenseUboClass{vs.data(), static_cast<u32>(vs.size())},
+      DenseUboClass{ps.data(), static_cast<u32>(ps.size())},
+      DenseUboClass{gs.data(), static_cast<u32>(gs.size())}};
+
+  for (u32 mask = 0; mask < 8; ++mask)
+  {
+    const DenseUboPacketPlan plan = PlanDenseUboPacket(256, 4096, classes, mask);
+    if (!plan.valid)
+      return FailDenseUboSmoke(301, "mask plan rejected");
+    if (mask == 0)
+    {
+      if (plan.packet_size != 0)
+        return FailDenseUboSmoke(302, "empty mask allocated bytes");
+      continue;
+    }
+
+    CommandStreamSmokeFixture fixture;
+    const u32 src = fixture.stream.UploadAllocUboPacket(plan, classes);
+    if (src == 0 || !fixture.stream.PushUploadBuffer(41, plan.destination_start, src,
+                                                     plan.packet_size, BufferUploadRole::Ubo))
+      return FailDenseUboSmoke(303, "packet allocation/publication failed");
+    const u8* bytes = reinterpret_cast<const u8*>(static_cast<uintptr_t>(src));
+    for (u32 offset = 0; offset < plan.packet_size; ++offset)
+    {
+      bool payload_byte = false;
+      for (u32 index = 0; index < classes.size(); ++index)
+      {
+        if ((mask & (1u << index)) == 0)
+          continue;
+        const u32 begin = plan.relative_offsets[index];
+        if (offset >= begin && offset < begin + classes[index].size)
+        {
+          const u8* expected = static_cast<const u8*>(classes[index].data);
+          if (bytes[offset] != expected[offset - begin])
+            return FailDenseUboSmoke(304, "packet payload differs");
+          payload_byte = true;
+          break;
+        }
+      }
+      if (!payload_byte && bytes[offset] != 0)
+        return FailDenseUboSmoke(305, "packet alignment gap is not zero");
+    }
+    for (u32 index = 0; index < classes.size(); ++index)
+    {
+      if ((mask & (1u << index)) != 0 &&
+          (plan.destination_offsets[index] % kDenseUboAlignment) != 0)
+        return FailDenseUboSmoke(306, "dynamic offset is not 256-byte aligned");
+    }
+    if (fixture.header.write.load(std::memory_order_acquire) != 1 ||
+        fixture.slots[0].op != static_cast<u32>(CmdOp::UploadBuffer) ||
+        fixture.slots[0].arg.u[1] != plan.destination_start ||
+        fixture.slots[0].arg.u[3] != plan.packet_size)
+      return FailDenseUboSmoke(307, "packet did not publish exactly one upload");
+  }
+
+  std::array<u8, 4112> actual_vs{};
+  std::array<u8, 1536> actual_ps{};
+  std::array<u8, 64> actual_gs{};
+  const std::array<DenseUboClass, 3> actual = {
+      DenseUboClass{actual_vs.data(), static_cast<u32>(actual_vs.size())},
+      DenseUboClass{actual_ps.data(), static_cast<u32>(actual_ps.size())},
+      DenseUboClass{actual_gs.data(), static_cast<u32>(actual_gs.size())}};
+  const DenseUboPacketPlan actual_plan = PlanDenseUboPacket(0, 32768, actual, 7);
+  if (!actual_plan.valid || actual_plan.relative_offsets[0] != 1792 ||
+      actual_plan.relative_offsets[1] != 0 || actual_plan.relative_offsets[2] != 1536 ||
+      actual_plan.packet_size != 6144 ||
+      (actual_plan.destination_end % kDenseUboAlignment) != 0)
+    return FailDenseUboSmoke(308, "actual-size PS/GS/VS layout differs");
+  CommandStreamSmokeFixture actual_fixture;
+  const u32 actual_src = actual_fixture.stream.UploadAllocUboPacket(actual_plan, actual);
+  if (actual_src == 0)
+    return FailDenseUboSmoke(309, "actual-size packet allocation failed");
+  const u8* actual_bytes = reinterpret_cast<const u8*>(static_cast<uintptr_t>(actual_src));
+  const u32 actual_payload_end =
+      actual_plan.relative_offsets[0] + static_cast<u32>(actual_vs.size());
+  for (u32 offset = actual_payload_end; offset < actual_plan.packet_size; ++offset)
+  {
+    if (actual_bytes[offset] != 0)
+      return FailDenseUboSmoke(310, "actual-size packet tail is not zero");
+  }
+  if (!ShouldUseDenseUboPackets(true, false) || ShouldUseDenseUboPackets(true, true) ||
+      ShouldUseDenseUboPackets(false, false))
+    return FailDenseUboSmoke(311, "cache fallback predicate differs");
+  return 0;
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE int RunWebGpuDenseUboRollbackSmoke()
+{
+  s_dense_ubo_smoke_error = "ok";
+  std::array<u8, 32> vs{};
+  std::array<u8, 48> ps{};
+  std::array<u8, 16> gs{};
+  const std::array<DenseUboClass, 3> classes = {
+      DenseUboClass{vs.data(), static_cast<u32>(vs.size())},
+      DenseUboClass{ps.data(), static_cast<u32>(ps.size())},
+      DenseUboClass{gs.data(), static_cast<u32>(gs.size())}};
+  const DenseUboPacketPlan plan = PlanDenseUboPacket(512, 4096, classes, 7);
+  CommandStreamSmokeFixture fixture;
+  const u32 src = fixture.stream.UploadAllocUboPacket(plan, classes);
+  if (src == 0)
+    return FailDenseUboSmoke(401, "rollback setup allocation failed");
+  WebGPUCommandStreamTestPeer::FailConsumer(fixture.stream, 0x55424F50u);
+  if (fixture.stream.PushUploadBuffer(42, plan.destination_start, src, plan.packet_size,
+                                      BufferUploadRole::Ubo))
+    return FailDenseUboSmoke(402, "failed consumer accepted packet");
+  if (WebGPUCommandStreamTestPeer::UploadWrite(fixture.stream) != 0 ||
+      fixture.header.write.load(std::memory_order_acquire) != 0)
+    return FailDenseUboSmoke(403, "failed packet did not roll back both rings");
+
+  auto invalid = classes;
+  invalid[1].data = nullptr;
+  if (PlanDenseUboPacket(512, 4096, invalid, 2).valid)
+    return FailDenseUboSmoke(404, "invalid class plan unexpectedly succeeded");
+  return 0;
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE const char* GetWebGpuDenseUboSmokeError()
+{
+  return s_dense_ubo_smoke_error;
+}
