diff --git a/Source/Core/VideoCommon/WasmWgpuIdleFifoTailGate.h b/Source/Core/VideoCommon/WasmWgpuIdleFifoTailGate.h
new file mode 100644
index 0000000000..ffb521dee5
--- /dev/null
+++ b/Source/Core/VideoCommon/WasmWgpuIdleFifoTailGate.h
@@ -0,0 +1,66 @@
+// Copyright 2026 Dolphin Emulator Project (wasm-dolphin fork)
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+namespace DolphinWeb::WgpuIdleFifoTailGate
+{
+constexpr std::uint32_t SAMPLE_PERIOD = 256;
+
+struct Counters
+{
+  std::atomic<std::uint64_t> sampled_payloads{0};
+  std::atomic<std::uint64_t> flush_needed{0};
+  std::atomic<std::uint64_t> refresh_needed{0};
+  std::atomic<std::uint64_t> both_clean{0};
+  std::atomic<std::uint64_t> dirty_at_skip{0};
+};
+
+inline std::atomic<bool> s_enabled{false};
+inline std::atomic<std::uint64_t> s_epoch{0};
+inline Counters s_counters{};
+
+inline void SetEnabled(bool enabled)
+{
+  const bool previous = s_enabled.exchange(enabled, std::memory_order_acq_rel);
+  if (previous != enabled)
+    s_epoch.fetch_add(1, std::memory_order_relaxed);
+}
+
+inline bool IsEnabled()
+{
+  return s_enabled.load(std::memory_order_relaxed);
+}
+
+inline std::uint64_t GetEpoch()
+{
+  return s_epoch.load(std::memory_order_relaxed);
+}
+
+inline const Counters& GetCounters()
+{
+  return s_counters;
+}
+
+// Run only on the GPU thread. The thread-local cursor avoids an atomic
+// increment in the idle hot path; shared atomics are touched once per period.
+inline void RecordDecision(bool flush_needed, bool refresh_needed, bool dirty_at_skip)
+{
+  static thread_local std::uint32_t sampling_cursor = 0;
+  if ((sampling_cursor++ & (SAMPLE_PERIOD - 1)) != 0)
+    return;
+
+  s_counters.sampled_payloads.fetch_add(1, std::memory_order_relaxed);
+  if (flush_needed)
+    s_counters.flush_needed.fetch_add(1, std::memory_order_relaxed);
+  if (refresh_needed)
+    s_counters.refresh_needed.fetch_add(1, std::memory_order_relaxed);
+  if (!flush_needed && !refresh_needed)
+    s_counters.both_clean.fetch_add(1, std::memory_order_relaxed);
+  if (dirty_at_skip)
+    s_counters.dirty_at_skip.fetch_add(1, std::memory_order_relaxed);
+}
+}  // namespace DolphinWeb::WgpuIdleFifoTailGate
