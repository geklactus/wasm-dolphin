diff --git a/Source/Core/VideoCommon/Fifo.cpp b/Source/Core/VideoCommon/Fifo.cpp
index d0b5aab490..7e059c2f3d 100644
--- a/Source/Core/VideoCommon/Fifo.cpp
+++ b/Source/Core/VideoCommon/Fifo.cpp
@@ -32,6 +32,7 @@
 #include "VideoCommon/VertexManagerBase.h"
 #include "VideoCommon/VideoBackendBase.h"
 #include "VideoCommon/WasmWebGpuProducerProfile.h"
+#include "VideoCommon/WasmWgpuIdleFifoTailGate.h"
 
 #ifdef __EMSCRIPTEN__
 #include <emscripten/emscripten.h>
@@ -479,12 +480,37 @@ void FifoManager::RunGpuLoop()
 
           // The fifo is empty and it's unlikely we will get any more work in the near future.
           // Make sure VertexManager finishes drawing any primitives it has stored in it's buffer.
+          if (!DolphinWeb::WgpuIdleFifoTailGate::IsEnabled())
           {
+            // Default-off is the exact upstream behavior. Keep both calls
+            // unconditional so the experiment has a clean rollback path.
             DolphinWeb::WebGpuProducerProfile::ScopedSample producer_profile(
                 DolphinWeb::WebGpuProducerProfile::Phase::FifoTailFlush);
             g_vertex_manager->Flush();
             g_framebuffer_manager->RefreshPeekCache();
           }
+          else
+          {
+            // The enabled experiment mirrors the early-return predicates in
+            // Flush and RefreshPeekCache. Do not infer dirtiness from whether
+            // this payload happened to decode a FIFO gather chunk.
+            const bool flush_needed = g_vertex_manager->NeedsFlush();
+            const bool refresh_needed = g_framebuffer_manager->NeedsPeekCacheRefresh();
+            if (flush_needed || refresh_needed)
+            {
+              DolphinWeb::WebGpuProducerProfile::ScopedSample producer_profile(
+                  DolphinWeb::WebGpuProducerProfile::Phase::FifoTailFlush);
+              if (flush_needed)
+                g_vertex_manager->Flush();
+              if (refresh_needed)
+                g_framebuffer_manager->RefreshPeekCache();
+            }
+            const bool dirty_at_skip =
+                (!flush_needed && g_vertex_manager->NeedsFlush()) ||
+                (!refresh_needed && g_framebuffer_manager->NeedsPeekCacheRefresh());
+            DolphinWeb::WgpuIdleFifoTailGate::RecordDecision(
+                flush_needed, refresh_needed, dirty_at_skip);
+          }
         }
       },
       100);
