+struct UboChangeAnalysis
+{
+  bool comparable = false;
+  u32 changed_bytes = 0;
+  u32 dirty_16_bytes = 0;
+  u32 dirty_16_ranges = 0;
+  u32 dirty_256_bytes = 0;
+  u32 dirty_256_ranges = 0;
+};
+
+constexpr UboChangeAnalysis AnalyzeUboChange(const u8* current, const u8* previous, u32 size,
+                                             bool shadow_valid)
+{
+  UboChangeAnalysis result{};
+  if (!shadow_valid || current == nullptr || previous == nullptr || size == 0)
+    return result;
+
+  result.comparable = true;
+  bool in_dirty_16_range = false;
+  bool in_dirty_256_range = false;
+  bool dirty_256_block = false;
+  for (u32 block_start = 0; block_start < size; block_start += 16)
+  {
+    const u32 block_end = std::min(block_start + 16, size);
+    bool dirty_16_block = false;
+    for (u32 offset = block_start; offset < block_end; ++offset)
+    {
+      if (current[offset] == previous[offset])
+        continue;
+      ++result.changed_bytes;
+      dirty_16_block = true;
+    }
+
+    if (dirty_16_block)
+    {
+      result.dirty_16_bytes += block_end - block_start;
+      if (!in_dirty_16_range)
+        ++result.dirty_16_ranges;
+      in_dirty_16_range = true;
+      dirty_256_block = true;
+    }
+    else
+    {
+      in_dirty_16_range = false;
+    }
+
+    const u32 region_start = (block_start / 256) * 256;
+    const u32 region_end = std::min(region_start + 256, size);
+    if (block_end != region_end)
+      continue;
+    if (dirty_256_block)
+    {
+      result.dirty_256_bytes += region_end - region_start;
+      if (!in_dirty_256_range)
+        ++result.dirty_256_ranges;
+      in_dirty_256_range = true;
+    }
+    else
+    {
+      in_dirty_256_range = false;
+    }
+    dirty_256_block = false;
+  }
+  return result;
+}
+
+consteval bool ValidateUboChangeAnalyzer()
+{
+  std::array<u8, 4112> before{};
+  auto after = before;
+  if (AnalyzeUboChange(after.data(), before.data(), after.size(), false).comparable)
+    return false;
+  const UboChangeAnalysis equal =
+      AnalyzeUboChange(after.data(), before.data(), after.size(), true);
+  if (!equal.comparable || equal.changed_bytes != 0 || equal.dirty_16_bytes != 0 ||
+      equal.dirty_256_bytes != 0)
+    return false;
+
+  after[15] = 1;
+  after[16] = 1;
+  after[17] = 1;
+  after[255] = 1;
+  after[256] = 1;
+  after[4111] = 1;
+  const UboChangeAnalysis boundaries =
+      AnalyzeUboChange(after.data(), before.data(), after.size(), true);
+  return boundaries.changed_bytes == 6 && boundaries.dirty_16_bytes == 80 &&
+         boundaries.dirty_16_ranges == 3 && boundaries.dirty_256_bytes == 528 &&
+         boundaries.dirty_256_ranges == 2;
+}
+
+static_assert(ValidateUboChangeAnalyzer());
+
+void RecordUboPayloadChange(u32 class_index, const UboChangeAnalysis& analysis, u32 size)
+{
+  if (!s_ubo_cache_metrics_enabled.load(std::memory_order_relaxed))
+    return;
+
+  s_ubo_change_upload_calls[class_index].fetch_add(1, std::memory_order_relaxed);
+  s_ubo_change_full_bytes[class_index].fetch_add(size, std::memory_order_relaxed);
+  if (!analysis.comparable)
+  {
+    s_ubo_change_baseline_full_count[class_index].fetch_add(1, std::memory_order_relaxed);
+    s_ubo_change_baseline_full_bytes[class_index].fetch_add(size, std::memory_order_relaxed);
+    return;
+  }
+  s_ubo_changed_bytes[class_index].fetch_add(analysis.changed_bytes,
+                                             std::memory_order_relaxed);
+  s_ubo_dirty_16_bytes[class_index].fetch_add(analysis.dirty_16_bytes,
+                                              std::memory_order_relaxed);
+  s_ubo_dirty_16_ranges[class_index].fetch_add(analysis.dirty_16_ranges,
+                                               std::memory_order_relaxed);
+  s_ubo_dirty_256_bytes[class_index].fetch_add(analysis.dirty_256_bytes,
+                                               std::memory_order_relaxed);
+  s_ubo_dirty_256_ranges[class_index].fetch_add(analysis.dirty_256_ranges,
+                                                std::memory_order_relaxed);
+}
