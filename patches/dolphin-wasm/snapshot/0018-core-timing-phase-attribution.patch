+inline WorstDvdCompletion CaptureWorstDvdCompletion()
+{
+  WorstDvdCompletion snapshot;
+  std::uint32_t before = 0;
+  std::uint32_t after = 0;
+  do
+  {
+    before = s_worst_dvd_completion.sequence.load(std::memory_order_acquire);
+    if ((before & 1U) != 0)
+      continue;
+    snapshot.total_us = s_worst_dvd_completion.total_us.load(std::memory_order_relaxed);
+    snapshot.map_us = s_worst_dvd_completion.map_us.load(std::memory_order_relaxed);
+    snapshot.queue_wait_us =
+        s_worst_dvd_completion.queue_wait_us.load(std::memory_order_relaxed);
+    snapshot.queue_pop_us =
+        s_worst_dvd_completion.queue_pop_us.load(std::memory_order_relaxed);
+    snapshot.ram_copy_us =
+        s_worst_dvd_completion.ram_copy_us.load(std::memory_order_relaxed);
+    snapshot.command_finish_us =
+        s_worst_dvd_completion.command_finish_us.load(std::memory_order_relaxed);
+    snapshot.other_us = s_worst_dvd_completion.other_us.load(std::memory_order_relaxed);
+    snapshot.bytes = s_worst_dvd_completion.bytes.load(std::memory_order_relaxed);
