+inline ThrottleProfile CaptureThrottleProfile(ThrottleSite site)
+{
+  ThrottleProfile snapshot;
+  const std::size_t site_index = static_cast<std::size_t>(site);
+  if (site == ThrottleSite::None || site_index >= static_cast<std::size_t>(ThrottleSite::Count))
+    return snapshot;
+
+  const ThrottleProfileStorage& profile = s_throttle_profiles[site_index];
+  std::uint32_t before = 0;
+  std::uint32_t after = 0;
+  do
+  {
+    before = profile.sequence.load(std::memory_order_acquire);
+    if ((before & 1U) != 0)
+      continue;
+    snapshot.count = profile.count.load(std::memory_order_relaxed);
+    snapshot.slow_count = profile.slow_count.load(std::memory_order_relaxed);
+    snapshot.total_actual_us = profile.total_actual_us.load(std::memory_order_relaxed);
+    snapshot.max_actual_us = profile.max_actual_us.load(std::memory_order_relaxed);
+    snapshot.requested_us = profile.requested_us.load(std::memory_order_relaxed);
+    snapshot.overshoot_us = profile.overshoot_us.load(std::memory_order_relaxed);
