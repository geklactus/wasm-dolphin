@@ -432,6 +432,20 @@ private:
 // reference through VideoCommon. EnsureRing() is idempotent.
 WebGPUCommandStream& GetCommandStream();
 
+// Narrow native-test peer used by the exported geometry smokes. Production
+// code never calls this seam. It lets a smoke install a bounded in-memory ring
+// on the real process-global stream, while refusing to replace a ring already
+// owned by a live renderer.
+struct WebGPUCommandStreamTestPeer
+{
+  static void Initialize(WebGPUCommandStream& stream, CmdRingHeader& header, CmdRecord* slots,
+                         u32 capacity, u8* upload, u32 upload_size);
+  static bool InitializeGlobalSmoke(CmdRingHeader& header, CmdRecord* slots, u32 capacity,
+                                    u8* upload, u32 upload_size);
+  static u32 UploadWrite(const WebGPUCommandStream& stream);
+  static void FailConsumer(WebGPUCommandStream& stream, u32 error);
+};
+
 // Native wasm regression seams. These execute the real command-stream upload,
 // publication, pass-staging, and rollback methods against an isolated tiny
 // ring; they do not require a browser GPU device or mutate the live stream.
