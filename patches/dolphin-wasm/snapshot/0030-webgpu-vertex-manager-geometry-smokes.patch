+extern "C" EMSCRIPTEN_KEEPALIVE int RunWebGpuVertexManagerGeometryParitySmoke(int indexed,
+                                                                               int packed)
+{
+  s_vertex_manager_geometry_smoke_error = "ok";
+  if (!s_vertex_manager_smoke_fixture.Reset())
+    return FailVertexManagerSmoke(301, "refused to replace a live WebGPU command ring");
+
+  SetWebGpuGeometryPackEnabled(packed != 0 ? 1 : 0);
+  constexpr u32 stride = 16;
+  constexpr u8 vertices[48] = {
+      0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17, 0x18, 0x19, 0x1A, 0x1B,
+      0x1C, 0x1D, 0x1E, 0x1F, 0x20, 0x21, 0x22, 0x23, 0x24, 0x25, 0x26, 0x27,
+      0x28, 0x29, 0x2A, 0x2B, 0x2C, 0x2D, 0x2E, 0x2F, 0x30, 0x31, 0x32, 0x33,
+      0x34, 0x35, 0x36, 0x37, 0x38, 0x39, 0x3A, 0x3B, 0x3C, 0x3D, 0x3E, 0x3F};
+  constexpr u16 indices[] = {0, 1, 2, 2, 1, 0};
+  const u32 num_indices = indexed != 0 ? static_cast<u32>(std::size(indices)) : 0;
+
+  VertexManager manager;
+  VertexManagerTestPeer::Seed(manager, vertices, sizeof(vertices), indices, num_indices, stride);
+  u32 base_vertex = UINT32_MAX;
+  u32 base_index = UINT32_MAX;
+  VertexManagerTestPeer::Commit(manager, 3, stride, num_indices, &base_vertex, &base_index);
+
+  const BufferUploadRole vertex_role = packed != 0 ? BufferUploadRole::Geometry :
+                                                     BufferUploadRole::Vertex;
+  const CmdRecord* const vertex_upload = FindUpload(s_vertex_manager_smoke_fixture, vertex_role);
+  if (!CheckBytes(vertex_upload, vertices, sizeof(vertices)))
+    return FailVertexManagerSmoke(302, "VertexManager vertex bytes were not published exactly");
+  if (packed != 0)
+  {
+    if (VertexManagerTestPeer::VertexId(manager) == 0 ||
+        VertexManagerTestPeer::VertexId(manager) != VertexManagerTestPeer::IndexId(manager) ||
+        base_vertex != 0 || base_index != sizeof(vertices) / sizeof(u16))
+      return FailVertexManagerSmoke(303, "packed VertexManager ids or base offsets differ");
+    if (num_indices != 0 &&
+        std::memcmp(reinterpret_cast<const u8*>(static_cast<uintptr_t>(vertex_upload->arg.u[2])) +
+                        sizeof(vertices),
+                    indices, sizeof(indices)) != 0)
+      return FailVertexManagerSmoke(304, "packed VertexManager index bytes differ");
+  }
+  else
+  {
+    if (VertexManagerTestPeer::VertexId(manager) == 0 ||
+        VertexManagerTestPeer::IndexId(manager) == 0 || base_vertex != 0 || base_index != 0)
+      return FailVertexManagerSmoke(305, "legacy VertexManager ids or base offsets differ");
+    if (num_indices != 0 &&
+        !CheckBytes(FindUpload(s_vertex_manager_smoke_fixture, BufferUploadRole::Index), indices,
+                    sizeof(indices)))
+      return FailVertexManagerSmoke(306, "legacy VertexManager index bytes differ");
+  }
+
+  WebGPUCommandStream& stream = GetCommandStream();
+  if (!stream.PushBeginPass(7, 0, 0, 0, 1, 1, 8) ||
+      !stream.PushSetVertexBuffer(0, VertexManagerTestPeer::VertexId(manager), 0))
+    return FailVertexManagerSmoke(307, "draw suffix rejected real VertexManager buffer output");
+  if (num_indices != 0 &&
+      !stream.PushSetIndexBuffer(VertexManagerTestPeer::IndexId(manager), 0,
+                                 base_index * sizeof(u16)))
+    return FailVertexManagerSmoke(308, "indexed suffix rejected real VertexManager offset");
+  const bool draw_ok = num_indices != 0 ? stream.PushDrawIndexed(num_indices, 1, base_index,
+                                                                 base_vertex) :
+                                          stream.PushDraw(3, 1, base_vertex);
+  if (!draw_ok || !stream.PushEndPass())
+    return FailVertexManagerSmoke(309, "draw suffix from real VertexManager output was not atomic");
+  return 0;
+}
