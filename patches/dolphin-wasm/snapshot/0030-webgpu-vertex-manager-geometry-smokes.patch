 {
+extern "C" void SetWebGpuGeometryPackEnabled(int enabled);
+
 // GPUBufferUsage numeric flags (DESIGN doc): VERTEX 0x20, INDEX 0x10,
 // COPY_DST 0x8.
 static constexpr u32 kUsageVertex = 0x20 | 0x8;
@@ -258,4 +261,335 @@ void VertexManager::UploadUtilityUniforms(const void* uniforms, u32 uniforms_siz
     static_cast<WebGPUGfx*>(g_gfx.get())->UploadUtilityUniforms(uniforms, uniforms_size);
 }
 
+namespace
+{
+const char* s_vertex_manager_geometry_smoke_error = "ok";
+
+struct VertexManagerSmokeFixture
+{
+  CmdRingHeader header{};
+  CmdRecord slots[64]{};
+  alignas(16) u8 upload[1024]{};
+
+  bool Reset()
+  {
+    return WebGPUCommandStreamTestPeer::InitializeGlobalSmoke(
+        header, slots, static_cast<u32>(std::size(slots)), upload, sizeof(upload));
+  }
+};
+
+VertexManagerSmokeFixture s_vertex_manager_smoke_fixture;
+
+int FailVertexManagerSmoke(int code, const char* message)
+{
+  s_vertex_manager_geometry_smoke_error = message;
+  return code;
+}
+
+const CmdRecord* FindUpload(const VertexManagerSmokeFixture& fixture, BufferUploadRole role)
+{
+  const u32 write = fixture.header.write.load(std::memory_order_acquire);
+  for (u32 index = 0; index < write; ++index)
+  {
+    const CmdRecord& record = fixture.slots[index % std::size(fixture.slots)];
+    if (record.op == static_cast<u32>(CmdOp::UploadBuffer) &&
+        record.arg.u[4] == static_cast<u32>(role))
+      return &record;
+  }
+  return nullptr;
+}
+
+bool CheckBytes(const CmdRecord* record, const void* expected, u32 expected_size)
+{
+  return record != nullptr && record->arg.u[3] >= expected_size &&
+         std::memcmp(reinterpret_cast<const void*>(static_cast<uintptr_t>(record->arg.u[2])),
+                     expected, expected_size) == 0;
+}
+}  // namespace
+
+struct VertexManagerTestPeer
+{
+  static void Seed(VertexManager& manager, const void* vertices, u32 vertex_bytes,
+                   const u16* indices, u32 num_indices, u32 vertex_stride)
+  {
+    manager.ResetBuffer(vertex_stride);
+    std::memcpy(manager.m_base_buffer_pointer, vertices, vertex_bytes);
+    if (num_indices != 0)
+      std::memcpy(manager.m_cpu_index_buffer.data(), indices, num_indices * sizeof(u16));
+  }
+
+  static void Commit(VertexManager& manager, u32 num_vertices, u32 vertex_stride,
+                     u32 num_indices, u32* base_vertex, u32* base_index)
+  {
+    manager.CommitBuffer(num_vertices, vertex_stride, num_indices, base_vertex, base_index);
+  }
+
+  static void SeedPackedWrap(VertexManager& manager)
+  {
+    manager.m_geometry_pack_active = true;
+    manager.m_geometry_pack_epoch = GetGeometryUploadPackEpoch();
+    manager.m_geometry_buffer_id = 91;
+    manager.m_geometry_offset = VertexManager::kGeometryBufferSize - 8;
+    manager.m_geometry_generations_since_submit = 1;
+    manager.m_geometry_submit_serial = GetCommandStream().GetSubmitSerial();
+  }
+
+  static void ForcePackedWrap(VertexManager& manager)
+  {
+    manager.m_geometry_offset = VertexManager::kGeometryBufferSize - 8;
+  }
+
+  static void SeedLegacyWrap(VertexManager& manager)
+  {
+    manager.m_geometry_pack_active = false;
+    manager.m_geometry_pack_epoch = GetGeometryUploadPackEpoch();
+    manager.m_vertex_buffer_id = 91;
+    manager.m_index_buffer_id = 92;
+    manager.m_vertex_offset = VertexManager::kVertexBufferSize - 8;
+    manager.m_index_offset = VertexManager::kIndexBufferSize - 4;
+  }
+
+  static u32 VertexId(const VertexManager& manager) { return manager.GetVertexBufferId(); }
+  static u32 IndexId(const VertexManager& manager) { return manager.GetIndexBufferId(); }
+  static u32 GeometryOffset(const VertexManager& manager) { return manager.m_geometry_offset; }
+  static u32 GeometryGenerations(const VertexManager& manager)
+  {
+    return manager.m_geometry_generations_since_submit;
+  }
+  static u64 GeometrySubmitSerial(const VertexManager& manager)
+  {
+    return manager.m_geometry_submit_serial;
+  }
+  static u32 MaxGeometryGenerations()
+  {
+    return VertexManager::kMaxGeometryGenerationsPerSubmit;
+  }
+  static u32 VertexOffset(const VertexManager& manager) { return manager.m_vertex_offset; }
+  static u32 IndexOffset(const VertexManager& manager) { return manager.m_index_offset; }
+};
