@@ -0,0 +1,28 @@
+// Copyright 2026 Dolphin Emulator Project (wasm-dolphin fork)
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+namespace DolphinWeb::WebGpuUniformFastPath
+{
+struct ComparisonPlan
+{
+  bool upload_mandatory;
+  bool compare_shadow;
+
+  constexpr bool ShouldUpload(bool bytes_changed) const
+  {
+    return upload_mandatory || bytes_changed;
+  }
+};
+
+// The fast path may bypass an exact whole-block comparison only when the draw
+// already has to publish a new slice. A valid, live, apparently-clean slice
+// always receives the exact comparison that protects against missed dirty bits.
+constexpr ComparisonPlan Plan(bool fast_enabled, bool dirty, bool offset_missing,
+                              bool shadow_valid, bool expired)
+{
+  const bool mandatory = dirty || offset_missing || !shadow_valid || expired;
+  return {mandatory, shadow_valid && (!fast_enabled || !mandatory)};
+}
+}  // namespace DolphinWeb::WebGpuUniformFastPath
