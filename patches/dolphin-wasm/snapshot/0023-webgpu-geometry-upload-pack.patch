+u32 WebGPUCommandStream::UploadAlloc(const void* data, size_t len, u32 align)
+{
+  if (!data)
+  {
+    PoisonPass();
+    return 0;
+  }
+  const u32 ptr = ReserveUpload(len, align);
+  if (ptr == 0)
+    return 0;
+  std::memcpy(reinterpret_cast<void*>(static_cast<uintptr_t>(ptr)), data, len);
+  return ptr;
+}
+
+UploadPacket WebGPUCommandStream::UploadAllocTwoSegments(const void* first, size_t first_len,
+                                                          const void* second, size_t second_len,
+                                                          u32 second_align, u32 packet_align)
+{
+  UploadPacket packet{};
+  if ((first_len != 0 && first == nullptr) || (second_len != 0 && second == nullptr) ||
+      (first_len == 0 && second_len == 0))
+  {
+    PoisonPass();
+    return packet;
+  }
+  if (second_align < 4)
+    second_align = 4;
+  if ((second_align & (second_align - 1)) != 0 || first_len > UINT32_MAX ||
+      second_len > UINT32_MAX)
+  {
+    PoisonPass();
+    return packet;
+  }
+
+  const size_t second_offset = (first_len + second_align - 1) & ~(static_cast<size_t>(second_align) - 1);
+  if (second_offset < first_len || second_len > UINT32_MAX - second_offset)
+  {
+    PoisonPass();
+    return packet;
+  }
+  const size_t payload_size = second_offset + second_len;
+  if (payload_size > UINT32_MAX - 3u)
+  {
+    PoisonPass();
+    return packet;
+  }
+  const size_t total_size = (payload_size + 3u) & ~static_cast<size_t>(3u);
+  const u32 ptr = ReserveUpload(total_size, packet_align);
+  if (ptr == 0)
+    return packet;
+
+  u8* const destination = reinterpret_cast<u8*>(static_cast<uintptr_t>(ptr));
+  if (first_len != 0)
+    std::memcpy(destination, first, first_len);
+  if (second_offset > first_len)
+    std::memset(destination + first_len, 0, second_offset - first_len);
+  if (second_len != 0)
+    std::memcpy(destination + second_offset, second, second_len);
+  if (total_size > payload_size)
+    std::memset(destination + payload_size, 0, total_size - payload_size);
+
+  packet.src_heap_ptr = ptr;
+  packet.second_offset = static_cast<u32>(second_offset);
+  packet.total_size = static_cast<u32>(total_size);
+  return packet;
+}
