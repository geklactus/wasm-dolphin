 namespace EfbInterface
 {
 static std::array<u8, EFB_WIDTH * EFB_HEIGHT * 6> efb;
@@ -561,6 +578,116 @@ static yuv444 ConvertColorToYUV(u32 color)
   return {y_round, u_round, v_round};
 }
 
+static u32 ElapsedProfileMicros(std::chrono::steady_clock::time_point start,
+                                std::chrono::steady_clock::time_point end)
+{
+  return static_cast<u32>(
+      std::chrono::duration_cast<std::chrono::microseconds>(end - start).count());
+}
+
+static inline u8 XfbLerpU8(u8 a, u8 b)
+{
+  return static_cast<u8>((static_cast<u16>(a) + static_cast<u16>(b) + 1) >> 1);
+}
+
+static void FastEncodeXFB(u8* xfb_in_ram, u32 memory_stride,
+                          const MathUtil::Rectangle<int>& source_rect, float y_scale, int mode,
+                          std::chrono::steady_clock::time_point profile_start)
+{
+  const int left = source_rect.left;
+  const int top = source_rect.top;
+  const int src_width = source_rect.GetWidth();
+  const int src_height = source_rect.GetHeight();
+  const int dst_height = std::max(1, static_cast<int>(src_height * y_scale));
+
+  yuv422_packed* dst = reinterpret_cast<yuv422_packed*>(xfb_in_ram);
+  const int even_width = src_width & ~1;
+
+  // mode 3 ("tuned"): same per-row work as mode 2 (only even dst rows run the
+  // scalar YUV convert), but the skipped odd rows are reconstructed by vertical
+  // interpolation between the encoded rows above/below instead of a nearest-row
+  // memcpy. This yields smooth vertical gradients (no blocky row-doubling on 3D)
+  // at ~mode-2 cost and with no temporal flicker. encode_mode drives the inner
+  // per-row sampling; the odd rows are filled in a second pass below.
+  const bool lerp_reconstruct = mode >= 3;
+  const int encode_mode = lerp_reconstruct ? 2 : mode;
+
+  for (int dst_y = 0; dst_y < dst_height; ++dst_y)
+  {
+    yuv422_packed* row = dst + static_cast<std::size_t>(dst_y) * memory_stride;
+    if (encode_mode > 1 && dst_y > 0 && (dst_y & 1) != 0)
+    {
+      if (lerp_reconstruct)
+        continue;  // filled by the reconstruction pass after the row loop
+      std::memcpy(row, row - memory_stride, static_cast<std::size_t>(src_width) * sizeof(*row));
+      continue;
+    }
+
+    const auto scaled_y =
+        static_cast<int>((static_cast<std::int64_t>(dst_y) * src_height) / dst_height);
+    u16 src_y =
+        static_cast<u16>(std::clamp(top + scaled_y, 0, static_cast<int>(EFB_HEIGHT) - 1));
+    if (encode_mode > 0)
+      src_y &= ~u16{1};
+
+    for (int x = 0; x < even_width; x += 2)
+    {
+      u16 src_x0 =
+          static_cast<u16>(std::clamp(left + x, 0, static_cast<int>(EFB_WIDTH) - 1));
+      u16 src_x1 =
+          static_cast<u16>(std::clamp(left + x + 1, 0, static_cast<int>(EFB_WIDTH) - 1));
+      if (encode_mode > 0)
+      {
+        src_x0 &= ~u16{1};
+        src_x1 = src_x0;
+      }
+      const yuv444 yuv0 = ConvertColorToYUV(GetColor(src_x0, src_y));
+      const yuv444 yuv1 = encode_mode > 1 ? yuv0 : ConvertColorToYUV(GetColor(src_x1, src_y));
+
+      row[x].Y = yuv0.Y + 16;
+      row[x].UV = 128 + yuv0.U;
+      row[x + 1].Y = yuv1.Y + 16;
+      row[x + 1].UV = 128 + yuv1.V;
+    }
+
+    if (even_width != src_width)
+    {
+      u16 src_x =
+          static_cast<u16>(std::clamp(left + even_width, 0, static_cast<int>(EFB_WIDTH) - 1));
+      if (encode_mode > 0)
+        src_x &= ~u16{1};
+      const yuv444 yuv = ConvertColorToYUV(GetColor(src_x, src_y));
+      row[even_width].Y = yuv.Y + 16;
+      row[even_width].UV = 128 + yuv.U;
+    }
+  }
+
+  if (lerp_reconstruct)
+  {
+    // Fill each skipped odd row as the average of the encoded even rows above
+    // and below it. The final odd row (when dst_height is even) has no row
+    // below, so it falls back to the row above (a plain copy).
+    for (int dst_y = 1; dst_y < dst_height; dst_y += 2)
+    {
+      yuv422_packed* row = dst + static_cast<std::size_t>(dst_y) * memory_stride;
+      const yuv422_packed* above = row - memory_stride;
+      const int below_y = (dst_y + 1 < dst_height) ? dst_y + 1 : dst_y - 1;
+      const yuv422_packed* below = dst + static_cast<std::size_t>(below_y) * memory_stride;
+      for (int x = 0; x < src_width; ++x)
+      {
+        row[x].Y = XfbLerpU8(above[x].Y, below[x].Y);
+        row[x].UV = XfbLerpU8(above[x].UV, below[x].UV);
+      }
+    }
+  }
+
+  const auto profile_done = std::chrono::steady_clock::now();
+  const u32 total_us = ElapsedProfileMicros(profile_start, profile_done);
+  DolphinWeb_RecordSoftwareXfbEncodeProfile(total_us, 0, total_us, static_cast<u32>(src_width),
+                                            static_cast<u32>(src_height),
+                                            static_cast<u32>(dst_height));
+}
