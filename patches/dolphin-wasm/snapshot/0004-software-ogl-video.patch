 static void Draw(s32 x, s32 y, s32 xi, s32 yi)
 {
+  static const int fast_software_raster = DolphinWeb_FastSoftwareRaster();
+  // fastsw skips 3 of every 4 pixels (level 1) or 15 of every 16 (level 2)
+  // and relies on the skipped pixels inheriting their neighbor's color via
+  // a post-pass at the end of Draw() below. The skip itself is the speed
+  // win; the inheritance is what keeps shaded/blended surfaces from showing
+  // through to the clear color (Melee's stage shadows show this clearly).
+  if (fast_software_raster > 1 && ((x | y) & 3) != 0)
+    return;
+  if (fast_software_raster > 0 && ((x | y) & 1) != 0)
+    return;
+
   INCSTAT(g_stats.this_frame.rasterized_pixels);
 
   s32 z = (s32)std::clamp<float>(ZSlope.GetValue(x, y), 0.0f, 16777215.0f);
@@ -202,6 +222,54 @@ static void Draw(s32 x, s32 y, s32 xi, s32 yi)
   }
 
   tev.Draw();
+
+  // fastsw post-pass: replicate the rendered cell's post-blend color over
+  // the skipped neighbors so shaded gradients/blends don't leak the clear
+  // color through to the final frame (the "dotted black hole" pattern on
+  // TEV-shaded surfaces like the Peach's Castle dome and Hyrule Temple
+  // shadow walls).
+  //
+  // Level 1 (step=2): fills a 2x2 block; the rendered (even, even) cell
+  // plus its 3 same-block neighbors. The rasterizer iterates 2x2 blocks
+  // so the neighbors are always inside the same scissor-clamped block.
+  //
+  // Level 2 (step=4): fills a 4x4 block. The rendered cell is at
+  // ((x|y)&3)==0; the other 15 cells span two 2x2 raster blocks in each
+  // axis. Cells outside the EFB bounds are skipped; cells outside the
+  // current scissor MAY be written (mild edge bleed in partial-coverage
+  // triangles), which is acceptable given level 2 is an aggressive
+  // low-quality mode.
+  //
+  // Gated on color_update because if BlendTev didn't write at (x, y) we'd
+  // be propagating stale data — harmless but wasteful. Depth isn't
+  // propagated: the skipped cells won't be re-rasterized this frame, so
+  // their stale depth has no effect on correctness.
+  if (fast_software_raster > 0 && bpmem.blendmode.color_update)
+  {
+    const s32 step = (fast_software_raster > 1) ? 4 : 2;
+    const s32 max_dx =
+        std::min(step, static_cast<s32>(EFB_WIDTH) - x);
+    const s32 max_dy =
+        std::min(step, static_cast<s32>(EFB_HEIGHT) - y);
+    const u8* src =
+        EfbInterface::GetPixelPointer(static_cast<u16>(x), static_cast<u16>(y), false);
+    const u8 c0 = src[0];
+    const u8 c1 = src[1];
+    const u8 c2 = src[2];
+    for (s32 dy = 0; dy < max_dy; dy++)
+    {
+      for (s32 dx = 0; dx < max_dx; dx++)
+      {
+        if (dx == 0 && dy == 0)
+          continue;
+        u8* dst = EfbInterface::GetPixelPointer(static_cast<u16>(x + dx),
+                                                static_cast<u16>(y + dy), false);
+        dst[0] = c0;
+        dst[1] = c1;
+        dst[2] = c2;
+      }
+    }
+  }
 }
 
 static inline void CalculateLOD(s32* lodp, bool* linear, u32 texmap, u32 texcoord)
