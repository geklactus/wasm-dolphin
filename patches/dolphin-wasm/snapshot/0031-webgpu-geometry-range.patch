+void VertexManager::DiscardPendingGeometryRange()
+{
+  m_pending_geometry_range.bytes.clear();
+  m_pending_geometry_range.buffer_id = 0;
+  m_pending_geometry_range.destination_start = 0;
+  m_pending_geometry_range.destination_end = 0;
+  m_pending_geometry_range.generation = 0;
+  m_pending_geometry_range.epoch = GetGeometryUploadRangeEpoch();
+}
+
+bool VertexManager::FlushPendingGeometryRange()
+{
+  PendingGeometryRange& pending = m_pending_geometry_range;
+  if (pending.bytes.empty())
+    return true;
+
+  WebGPUCommandStream& cs = GetCommandStream();
+  if (!IsGeometryUploadRangeEnabled() || pending.epoch != GetGeometryUploadRangeEpoch() ||
+      pending.buffer_id == 0 || pending.bytes.size() > kGeometryRangeMaxBytes ||
+      pending.bytes.size() > kGeometryRangeHardBytes)
+  {
+    DiscardPendingGeometryRange();
+    cs.FailRequiredPublication();
+    return false;
+  }
+
+  // PushUploadBuffer intentionally uses the public FIFO even while draw
+  // records are pass-private. Thus this upload becomes visible before the
+  // later atomic BEGIN_PASS..END_PASS batch; a mapped-staging capacity wait
+  // can never occur while the JS consumer has an open render pass.
+  const u32 size = static_cast<u32>(pending.bytes.size());
+  const u32 source = cs.UploadAlloc(pending.bytes.data(), size, 4);
+  if (source == 0 ||
+      !cs.PushUploadBuffer(pending.buffer_id, pending.destination_start, source, size,
+                           BufferUploadRole::Geometry))
+  {
+    DiscardPendingGeometryRange();
+    InvalidateGeometryUploadRange();
+    InvalidateGeometryUploadPack();
+    cs.FailRequiredPublication();
+    return false;
+  }
+
+  DiscardPendingGeometryRange();
+  return true;
+}
+
+bool VertexManager::AppendPendingGeometryRange(u32 buffer_id, u32 destination_offset,
+                                               u64 generation, const void* vertices,
+                                               u32 vertex_bytes, const void* indices,
+                                               u32 index_bytes, u32 packet_bytes)
+{
+  WebGPUCommandStream& cs = GetCommandStream();
+  const u64 range_epoch = GetGeometryUploadRangeEpoch();
+  if (!IsGeometryUploadRangeEnabled() || buffer_id == 0 || packet_bytes == 0 ||
+      packet_bytes > kGeometryRangeMaxBytes || packet_bytes > kGeometryRangeHardBytes ||
+      destination_offset > std::numeric_limits<u32>::max() - packet_bytes ||
+      (vertex_bytes != 0 && vertices == nullptr) || (index_bytes != 0 && indices == nullptr) ||
+      vertex_bytes > packet_bytes || index_bytes > packet_bytes - vertex_bytes)
+  {
+    cs.FailRequiredPublication();
+    return false;
+  }
+
+  PendingGeometryRange& pending = m_pending_geometry_range;
+  if (!pending.bytes.empty() && pending.epoch != range_epoch)
+  {
+    DiscardPendingGeometryRange();
+    cs.FailRequiredPublication();
+    return false;
+  }
+
+  u32 gap = 0;
+  bool append = !pending.bytes.empty() && pending.buffer_id == buffer_id &&
+                pending.generation == generation && destination_offset >= pending.destination_end;
+  if (append)
+  {
+    gap = destination_offset - pending.destination_end;
+    const u64 merged_size = static_cast<u64>(pending.bytes.size()) + gap + packet_bytes;
+    append = gap <= kGeometryRangeMaxGap && merged_size <= kGeometryRangeMaxBytes &&
+             merged_size <= kGeometryRangeHardBytes;
+  }
+
+  if (!pending.bytes.empty() && !append)
+  {
+    // A buffer/generation boundary, a >64-byte alignment hole, or the bounded
+    // range cap splits the upload. The old upload may become an orphan if
+    // a later step fails, but no fallback path can partially publish a draw.
+    if (!FlushPendingGeometryRange())
+      return false;
+  }
+
+  if (pending.bytes.empty())
+  {
+    pending.buffer_id = buffer_id;
+    pending.destination_start = destination_offset;
+    pending.destination_end = destination_offset;
+    pending.generation = generation;
+    pending.epoch = range_epoch;
+    gap = 0;
+  }
+
+  const size_t old_size = pending.bytes.size();
+  pending.bytes.resize(old_size + gap + packet_bytes, 0);
+  u8* const destination = pending.bytes.data() + old_size + gap;
+  if (vertex_bytes != 0)
+    std::memcpy(destination, vertices, vertex_bytes);
+  if (index_bytes != 0)
+    std::memcpy(destination + vertex_bytes, indices, index_bytes);
+  pending.destination_end = destination_offset + packet_bytes;
+  return true;
+}
