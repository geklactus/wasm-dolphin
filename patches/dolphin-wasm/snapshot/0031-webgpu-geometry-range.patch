+                                &second_base_vertex, &second_base_index);
+  if (second_base_vertex != 4 || second_base_index != (256 + stride * 3) / sizeof(u16) ||
+      VertexManagerTestPeer::PendingRangeSize(manager) != 456 ||
+      !stream.PushDrawIndexed(static_cast<u32>(std::size(indices)), 1, second_base_index,
+                              second_base_vertex))
+    return FailVertexManagerSmoke(604, "second range packet or draw placement differs");
+
+  if (!manager.FlushPendingGeometryRange())
+    return FailVertexManagerSmoke(605, "range flush failed");
+  if (s_vertex_manager_smoke_fixture.header.write.load(std::memory_order_acquire) != 2 ||
+      s_vertex_manager_smoke_fixture.slots[1].op != static_cast<u32>(CmdOp::UploadBuffer) ||
+      s_vertex_manager_smoke_fixture.slots[1].arg.u[1] != 0 ||
+      s_vertex_manager_smoke_fixture.slots[1].arg.u[3] != 456)
+    return FailVertexManagerSmoke(606, "coarse upload was not published before private pass");
+  const u8* range = reinterpret_cast<const u8*>(
+      static_cast<uintptr_t>(s_vertex_manager_smoke_fixture.slots[1].arg.u[2]));
+  if (std::memcmp(range, vertices_a, sizeof(vertices_a)) != 0 ||
+      std::memcmp(range + stride * 3, indices, sizeof(indices)) != 0 || range[198] != 0 ||
+      range[199] != 0 ||
+      std::any_of(range + 200, range + 256, [](u8 value) { return value != 0; }) ||
+      std::memcmp(range + 256, vertices_b, sizeof(vertices_b)) != 0 ||
+      std::memcmp(range + 256 + stride * 3, indices, sizeof(indices)) != 0 ||
+      range[454] != 0 || range[455] != 0)
+    return FailVertexManagerSmoke(607, "coarse upload changed payload or alignment padding");
+  if (!stream.PushEndPass() ||
+      s_vertex_manager_smoke_fixture.slots[2].op != static_cast<u32>(CmdOp::BeginPass))
+    return FailVertexManagerSmoke(608, "coarse upload did not precede atomic pass publication");
+
+  // Model the WebGPUGfx skip path: draw A is already private, commit B has
+  // extended the same pending upload, then draw B is rejected before it can
+  // be staged. The only safe action is to abort the whole pass; discarding B
+  // alone would publish draw A without either packet's upload.
+  if (!s_vertex_manager_smoke_fixture.Reset())
+    return FailVertexManagerSmoke(609, "skipped-draw fixture reset failed");
+  SetWebGpuGeometryPackEnabled(1);
+  SetWebGpuGeometryRangeEnabled(1);
+  VertexManager skipped_manager;
+  VertexManagerTestPeer::Seed(skipped_manager, vertices_a, sizeof(vertices_a), indices,
+                              static_cast<u32>(std::size(indices)), stride);
+  VertexManagerTestPeer::Commit(skipped_manager, 3, stride,
+                                static_cast<u32>(std::size(indices)), &first_base_vertex,
+                                &first_base_index);
+  if (!stream.PushBeginPass(7, 0, 0, 0, 1, 1, 8) ||
+      !stream.PushDrawIndexed(static_cast<u32>(std::size(indices)), 1, first_base_index,
+                              first_base_vertex))
+    return FailVertexManagerSmoke(610, "skipped-draw fixture could not stage draw A");
+  VertexManagerTestPeer::Seed(skipped_manager, vertices_b, sizeof(vertices_b), indices,
+                              static_cast<u32>(std::size(indices)), stride);
+  VertexManagerTestPeer::Commit(skipped_manager, 3, stride,
+                                static_cast<u32>(std::size(indices)), &second_base_vertex,
+                                &second_base_index);
+  if (!skipped_manager.HasPendingGeometryRange())
+    return FailVertexManagerSmoke(611, "commit B did not retain the owning range");
+  stream.AbortPass();
+  skipped_manager.DiscardPendingGeometryRange();
+  if (stream.PushEndPass() || skipped_manager.HasPendingGeometryRange() ||
+      s_vertex_manager_smoke_fixture.header.write.load(std::memory_order_acquire) != 1)
+    return FailVertexManagerSmoke(612, "skipped draw published draw A without its upload");
+
+  // With no pass open, a missing first draw has no older draw to protect.
+  // Discarding only the private range avoids invalidating and rotating the
+  // 32 MiB destination on every unsupported pipeline.
+  if (!s_vertex_manager_smoke_fixture.Reset())
+    return FailVertexManagerSmoke(613, "missing-first-draw fixture reset failed");
+  SetWebGpuGeometryPackEnabled(1);
+  SetWebGpuGeometryRangeEnabled(1);
+  VertexManager missing_draw_manager;
+  VertexManagerTestPeer::Seed(missing_draw_manager, vertices_a, sizeof(vertices_a), indices,
+                              static_cast<u32>(std::size(indices)), stride);
+  VertexManagerTestPeer::Commit(missing_draw_manager, 3, stride,
+                                static_cast<u32>(std::size(indices)), &first_base_vertex,
+                                &first_base_index);
+  missing_draw_manager.DiscardPendingGeometryRange();
+  if (missing_draw_manager.HasPendingGeometryRange() || stream.pass_staging() ||
+      s_vertex_manager_smoke_fixture.header.write.load(std::memory_order_acquire) != 1)
+    return FailVertexManagerSmoke(614, "missing first draw published or poisoned a pass");
+
+  // A failed flush may leave only an orphan upload; it must discard producer
+  // scratch, poison the pass, and never fall back to per-draw publication.
+  if (!s_vertex_manager_smoke_fixture.Reset())
+    return FailVertexManagerSmoke(615, "range rollback fixture reset failed");
+  SetWebGpuGeometryPackEnabled(1);
+  SetWebGpuGeometryRangeEnabled(1);
+  VertexManager rollback_manager;
+  VertexManagerTestPeer::Seed(rollback_manager, vertices_a, sizeof(vertices_a), indices,
+                              static_cast<u32>(std::size(indices)), stride);
+  VertexManagerTestPeer::Commit(rollback_manager, 3, stride,
+                                static_cast<u32>(std::size(indices)), &first_base_vertex,
+                                &first_base_index);
+  WebGPUCommandStreamTestPeer::FailConsumer(stream, 0x52414E47u);
+  if (rollback_manager.FlushPendingGeometryRange() ||
+      VertexManagerTestPeer::PendingRangeSize(rollback_manager) != 0 ||
+      stream.PushBeginPass(7, 0, 0, 0, 1, 1, 8))
+    return FailVertexManagerSmoke(616, "failed range flush did not rollback and poison pass");
+
+  // Re-applying the geometry flags is the worker's save-load epoch seam. A
+  // private range from the old state must disappear before a fresh buffer id
+  // can own any post-load placement.
+  if (!s_vertex_manager_smoke_fixture.Reset())
+    return FailVertexManagerSmoke(617, "save-load range fixture reset failed");
+  SetWebGpuGeometryPackEnabled(1);
+  SetWebGpuGeometryRangeEnabled(1);
+  VertexManager load_manager;
+  VertexManagerTestPeer::Seed(load_manager, vertices_a, sizeof(vertices_a), indices,
+                              static_cast<u32>(std::size(indices)), stride);
+  VertexManagerTestPeer::Commit(load_manager, 3, stride,
+                                static_cast<u32>(std::size(indices)), &first_base_vertex,
+                                &first_base_index);
+  const u32 pre_load_id = VertexManagerTestPeer::VertexId(load_manager);
+  const u32 pre_load_write =
+      s_vertex_manager_smoke_fixture.header.write.load(std::memory_order_acquire);
+  if (pre_load_id == 0 || !load_manager.HasPendingGeometryRange())
+    return FailVertexManagerSmoke(618, "save-load range fixture did not retain private bytes");
+
+  SetWebGpuGeometryPackEnabled(1);
+  VertexManagerTestPeer::Seed(load_manager, vertices_b, sizeof(vertices_b), indices,
+                              static_cast<u32>(std::size(indices)), stride);
+  VertexManagerTestPeer::Commit(load_manager, 3, stride,
+                                static_cast<u32>(std::size(indices)), &second_base_vertex,
+                                &second_base_index);
+  if (load_manager.HasPendingGeometryRange() || VertexManagerTestPeer::VertexId(load_manager) != 0 ||
+      s_vertex_manager_smoke_fixture.header.write.load(std::memory_order_acquire) != pre_load_write ||
+      stream.PushBeginPass(7, 0, 0, 0, 1, 1, 8))
+    return FailVertexManagerSmoke(619, "save-load epoch retained or published old placement");
+
+  VertexManagerTestPeer::Seed(load_manager, vertices_b, sizeof(vertices_b), indices,
+                              static_cast<u32>(std::size(indices)), stride);
+  VertexManagerTestPeer::Commit(load_manager, 3, stride,
+                                static_cast<u32>(std::size(indices)), &second_base_vertex,
+                                &second_base_index);
+  if (VertexManagerTestPeer::VertexId(load_manager) == 0 ||
+      VertexManagerTestPeer::VertexId(load_manager) == pre_load_id ||
+      !load_manager.HasPendingGeometryRange() || second_base_vertex != 0)
+    return FailVertexManagerSmoke(620, "post-load placement did not start with fresh identity");
+  load_manager.DiscardPendingGeometryRange();
+
+  SetWebGpuGeometryRangeEnabled(0);
+  SetWebGpuGeometryPackEnabled(0);
+  return 0;
+}
