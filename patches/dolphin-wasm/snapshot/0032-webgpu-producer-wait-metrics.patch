   bool GetUploadArenaMetricsEnabled() const
   {
     return m_upload_metrics_enabled.load(std::memory_order_relaxed);
@@ -404,6 +410,12 @@ private:
   std::atomic<u64> m_upload_late_reject_count{0};
   std::atomic<u64> m_upload_wrap_count{0};
   std::atomic<u64> m_upload_high_water_bytes{0};
+  std::atomic<u64> m_ring_wait_count{0};
+  std::atomic<u64> m_ring_wait_total_us{0};
+  std::atomic<u64> m_ring_wait_max_us{0};
+  std::atomic<u64> m_upload_wait_count{0};
+  std::atomic<u64> m_upload_wait_total_us{0};
+  std::atomic<u64> m_upload_wait_max_us{0};
 
   // BEGIN_PASS..END_PASS records stay private until END_PASS can publish the
   // entire batch. Resource creation/uploads remain immediate so the consumer
