   }
+  u64 GetRingWaitCount() const { return m_ring_wait_count.load(std::memory_order_relaxed); }
+  u64 GetRingWaitTotalUs() const { return m_ring_wait_total_us.load(std::memory_order_relaxed); }
+  u64 GetRingWaitMaxUs() const { return m_ring_wait_max_us.load(std::memory_order_relaxed); }
+  u64 GetUploadWaitCount() const { return m_upload_wait_count.load(std::memory_order_relaxed); }
+  u64 GetUploadWaitTotalUs() const { return m_upload_wait_total_us.load(std::memory_order_relaxed); }
