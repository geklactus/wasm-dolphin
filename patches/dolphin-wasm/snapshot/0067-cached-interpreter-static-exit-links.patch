+    const U32 subopcode = (instruction >> 1) & 1023u;
+    const U32 bo = (instruction >> 21) & 31u;
+    const bool conditional = (bo & 0x14u) != 0x14u;
+    const bool valid_indirect = subopcode == 16 || (subopcode == 528 && (bo & 4u));
+    if (conditional && valid_indirect)
