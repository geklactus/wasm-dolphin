+    for (U32 i = 0; i < descriptor.count && i < descriptor.cells.size(); ++i)
+    {
+      const Cell& cell = descriptor.cells[i];
+      if (cell.pc == pc)
+        return {cell.entry, cell.entry ? Decision::Linked : Decision::Unlinked};
+    }
+    return {nullptr, Decision::NoTarget};
+  }
+
+private:
+  Context m_context;
+  Context* m_previous;
+  bool m_closed = false;
+};
+
+inline void Publish(const void* state, const Descriptor* descriptor)
+{
+  if (active_context && active_context->state == state)
+    active_context->completed = descriptor;
+}
