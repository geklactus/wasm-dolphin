+#include <atomic>
+#include <optional>
+#include <ostream>
+
+namespace StaticExitLinks
+{
+class Stats
+{
+public:
+  static constexpr std::size_t Decisions = static_cast<std::size_t>(Decision::Count);
+  static constexpr std::size_t Initial = Decisions, InitialMiss = Decisions + 1,
+                               Fallback = Decisions + 2, FallbackMiss = Decisions + 3,
+                               Count = Decisions + 4;
+  struct Snapshot
+  {
+    U64 sequence = 0, owner = 0, slices = 0;
+    std::array<U64, Count> counts{};
+  };
+
+  void Init()
+  {
+    ++m_owner;
+    m_slices = 0;
+    m_counts = {};
+    Publish();
+  }
+  void Record(Decision decision) { ++m_counts[static_cast<std::size_t>(decision)]; }
+  void InitialDispatch(bool miss) { ++m_counts[Initial]; m_counts[InitialMiss] += miss; }
+  void FallbackDispatch(bool miss) { ++m_counts[Fallback]; m_counts[FallbackMiss] += miss; }
+  void Slice() { if ((++m_slices & 63u) == 0) Publish(); }
+  void Publish()
+  {
+    // CPU-owned live counters; all shared payload/sequence operations are SC.
+    m_sequence.fetch_add(1);
+    for (std::size_t i = 0; i < Count; ++i)
+      m_published[i].store(m_counts[i]);
+    m_published[Count].store(m_owner);
+    m_published[Count + 1].store(m_slices);
+    m_sequence.fetch_add(1);
+  }
+  std::optional<Snapshot> Read() const
+  {
+    for (int attempt = 0; attempt < 8; ++attempt)
+    {
+      Snapshot snapshot;
+      snapshot.sequence = m_sequence.load();
+      if (snapshot.sequence & 1)
+        continue;
+      for (std::size_t i = 0; i < Count; ++i)
+        snapshot.counts[i] = m_published[i].load();
+      snapshot.owner = m_published[Count].load();
+      snapshot.slices = m_published[Count + 1].load();
+      if (snapshot.sequence == m_sequence.load())
+        return snapshot;
+    }
+    return std::nullopt;
+  }
+  static void Format(std::ostream& out, const Snapshot& snapshot)
+  {
+    static constexpr std::array<const char*, Count> names = {
+        "linked", "noCompletion", "ownerMismatch", "epochMismatch", "featureMismatch",
+        "disabled", "noTarget", "unlinked", "initial", "initialMiss", "fallback", "fallbackMiss"};
+    out << " staticlinks:v1 seq:" << snapshot.sequence << " owner:" << snapshot.owner
+        << " slices:" << snapshot.slices;
+    for (std::size_t i = 0; i < Count; ++i)
+      out << ' ' << names[i] << ':' << snapshot.counts[i];
+    out << " staticlinks:end";
+  }
+
+private:
+  U64 m_owner = 0, m_slices = 0;
+  std::array<U64, Count> m_counts{};
+  std::array<std::atomic<U64>, Count + 2> m_published{};
+  std::atomic<U64> m_sequence{0};
+};
+}  // namespace StaticExitLinks
+#endif
