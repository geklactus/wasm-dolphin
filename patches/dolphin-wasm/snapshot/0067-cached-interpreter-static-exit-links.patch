+bool CachedInterpreter::StaticExitLinksEnabled() const
+{
+  return !SConfig::GetInstance().bJITNoBlockLinking && !IsDebuggingEnabled() &&
+         !IsBranchWatchEnabled() && !IsProfilingEnabled();
