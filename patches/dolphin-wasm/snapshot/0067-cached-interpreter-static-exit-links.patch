+  const U32 opcode = instruction >> 26;
+  const bool call = (instruction & 1u) != 0;
+  const bool absolute = (instruction & 2u) != 0;
+  if (opcode == 18)
+  {
+    const U32 displacement = ((instruction & 0x03fffffcu) ^ 0x02000000u) - 0x02000000u;
+    Add(descriptor, absolute ? displacement : pc + displacement, call);
+    // Existing inline-call helpers may complete at the call site's continuation.
+    if (call)
+      Add(descriptor, pc + 4);
+  }
+  else if (opcode == 16)
+  {
+    const U32 displacement = ((instruction & 0xfffcu) ^ 0x8000u) - 0x8000u;
+    Add(descriptor, absolute ? displacement : pc + displacement, call);
+    // Including an impossible branch fallthrough is harmless: completed-PC
+    // equality remains mandatory, and it also covers an inline bcl completion.
+    Add(descriptor, pc + 4);
+  }
+  else if (opcode == 19)
