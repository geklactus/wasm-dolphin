 namespace WebGPU
 {
+namespace
+{
+std::atomic<bool> s_state_cache_enabled{false};
+std::atomic<u64> s_pipeline_records_suppressed{0};
+std::atomic<u64> s_bind_group_records_suppressed[3]{};
+std::atomic<u64> s_vertex_buffer_records_suppressed{0};
+std::atomic<u64> s_index_buffer_records_suppressed{0};
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE void SetWebGpuStateCacheEnabled(int enabled)
+{
+  // This flag controls only whether already-recorded state is suppressed. It
+  // does not publish any associated data, so acquire/release ordering would
+  // add fences to every draw without providing a synchronization guarantee.
+  s_state_cache_enabled.store(enabled != 0, std::memory_order_relaxed);
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE const char* GetWebGpuStateCacheStats()
+{
+  static std::string stats;
+  std::ostringstream out;
+  out << "wgstate:" << (s_state_cache_enabled.load(std::memory_order_relaxed) ? 1 : 0)
+      << " pipe:" << s_pipeline_records_suppressed.load(std::memory_order_relaxed)
+      << " bg:" << s_bind_group_records_suppressed[0].load(std::memory_order_relaxed) << ","
+      << s_bind_group_records_suppressed[1].load(std::memory_order_relaxed) << ","
+      << s_bind_group_records_suppressed[2].load(std::memory_order_relaxed)
+      << " vb:" << s_vertex_buffer_records_suppressed.load(std::memory_order_relaxed)
+      << " ib:" << s_index_buffer_records_suppressed.load(std::memory_order_relaxed)
+      << " wgdrop:" << GetWebGpuCommandDroppedRecordCount();
+  stats = out.str();
+  return stats.c_str();
+}
 // Day-18: WebGPUGfx is a "SWGfx without a GL window". CreateTexture /
 // CreateFramebuffer return Software's classes (SWTexture / SWFramebuffer)
 // so the Software rasteriser's `static_cast<SWTexture*>(...)` calls work
@@ -750,12 +785,111 @@ void WebGPUGfx::SetScissorRect(const MathUtil::Rectangle<int>& rc)
 static constexpr u32 kUsageUniform = 0x40 | 0x8;
 static constexpr u32 kUsageStorage = 0x80 | 0x8;
 
+void WebGPUGfx::ResetRecordedPassState()
+{
+  m_last_set_pipeline_id = 0;
+  if (!s_state_cache_enabled.load(std::memory_order_relaxed))
+    return;
+  std::fill(std::begin(m_last_bind_group_id), std::end(m_last_bind_group_id), 0);
+  std::fill(std::begin(m_last_bind_group_dynamic_count),
+            std::end(m_last_bind_group_dynamic_count), 0);
+  m_last_vertex_buffer_id = 0;
+  m_last_vertex_buffer_offset = 0;
+  m_last_index_buffer_id = 0;
+  m_last_index_buffer_format = 0;
+  m_last_index_buffer_offset = 0;
+}
+
+bool WebGPUGfx::SetRecordedPipeline(u32 pipeline_id)
+{
+  if (s_state_cache_enabled.load(std::memory_order_relaxed) &&
+      m_last_set_pipeline_id == pipeline_id)
+  {
+    s_pipeline_records_suppressed.fetch_add(1, std::memory_order_relaxed);
+    return true;
+  }
+  if (!m_cmd_stream.PushSetPipeline(pipeline_id))
+    return false;
+  m_last_set_pipeline_id = pipeline_id;
+  return true;
+}
+
+bool WebGPUGfx::SetRecordedBindGroup(u32 slot, u32 bind_group_id, const u32* dynamic_offsets,
+                                     u32 dynamic_offset_count)
+{
+  if (!s_state_cache_enabled.load(std::memory_order_relaxed))
+    return m_cmd_stream.PushSetBindGroup(slot, bind_group_id, dynamic_offsets,
+                                         dynamic_offset_count);
+  if (slot >= 3 || dynamic_offset_count > 4)
+    return m_cmd_stream.PushSetBindGroup(slot, bind_group_id, dynamic_offsets,
+                                         dynamic_offset_count);
+
+  bool unchanged = m_last_bind_group_id[slot] == bind_group_id &&
+                   m_last_bind_group_dynamic_count[slot] == dynamic_offset_count;
+  for (u32 i = 0; unchanged && i < dynamic_offset_count; ++i)
+    unchanged = m_last_bind_group_dynamic_offsets[slot][i] == dynamic_offsets[i];
+  if (unchanged)
+  {
+    s_bind_group_records_suppressed[slot].fetch_add(1, std::memory_order_relaxed);
+    return true;
+  }
+  if (!m_cmd_stream.PushSetBindGroup(slot, bind_group_id, dynamic_offsets, dynamic_offset_count))
+    return false;
+  m_last_bind_group_id[slot] = bind_group_id;
+  m_last_bind_group_dynamic_count[slot] = dynamic_offset_count;
+  for (u32 i = 0; i < dynamic_offset_count; ++i)
+    m_last_bind_group_dynamic_offsets[slot][i] = dynamic_offsets[i];
+  return true;
+}
+
+bool WebGPUGfx::SetRecordedVertexBuffer(u32 slot, u32 buffer_id, u32 offset)
+{
+  if (!s_state_cache_enabled.load(std::memory_order_relaxed))
+    return m_cmd_stream.PushSetVertexBuffer(slot, buffer_id, offset);
+  const bool unchanged = slot == 0 && m_last_vertex_buffer_id == buffer_id &&
+                         m_last_vertex_buffer_offset == offset;
+  if (unchanged)
+  {
+    s_vertex_buffer_records_suppressed.fetch_add(1, std::memory_order_relaxed);
+    return true;
+  }
+  if (!m_cmd_stream.PushSetVertexBuffer(slot, buffer_id, offset))
+    return false;
+  if (slot == 0)
+  {
+    m_last_vertex_buffer_id = buffer_id;
+    m_last_vertex_buffer_offset = offset;
+  }
+  return true;
+}
+
+bool WebGPUGfx::SetRecordedIndexBuffer(u32 buffer_id, u32 format, u32 offset)
+{
+  if (!s_state_cache_enabled.load(std::memory_order_relaxed))
+    return m_cmd_stream.PushSetIndexBuffer(buffer_id, format, offset);
+  const bool unchanged = m_last_index_buffer_id == buffer_id &&
+                         m_last_index_buffer_format == format &&
+                         m_last_index_buffer_offset == offset;
+  if (unchanged)
+  {
+    s_index_buffer_records_suppressed.fetch_add(1, std::memory_order_relaxed);
+    return true;
+  }
+  if (!m_cmd_stream.PushSetIndexBuffer(buffer_id, format, offset))
+    return false;
+  m_last_index_buffer_id = buffer_id;
+  m_last_index_buffer_format = format;
+  m_last_index_buffer_offset = offset;
+  return true;
+}
+
