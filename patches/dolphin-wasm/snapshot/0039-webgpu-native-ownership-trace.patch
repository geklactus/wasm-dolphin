+void WebGPUCommandStream::EnsureOwnershipTrace()
+{
+  if (m_trace_header)
+    return;
+
+  const size_t bytes = sizeof(OwnershipTraceHeader) +
+                       sizeof(OwnershipTraceRecord) * kOwnershipTraceCapacity;
+  void* const block = std::malloc(bytes);
+  if (!block)
+    return;
+  std::memset(block, 0, bytes);
+  m_trace_header = new (block) OwnershipTraceHeader();
+  m_trace_header->write.store(0, std::memory_order_relaxed);
+  m_trace_header->read.store(0, std::memory_order_relaxed);
+  m_trace_header->capacity = kOwnershipTraceCapacity;
+  m_trace_header->dropped.store(0, std::memory_order_relaxed);
+  m_trace_header->epoch.store(0, std::memory_order_relaxed);
+  m_trace_slots = reinterpret_cast<OwnershipTraceRecord*>(
+      static_cast<u8*>(block) + sizeof(OwnershipTraceHeader));
+  m_trace_capacity = kOwnershipTraceCapacity;
+
+}
+
+u32 WebGPUCommandStream::GetOwnershipTracePtr() const
+{
+  return static_cast<u32>(reinterpret_cast<uintptr_t>(m_trace_header));
+}
+
+void WebGPUCommandStream::SetOwnershipTraceEnabled(bool enabled)
+{
+  if (!enabled)
+  {
+    if (m_trace_enabled.load(std::memory_order_acquire))
+      m_trace_stop_requested.store(true, std::memory_order_release);
+    return;
+  }
+  EnsureOwnershipTrace();
+  if (!m_trace_header)
+    return;
+  if (!m_trace_enabled.load(std::memory_order_relaxed))
+  {
+    m_trace_stop_requested.store(false, std::memory_order_relaxed);
+    m_trace_pending_boundaries.fetch_or(kTraceBoundaryInitial, std::memory_order_release);
+    m_trace_enabled.store(true, std::memory_order_release);
+  }
+}
+
+bool WebGPUCommandStream::AcknowledgeOwnershipTraceCapture(u32 capture_id)
+{
+  if (capture_id == 0)
+    return false;
+  u32 expected = capture_id;
+  if (!m_trace_capture_waiting_ack.compare_exchange_strong(
+          expected, 0, std::memory_order_acq_rel, std::memory_order_acquire))
+  {
+    return false;
+  }
+  emscripten_futex_wake(
+      reinterpret_cast<volatile void*>(&m_trace_capture_waiting_ack), INT_MAX);
+  return true;
+}
+
+void WebGPUCommandStream::NotifyOwnershipTraceLoadRequested()
+{
+  if (m_trace_enabled.load(std::memory_order_acquire))
+    m_trace_pending_boundaries.fetch_add(kTraceLoadRequestIncrement, std::memory_order_release);
+}
+
+void WebGPUCommandStream::BeginPendingOwnership()
+{
+  if (!m_trace_enabled.load(std::memory_order_acquire) || m_trace_pending_transaction != 0 ||
+      m_pass_staging || m_trace_active_transaction != 0)
+    return;
+  m_trace_pending_transaction = ++m_trace_transaction_serial;
+  TraceEvent(OwnershipTraceEvent::PendingReserved);
+}
+
+OwnershipAttribution WebGPUCommandStream::CurrentTraceAttribution() const
+{
+  if (m_trace_pending_transaction != 0 && !m_pass_staging)
+    return OwnershipAttribution::Pending;
+  if (m_pass_staging)
+    return OwnershipAttribution::Active;
+  if (m_trace_active_transaction != 0)
+    return OwnershipAttribution::Active;
+  return OwnershipAttribution::Outside;
+}
+
+u32 WebGPUCommandStream::CurrentTraceTransaction() const
+{
+  if (m_trace_pending_transaction != 0 && !m_pass_staging)
+    return m_trace_pending_transaction;
+  if (m_pass_staging)
+    return m_trace_active_transaction;
+  return m_trace_active_transaction;
+}
+
+void WebGPUCommandStream::TraceEventRaw(OwnershipTraceEvent event, u32 op, u32 detail0,
+                                        u32 detail1, u32 auxiliary_extra)
+{
+  const u32 write = m_trace_header->write.load(std::memory_order_relaxed);
+  const u32 read = m_trace_header->read.load(std::memory_order_acquire);
+  if (write - read >= m_trace_capacity)
+  {
+    m_trace_header->dropped.fetch_add(1, std::memory_order_relaxed);
+    return;
+  }
+  OwnershipTraceRecord& record = m_trace_slots[write % m_trace_capacity];
+  record.event = static_cast<u32>(event);
+  record.epoch = m_trace_epoch;
+  record.transaction_id = CurrentTraceTransaction();
+  record.command_serial = m_trace_command_serial;
+  record.opcode = op;
+  record.resource_id = detail0;
+  record.payload_length = detail1;
+  record.auxiliary = static_cast<u32>(CurrentTraceAttribution()) | auxiliary_extra;
+  m_trace_header->write.store(write + 1, std::memory_order_release);
+}
+
+void WebGPUCommandStream::PublishPendingTraceBoundaries()
+{
+  const u32 pending = m_trace_pending_boundaries.exchange(0, std::memory_order_acq_rel);
+  if ((pending & kTraceBoundaryInitial) != 0)
+  {
+    ++m_trace_epoch;
+    m_trace_header->epoch.store(m_trace_epoch, std::memory_order_release);
+    TraceEventRaw(OwnershipTraceEvent::Epoch, 0, kOwnershipTraceVersion, 0);
+  }
+  const u32 load_requests = pending / kTraceLoadRequestIncrement;
+  for (u32 index = 0; index < load_requests; ++index)
+  {
+    if (m_trace_pending_transaction != 0 || m_trace_active_transaction != 0)
+      TraceEventRaw(OwnershipTraceEvent::Abort, 0, 0, 3);
+    m_trace_pending_transaction = 0;
+    m_trace_active_transaction = 0;
+    ++m_trace_epoch;
+    m_trace_header->epoch.store(m_trace_epoch, std::memory_order_release);
+    TraceEventRaw(OwnershipTraceEvent::LoadRequested, 0, index + 1, load_requests);
+  }
+}
+
+void WebGPUCommandStream::TraceEvent(OwnershipTraceEvent event, u32 op, u32 detail0, u32 detail1)
+{
+  if (!m_trace_enabled.load(std::memory_order_acquire))
+    return;
+  PublishPendingTraceBoundaries();
+  TraceEventRaw(event, op, detail0, detail1);
+}
+
+void WebGPUCommandStream::TraceCommand(const CmdRecord& rec)
+{
+  if (!m_trace_enabled.load(std::memory_order_acquire))
+    return;
+  ++m_trace_command_serial;
+  const u32 op = rec.op;
+  const bool staged = m_pass_staging && op >= static_cast<u32>(CmdOp::BeginPass) &&
+                      op <= static_cast<u32>(CmdOp::EndPass);
+  const u32 publication = staged ? 1u : (m_pass_staging ? 2u : 0u);
+  u32 resource_id = 0;
+  u32 payload_length = 0;
+  switch (static_cast<CmdOp>(op))
+  {
+  case CmdOp::CreateShader:
+  case CmdOp::CreatePipelineCfg:
+  case CmdOp::CreateBindGroup:
+    resource_id = rec.arg.u[0];
+    payload_length = rec.arg.u[2];
+    break;
+  case CmdOp::UploadBuffer:
+    resource_id = rec.arg.u[0];
+    payload_length = rec.arg.u[3];
+    break;
+  case CmdOp::UploadTexture:
+    resource_id = rec.arg.u[0];
+    payload_length = rec.arg.u[2] * rec.arg.u[4];
+    break;
+  case CmdOp::CreatePipeline:
+  case CmdOp::CreateBuffer:
+  case CmdOp::CreateTexture:
+  case CmdOp::CreateSampler:
+  case CmdOp::BeginPass:
+  case CmdOp::SetPipeline:
+  case CmdOp::SetIndexBuffer:
+    resource_id = rec.arg.u[0];
+    break;
+  case CmdOp::SetBindGroup:
+  case CmdOp::SetVertexBuffer:
+    resource_id = rec.arg.u[1];
+    break;
+  case CmdOp::Destroy:
+    resource_id = rec.arg.u[1];
+    break;
+  case CmdOp::BlitTexture:
+    resource_id = rec.arg.u[0];
+    break;
+  default:
+    break;
+  }
+  PublishPendingTraceBoundaries();
+  TraceEventRaw(OwnershipTraceEvent::Command, op, resource_id, payload_length,
+                publication << 8);
+}
+
+void WebGPUCommandStream::TraceConsumerFailure()
+{
+  if (!m_trace_enabled.load(std::memory_order_acquire) || !m_header)
+    return;
+  PublishPendingTraceBoundaries();
+  const u32 error = m_header->consumer_error.load(std::memory_order_acquire);
+  if (m_trace_last_consumer_error == error && m_trace_last_consumer_error_epoch == m_trace_epoch)
+    return;
+  m_trace_last_consumer_error = error;
+  m_trace_last_consumer_error_epoch = m_trace_epoch;
+  TraceEvent(OwnershipTraceEvent::ConsumerFailure, 0, error,
+             m_header->consumer_state.load(std::memory_order_relaxed));
+}
+
+void WebGPUCommandStream::FinishOwnershipTraceCapture()
+{
+  if (!m_trace_enabled.load(std::memory_order_acquire) ||
+      !m_trace_stop_requested.exchange(false, std::memory_order_acq_rel))
+  {
+    return;
+  }
+  PublishPendingTraceBoundaries();
+  u32 capture_id = ++m_trace_capture_serial;
+  if (capture_id == 0)
+    capture_id = ++m_trace_capture_serial;
+  while (true)
+  {
+    const u32 write = m_trace_header->write.load(std::memory_order_relaxed);
+    const u32 read = m_trace_header->read.load(std::memory_order_acquire);
+    if (write - read < m_trace_capacity)
+      break;
+    emscripten_futex_wait(
+        reinterpret_cast<volatile void*>(&m_trace_header->read), read, 4.0);
+  }
+  const u32 cutoff = m_header->write.load(std::memory_order_acquire);
+  TraceEventRaw(OwnershipTraceEvent::CaptureEnd,
+                static_cast<u32>(CmdOp::SubmitPresent), cutoff, capture_id);
+  m_trace_capture_waiting_ack.store(capture_id, std::memory_order_release);
+  m_trace_enabled.store(false, std::memory_order_release);
+}
+
+void WebGPUCommandStream::WaitForOwnershipTraceCaptureAck()
+{
+  while (true)
+  {
+    const u32 capture_id = m_trace_capture_waiting_ack.load(std::memory_order_acquire);
+    if (capture_id == 0)
+      return;
+    emscripten_futex_wait(
+        reinterpret_cast<volatile void*>(&m_trace_capture_waiting_ack), capture_id, 4.0);
+  }
+}
