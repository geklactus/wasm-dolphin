+        static_cast<u32>(ti0.format.Value()), linear,
+        static_cast<u32>(tm0.mipmap_filter.Value()), static_cast<u32>(baseMip), mipLinear,
+        static_cast<u32>(tm0.wrap_s.Value()), static_cast<u32>(tm0.wrap_t.Value()),
+        texUnit.texImage1.cache_manually_managed.Value(),
+        static_cast<u32>(texUnit.texTlut.tlut_format.Value()), IsPowerOfTwo(width),
+        IsPowerOfTwo(height), decode_work, static_cast<u32>(tm0.min_filter.Value()),
+        static_cast<u32>(tm0.mag_filter.Value()));
+    DolphinWeb::RasterProfile::RecordTextureCase(case_key, decode_work, profile_scope.Epoch());
+  }
+#endif
+
   if (mipLinear)
   {
     u8 sampledTex[4];
