 namespace TextureSampler
 {
+static constexpr bool IsPowerOfTwo(u32 value)
+{
+  return value != 0 && (value & (value - 1)) == 0;
+}
+
 static inline void WrapCoord(int* coordp, WrapMode wrap_mode, int image_size)
 {
   int coord = *coordp;
@@ -99,6 +104,25 @@ void Sample(s32 s, s32 t, s32 lod, bool linear, u8 texmap, u8* sample)
       baseMip++;
   }
 
+#ifdef __EMSCRIPTEN__
+  if (profile_scope.ShouldRecordCase())
+  {
+    const TexImage0& ti0 = texUnit.texImage0;
+    const u32 width = ti0.width.Value() + 1;
+    const u32 height = ti0.height.Value() + 1;
+    const u32 decode_work = (linear ? 4u : 1u) * (mipLinear ? 2u : 1u);
