   };
-  u32 AllocUboSlice(const void* data, u32 size);
+  u32 AllocUboSlice(const void* data, u32 size, BufferUploadRole role);
   u32 AcquireUboSlice(UboClass ubo_class, const void* data, u32 size);
   bool RefreshUboCacheState();
   bool IsUboSliceLive(u64 publication_serial) const;
