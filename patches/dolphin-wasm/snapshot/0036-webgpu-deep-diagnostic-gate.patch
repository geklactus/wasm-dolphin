diff --git a/Source/Core/VideoCommon/WasmWgpuDeepDiagnostics.h b/Source/Core/VideoCommon/WasmWgpuDeepDiagnostics.h
new file mode 100644
index 0000000000..efe3921a81
--- /dev/null
+++ b/Source/Core/VideoCommon/WasmWgpuDeepDiagnostics.h
@@ -0,0 +1,21 @@
+// Copyright 2026 Dolphin Emulator Project (wasm-dolphin fork)
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <atomic>
+
+namespace DolphinWeb::WgpuDeepDiagnostics
+{
+inline std::atomic<bool> s_enabled{false};
+
+inline void SetEnabled(bool enabled)
+{
+  s_enabled.store(enabled, std::memory_order_relaxed);
+}
+
+inline bool IsEnabled()
+{
+  return s_enabled.load(std::memory_order_relaxed);
+}
+}  // namespace DolphinWeb::WgpuDeepDiagnostics
