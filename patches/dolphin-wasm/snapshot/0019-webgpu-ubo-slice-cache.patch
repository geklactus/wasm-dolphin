+bool WebGPUGfx::RefreshUboCacheState()
+{
+  const bool enabled = s_ubo_cache_enabled.load(std::memory_order_relaxed);
+  if (!enabled)
+  {
+    if (m_ubo_cache_active)
+      InvalidateUboSlices();
+    m_ubo_cache_active = false;
+    return false;
+  }
+
+  const u64 epoch = s_ubo_cache_epoch.load(std::memory_order_acquire);
+  if (!m_ubo_cache_active || m_ubo_cache_epoch != epoch)
+  {
+    InvalidateUboSlices();
+    m_ubo_cache_epoch = epoch;
+    m_ubo_cache_active = true;
+  }
+  return true;
+}
+
+bool WebGPUGfx::IsUboSliceLive(u64 publication_serial) const
+{
+  if (publication_serial == 0 || publication_serial > m_ubo_publication_serial)
+    return false;
+  const u64 age = m_ubo_publication_serial - publication_serial;
+  return age < static_cast<u64>(kUboRingSliceCount - kUboReuseSafetySlots);
+}
+
+void WebGPUGfx::ResetUboSliceCache()
+{
+  for (auto& cache : m_ubo_slice_cache)
+  {
+    for (UboSliceCacheEntry& entry : cache)
+      entry = {};
+  }
+  m_ubo_cache_mru_serial = 0;
+}
+
+void WebGPUGfx::ExpireUboClass(UboClass ubo_class)
+{
+  const u32 class_index = static_cast<u32>(ubo_class);
+  for (UboSliceCacheEntry& entry : m_ubo_slice_cache[class_index])
+    entry = {};
+  if (s_ubo_cache_metrics_enabled.load(std::memory_order_relaxed))
+    s_ubo_cache_expired[class_index].fetch_add(1, std::memory_order_relaxed);
+}
+
+void WebGPUGfx::InvalidateUboSlices()
+{
+  ResetUboSliceCache();
+  m_ps_off = kUboOffNone;
+  m_vs_off = kUboOffNone;
+  m_gs_off = kUboOffNone;
+  m_util_off = kUboOffNone;
+  m_ps_publication_serial = 0;
+  m_vs_publication_serial = 0;
+  m_gs_publication_serial = 0;
+  m_last_ubo_slice_serial = 0;
+  m_ps_shadow_valid = false;
+  m_vs_shadow_valid = false;
+  m_gs_shadow_valid = false;
+  m_util_uniform_mode = false;
+}
+
+void WebGPUGfx::StoreUboSlice(UboClass ubo_class, const void* data, u32 size, u32 offset,
+                              u64 publication_serial)
+{
+  auto& cache = m_ubo_slice_cache[static_cast<u32>(ubo_class)];
+  UboSliceCacheEntry* replacement = nullptr;
+  for (UboSliceCacheEntry& entry : cache)
+  {
+    if (!entry.valid)
+    {
+      replacement = &entry;
+      break;
+    }
+    if (!replacement || entry.mru_serial < replacement->mru_serial)
+      replacement = &entry;
+  }
+  if (!replacement)
+    return;
+
+  std::memcpy(replacement->bytes.data(), data, size);
+  replacement->size = size;
+  replacement->offset = offset;
+  replacement->publication_serial = publication_serial;
+  replacement->mru_serial = ++m_ubo_cache_mru_serial;
+  replacement->valid = true;
+}
+
+u32 WebGPUGfx::AcquireUboSlice(UboClass ubo_class, const void* data, u32 size)
+{
+  const u32 class_index = static_cast<u32>(ubo_class);
+  const bool record_metrics = s_ubo_cache_metrics_enabled.load(std::memory_order_relaxed);
+  if (record_metrics)
+    s_ubo_cache_lookups[class_index].fetch_add(1, std::memory_order_relaxed);
+  for (UboSliceCacheEntry& entry : m_ubo_slice_cache[class_index])
+  {
+    if (!entry.valid)
+      continue;
+    if (!IsUboSliceLive(entry.publication_serial))
+    {
+      entry = {};
+      if (record_metrics)
+        s_ubo_cache_expired[class_index].fetch_add(1, std::memory_order_relaxed);
+      continue;
+    }
+    // Size and a full byte comparison are the correctness predicate. A hash
+    // may be added only as a shortlist; it must never replace this memcmp.
+    if (entry.size != size || std::memcmp(entry.bytes.data(), data, size) != 0)
+      continue;
+
+    entry.mru_serial = ++m_ubo_cache_mru_serial;
+    m_last_ubo_slice_serial = entry.publication_serial;
+    if (record_metrics)
+    {
+      s_ubo_cache_hits[class_index].fetch_add(1, std::memory_order_relaxed);
+      s_ubo_upload_calls_suppressed[class_index].fetch_add(1, std::memory_order_relaxed);
+      s_ubo_upload_bytes_suppressed[class_index].fetch_add(size, std::memory_order_relaxed);
+    }
+    return entry.offset;
+  }
+
+  const u32 offset = AllocUboSlice(data, size);
+  if (offset != kUboOffNone)
+    StoreUboSlice(ubo_class, data, size, offset, m_last_ubo_slice_serial);
+  return offset;
+}
+
 u32 WebGPUGfx::AllocUboSlice(const void* data, u32 size)
 {
   if (m_ubo_ring == 0 || size == 0 || size > kUboSliceStride)
+  {
+    if (m_ubo_cache_active)
+      InvalidateUboSlices();
     return kUboOffNone;
+  }
   // Bump-allocate a fixed-stride slice (stride is 256-aligned so the
   // offset is a valid WebGPU dynamic offset). Wrap at ring end; the
   // ring spans many frames of distinct constant sets so the consumer
@@ -1339,10 +1555,19 @@ u32 WebGPUGfx::AllocUboSlice(const void* data, u32 size)
   const u32 off = m_ubo_ring_off;
   const u32 src = m_cmd_stream.UploadAlloc(data, size, 16);
   if (src == 0)
+  {
+    if (m_ubo_cache_active)
+      InvalidateUboSlices();
     return kUboOffNone;
+  }
   if (!m_cmd_stream.PushUploadBuffer(m_ubo_ring, off, src, size))
+  {
+    if (m_ubo_cache_active)
+      InvalidateUboSlices();
     return kUboOffNone;
+  }
   m_ubo_ring_off = off + kUboSliceStride;
+  m_last_ubo_slice_serial = ++m_ubo_publication_serial;
   return off;
 }
 
@@ -1350,6 +1575,11 @@ void WebGPUGfx::UploadUtilityUniforms(const void* data, u32 size)
 {
   if (data == nullptr || size == 0)
