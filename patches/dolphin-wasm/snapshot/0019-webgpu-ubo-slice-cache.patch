+                     u64 publication_serial);
 
   bool m_pass_open = false;
   u32 m_fb_color_id = 0;  // 0 = backbuffer
@@ -221,13 +236,40 @@ private:
   // of distinct constant sets (consumer is ≤2 frames behind).
   static constexpr u32 kUboSliceStride = 8192;
   static constexpr u32 kUboRingSize = 32u * 1024u * 1024u;
+  static constexpr u32 kUboRingSliceCount = kUboRingSize / kUboSliceStride;
+  // A lookup may be followed by allocations for the other two constant
+  // classes before the draw. Expire four slots early so a later allocation
+  // in the same PrepareDrawResources call cannot wrap onto a reused slice.
+  static constexpr u32 kUboReuseSafetySlots = 4;
   static constexpr u32 kUboOffNone = 0xFFFFFFFFu;  // force first alloc
+  static_assert(kUboRingSliceCount > kUboReuseSafetySlots);
+
+  struct UboSliceCacheEntry
+  {
+    std::array<u8, kUboSliceStride> bytes{};
+    u32 size = 0;
+    u32 offset = kUboOffNone;
+    u64 publication_serial = 0;
+    u64 mru_serial = 0;
+    bool valid = false;
+  };
+
   u32 m_ubo_ring = 0;
   u32 m_ubo_ring_off = 0;
+  u64 m_ubo_publication_serial = 0;
+  u64 m_last_ubo_slice_serial = 0;
+  u64 m_ubo_cache_epoch = 0;
+  u64 m_ubo_cache_mru_serial = 0;
+  bool m_ubo_cache_active = false;
+  std::array<std::array<UboSliceCacheEntry, 2>, static_cast<u32>(UboClass::Count)>
+      m_ubo_slice_cache{};
