diff --git a/Source/Core/Core/WasmTimingProfile.h b/Source/Core/Core/WasmTimingProfile.h
new file mode 100644
index 0000000000..13c8b377f6
--- /dev/null
+++ b/Source/Core/Core/WasmTimingProfile.h
@@ -0,0 +1,240 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#ifdef __EMSCRIPTEN__
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <limits>
+#include <string_view>
+
+namespace DolphinWeb::WasmTimingProfile
+{
+using Clock = std::chrono::steady_clock;
+
+enum class EventKind : std::uint32_t
+{
+  None,
+  VICallback,
+  FinishReadDVDThread,
+  OtherCoreTiming,
+};
+
+struct WorstSlice
+{
+  std::uint32_t total_us = 0;
+  std::uint32_t advance_us = 0;
+  std::uint32_t execute_us = 0;
+  std::uint32_t compile_us = 0;
+  std::uint32_t throttle_wait_us = 0;
+  std::uint32_t dvd_wait_us = 0;
+  std::uint32_t video_work_us = 0;
+  EventKind event = EventKind::None;
+};
+
+struct CurrentSlice
+{
+  bool active = false;
+  std::uint32_t compile_us = 0;
+  std::uint32_t throttle_wait_us = 0;
+  std::uint32_t dvd_wait_us = 0;
+  std::uint32_t video_work_us = 0;
+  std::uint32_t longest_event_us = 0;
+  EventKind longest_event = EventKind::None;
+};
+
+struct WorstSliceStorage
+{
+  std::atomic<std::uint32_t> sequence{0};
+  std::atomic<std::uint32_t> total_us{0};
+  std::atomic<std::uint32_t> advance_us{0};
+  std::atomic<std::uint32_t> execute_us{0};
+  std::atomic<std::uint32_t> compile_us{0};
+  std::atomic<std::uint32_t> throttle_wait_us{0};
+  std::atomic<std::uint32_t> dvd_wait_us{0};
+  std::atomic<std::uint32_t> video_work_us{0};
+  std::atomic<std::uint32_t> event{static_cast<std::uint32_t>(EventKind::None)};
+};
+
+inline std::atomic<bool> s_enabled{false};
+inline thread_local CurrentSlice s_current_slice{};
+inline WorstSliceStorage s_worst_slice{};
+
+inline std::uint32_t SaturatingAdd(std::uint32_t left, std::uint32_t right)
+{
+  constexpr std::uint32_t MAX = std::numeric_limits<std::uint32_t>::max();
+  return right > MAX - left ? MAX : left + right;
+}
+
+inline std::uint32_t ElapsedMicros(Clock::time_point begin, Clock::time_point end)
+{
+  const auto elapsed = std::chrono::duration_cast<std::chrono::microseconds>(end - begin).count();
+  if (elapsed <= 0)
+    return 0;
+  return static_cast<std::uint32_t>(
+      std::min<std::int64_t>(elapsed, std::numeric_limits<std::uint32_t>::max()));
+}
+
+inline void ResetWorstSlice()
+{
+  s_worst_slice.sequence.fetch_add(1, std::memory_order_acq_rel);
+  s_worst_slice.total_us.store(0, std::memory_order_relaxed);
+  s_worst_slice.advance_us.store(0, std::memory_order_relaxed);
+  s_worst_slice.execute_us.store(0, std::memory_order_relaxed);
+  s_worst_slice.compile_us.store(0, std::memory_order_relaxed);
+  s_worst_slice.throttle_wait_us.store(0, std::memory_order_relaxed);
+  s_worst_slice.dvd_wait_us.store(0, std::memory_order_relaxed);
+  s_worst_slice.video_work_us.store(0, std::memory_order_relaxed);
+  s_worst_slice.event.store(static_cast<std::uint32_t>(EventKind::None), std::memory_order_relaxed);
+  s_worst_slice.sequence.fetch_add(1, std::memory_order_release);
+}
+
+inline void SetEnabled(bool enabled)
+{
+  const bool was_enabled = s_enabled.exchange(enabled, std::memory_order_acq_rel);
+  s_current_slice = {};
+  if (enabled && !was_enabled)
+    ResetWorstSlice();
+}
+
+inline bool BeginSlice()
+{
+  s_current_slice = {};
+  s_current_slice.active = s_enabled.load(std::memory_order_acquire);
+  return s_current_slice.active;
+}
+
+inline bool IsSliceActive()
+{
+  return s_current_slice.active;
+}
+
+inline EventKind ClassifyEvent(std::string_view name)
+{
+  if (name == "VICallback")
+    return EventKind::VICallback;
+  if (name == "FinishReadDVDThread")
+    return EventKind::FinishReadDVDThread;
+  return name.empty() ? EventKind::None : EventKind::OtherCoreTiming;
+}
+
+inline const char* EventName(EventKind event)
+{
+  switch (event)
+  {
+  case EventKind::VICallback:
+    return "VICallback";
+  case EventKind::FinishReadDVDThread:
+    return "FinishReadDVDThread";
+  case EventKind::OtherCoreTiming:
+    return "other-core-timing";
+  case EventKind::None:
+  default:
+    return "none";
+  }
+}
+
+inline std::uint32_t CurrentAttributedWaitUs();
+
+inline void RecordCoreTimingEvent(std::string_view name, std::uint32_t elapsed_us,
+                                  std::uint32_t wait_us_at_start)
+{
+  if (!s_current_slice.active)
+    return;
+  const EventKind event = ClassifyEvent(name);
+  if (event == EventKind::VICallback)
+  {
+    const std::uint32_t wait_us_at_end = CurrentAttributedWaitUs();
+    const std::uint32_t nested_wait_us =
+        wait_us_at_end >= wait_us_at_start ? wait_us_at_end - wait_us_at_start : 0;
+    const std::uint32_t exclusive_us =
+        elapsed_us > nested_wait_us ? elapsed_us - nested_wait_us : 0;
+    s_current_slice.video_work_us = SaturatingAdd(s_current_slice.video_work_us, exclusive_us);
+  }
+  if (elapsed_us > s_current_slice.longest_event_us)
+  {
+    s_current_slice.longest_event_us = elapsed_us;
+    s_current_slice.longest_event = event;
+  }
+}
+
+inline void RecordCompileUs(std::uint32_t elapsed_us)
+{
+  if (s_current_slice.active)
+    s_current_slice.compile_us = SaturatingAdd(s_current_slice.compile_us, elapsed_us);
+}
+
+inline void RecordThrottleWaitUs(std::uint32_t elapsed_us)
+{
+  if (s_current_slice.active)
+  {
+    s_current_slice.throttle_wait_us = SaturatingAdd(s_current_slice.throttle_wait_us, elapsed_us);
+  }
+}
+
+inline void RecordDvdWaitUs(std::uint32_t elapsed_us)
+{
+  if (s_current_slice.active)
+    s_current_slice.dvd_wait_us = SaturatingAdd(s_current_slice.dvd_wait_us, elapsed_us);
+}
+
+inline std::uint32_t CurrentAttributedWaitUs()
+{
+  return SaturatingAdd(s_current_slice.throttle_wait_us, s_current_slice.dvd_wait_us);
+}
+
+inline void FinishSlice(std::uint32_t total_us, std::uint32_t advance_us, std::uint32_t execute_us)
+{
+  if (!s_current_slice.active)
+    return;
+  s_current_slice.active = false;
+
+  if (total_us <= s_worst_slice.total_us.load(std::memory_order_relaxed))
+    return;
+
+  s_worst_slice.sequence.fetch_add(1, std::memory_order_acq_rel);
+  s_worst_slice.total_us.store(total_us, std::memory_order_relaxed);
+  s_worst_slice.advance_us.store(std::min(advance_us, total_us), std::memory_order_relaxed);
+  s_worst_slice.execute_us.store(std::min(execute_us, total_us), std::memory_order_relaxed);
+  s_worst_slice.compile_us.store(std::min(s_current_slice.compile_us, execute_us),
+                                 std::memory_order_relaxed);
+  s_worst_slice.throttle_wait_us.store(std::min(s_current_slice.throttle_wait_us, advance_us),
+                                       std::memory_order_relaxed);
+  s_worst_slice.dvd_wait_us.store(std::min(s_current_slice.dvd_wait_us, advance_us),
+                                  std::memory_order_relaxed);
+  s_worst_slice.video_work_us.store(std::min(s_current_slice.video_work_us, advance_us),
+                                    std::memory_order_relaxed);
+  s_worst_slice.event.store(static_cast<std::uint32_t>(s_current_slice.longest_event),
+                            std::memory_order_relaxed);
+  s_worst_slice.sequence.fetch_add(1, std::memory_order_release);
+}
+
+inline WorstSlice CaptureWorstSlice()
+{
+  WorstSlice snapshot;
+  std::uint32_t before = 0;
+  std::uint32_t after = 0;
+  do
+  {
+    before = s_worst_slice.sequence.load(std::memory_order_acquire);
+    if ((before & 1U) != 0)
+      continue;
+    snapshot.total_us = s_worst_slice.total_us.load(std::memory_order_relaxed);
+    snapshot.advance_us = s_worst_slice.advance_us.load(std::memory_order_relaxed);
+    snapshot.execute_us = s_worst_slice.execute_us.load(std::memory_order_relaxed);
+    snapshot.compile_us = s_worst_slice.compile_us.load(std::memory_order_relaxed);
+    snapshot.throttle_wait_us = s_worst_slice.throttle_wait_us.load(std::memory_order_relaxed);
+    snapshot.dvd_wait_us = s_worst_slice.dvd_wait_us.load(std::memory_order_relaxed);
+    snapshot.video_work_us = s_worst_slice.video_work_us.load(std::memory_order_relaxed);
+    snapshot.event = static_cast<EventKind>(s_worst_slice.event.load(std::memory_order_relaxed));
+    after = s_worst_slice.sequence.load(std::memory_order_acquire);
+  } while (before != after || (after & 1U) != 0);
+  return snapshot;
+}
+}  // namespace DolphinWeb::WasmTimingProfile
