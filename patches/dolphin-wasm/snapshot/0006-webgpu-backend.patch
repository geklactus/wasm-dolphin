--- /dev/null
+++ b/Source/Core/VideoBackends/WebGPU/WebGPUCommandStream.h
@@ -0,0 +1,274 @@
+// Copyright 2026 Dolphin Emulator Project (wasm-dolphin fork)
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <atomic>
+#include <cstddef>
+
+#include "Common/CommonTypes.h"
+
+// Day-27: cross-thread command ring for the WebGPU *hardware*
+// renderer.
+//
+// Day-26 proved the wall: Dolphin's video runs on a pthread that
+// never turns its JS event loop, so it can't acquire/own a WebGPU
+// device; and WebGPU objects can't cross workers. The discio worker
+// CAN (it's event-loop-driven and already owns renderGpu.device).
+//
+// So WebGPUGfx (on the pthread) becomes a *recorder*: each render
+// operation is appended as a fixed-size command record into a ring
+// buffer that lives in the wasm linear memory (a SharedArrayBuffer
+// under USE_PTHREADS — visible to the discio worker with no copy).
+// The discio worker drains the ring every presentation tick and
+// *replays* each command against its real device. This is a
+// remote/deferred WebGPU backend; the ring is its wire protocol.
+//
+// Day-33 (Phase A): the opcode set is widened from the Day-27..32
+// transport/shader/pipeline proof to the full AbstractGfx command
+// set (buffers, textures, samplers, bind groups, real pipeline
+// config, state + draw). Opcodes 0-4 are the proven Day-27..32 set
+// and keep their exact wire form so the baseline never regresses;
+// 5+ are the Phase-A additions (see DESIGN-webgpu-command-protocol).
+
+namespace WebGPU
+{
+enum class CmdOp : u32
+{
+  Nop = 0,
+  // Clear the canvas to (r,g,b,a) via a wgpuRenderPass and present.
+  // Day-27's proof-of-transport opcode.
+  Clear = 1,
+  // Day-28 resource opcode. Build a GPUShaderModule on the consumer
+  // from WGSL text in a shared-heap blob.
+  //   arg.u[0] = shader id (producer-assigned)
+  //   arg.u[1] = blob ptr (wasm-heap offset to UTF-8 WGSL)
+  //   arg.u[2] = blob length (bytes)
+  //   arg.u[3] = stage (0=vertex,1=geometry,2=pixel,3=compute) — debug
+  CreateShader = 2,
+  // Day-32: build a GPURenderPipeline from a real Dolphin VS+FS pair
+  // (both bridge-translated; proves shader-interface compatibility).
+  //   arg.u[0] = pipeline id
+  //   arg.u[1] = vertex-shader bridge id (from CreateShader)
+  //   arg.u[2] = fragment-shader bridge id (from CreateShader)
+  //   arg.u[3] = topology (0=triangle-list)
+  CreatePipeline = 3,
+  // Per-frame proof draw: begin a render pass on the canvas, set the
+  // pipeline, draw N vertices (no vertex buffer — screen-quad VS uses
+  // @builtin(vertex_index)), end + present.
+  //   arg.u[0] = pipeline id   arg.u[1] = vertex count
+  DrawTest = 4,
+
+  // ---- Phase A (Day-33): full AbstractGfx opcode set --------------
+  // Resource creation / upload.
+  //   CreateBuffer:   u0=id u1=size u2=usageFlags
+  CreateBuffer = 5,
+  //   UploadBuffer:   u0=id u1=dstOffset u2=srcHeapPtr u3=len
+  //   (srcHeapPtr is an absolute wasm-heap offset into the upload
+  //   arena; the consumer queue.writeBuffers straight from there.)
+  UploadBuffer = 6,
+  //   CreateTexture:  u0=id u1=w u2=h u3=wgpuFormat u4=usageFlags
+  CreateTexture = 7,
+  //   UploadTexture:  u0=id u1=srcHeapPtr u2=bytesPerRow u3=w u4=h
+  //                   u5=mipLevel u6=layer
+  UploadTexture = 8,
+  //   CreatePipelineCfg: u0=id u1=blobPtr u2=blobLen
+  //   (blob = serialized AbstractPipelineConfig incl vs/fs bridge ids;
+  //   see WebGPUPipelineConfig serialization + DESIGN doc mapping.)
+  CreatePipelineCfg = 9,
+  //   CreateSampler:  u0=id u1=packed (filter/wrap/compare bits)
+  CreateSampler = 10,
+  //   CreateBindGroup: u0=id u1=blobPtr u2=blobLen u3=layoutKey
+  //   (blob = N×{binding,kind,resId,offset,size}; kind: 0=buffer,
+  //   1=texture, 2=sampler.)
+  CreateBindGroup = 11,
+
+  // State + draw (per render pass).
+  //   BeginPass:  u0=fbId(0=backbuffer) f1..4 clearColor u5=loadOp
+  //               u6=depthFbId
+  BeginPass = 12,
+  //   SetPipeline:     u0=pipelineId (config-built)
+  SetPipeline = 13,
+  //   SetBindGroup:    u0=slot u1=bgId u2=nDynOff u3..u6=dynOffsets
+  //   (per-draw uniform-ring byte offsets, one per dynamic-offset
+  //   layout entry in binding order; group0 has 4, groups 1/2 have 0)
+  SetBindGroup = 14,
+  //   SetVertexBuffer: u0=slot u1=bufId u2=offset
+  SetVertexBuffer = 15,
+  //   SetIndexBuffer:  u0=bufId u1=fmt(0=u16,1=u32) u2=offset
+  SetIndexBuffer = 16,
+  //   SetViewport:     f0=x f1=y f2=w f3=h f4=minDepth f5=maxDepth
+  SetViewport = 17,
+  //   SetScissor:      u0=x u1=y u2=w u3=h
+  SetScissor = 18,
+  //   Draw:            u0=vtxCount u1=instCount u2=firstVtx
+  Draw = 19,
+  //   DrawIndexed:     u0=idxCount u1=instCount u2=firstIdx u3=baseVtx
+  DrawIndexed = 20,
+  EndPass = 21,
+  SubmitPresent = 22,
+  //   Destroy:         u0=classTag u1=id
+  Destroy = 23,
+  // GPU texture-to-texture blit (EFB→XFB resolve + EFB copies). The
+  // CPU-stub CopyRectangleFromTexture/ResolveFromTexture now also emit
+  // this so the rendered EFB actually reaches the GPU XFB. Rects are
+  // 16-bit-packed (EFB/XFB dims fit); layers/levels 8-bit-packed.
+  //   u0=srcId u1=dstId
+  //   u2=(srcX|srcY<<16) u3=(srcW|srcH<<16)
+  //   u4=(dstX|dstY<<16) u5=(dstW|dstH<<16)
+  //   u6=(srcLayer | srcLevel<<8 | dstLayer<<16 | dstLevel<<24)
+  // Consumer: same-format+same-size → copyTextureToTexture; otherwise
+  // (e.g. rgba8unorm EFB → bgra8unorm XFB) a sampled render-pass blit.
+  BlitTexture = 24,
+};
+
+// Fixed-size record: opcode + 7 payload words (mix of f32/u32 read
+// per-opcode). 32 bytes keeps slots cache-friendly and the ring
+// index arithmetic trivial. Variable-length payloads (shader source,
+// pipeline config, bind-group lists) reference separate shared-heap
+// blocks by pointer+len; bulk per-frame data (vertex/uniform/texture
+// bytes) goes through the upload arena referenced by absolute heap
+// offset.
+struct CmdRecord
+{
+  u32 op;
+  union
+  {
+    float f[7];
+    u32 u[7];
+  } arg;
+};
+static_assert(sizeof(CmdRecord) == 32, "CmdRecord must stay 32 bytes");
+
+// Ring header lives at the front of the shared block, followed by
+// `capacity` CmdRecord slots. write/read are monotonically
+// increasing record counts (not wrapped) so a single relaxed-atomic
+// compare tells the consumer how many records are pending; slot =
+// index % capacity. Single-producer (video pthread) /
+// single-consumer (discio worker) — no CAS needed, just release on
+// publish / acquire on read.
+struct CmdRingHeader
+{
+  std::atomic<u32> write;  // next slot the producer will fill
+  std::atomic<u32> read;   // next slot the consumer will drain
+  u32 capacity;            // number of CmdRecord slots
+  u32 reserved;
+};
+// The JS consumer maps write@i32[0], read@i32[1], capacity@i32[2]
+// over this header — it MUST stay 16 bytes (4×u32; std::atomic<u32>
+// is 4 bytes / 4-aligned on wasm32). Guardrail flagged by the Day-27
+// transport audit.
+static_assert(sizeof(CmdRingHeader) == 16,
+              "CmdRingHeader must stay 16 bytes (JS bridge assumes fixed layout)");
+
+class WebGPUCommandStream
+{
+public:
+  // Allocates the shared block (header + capacity slots) AND the
+  // per-frame upload arena in wasm memory, and hands their pointers
+  // to the discio worker via postMessage (same zero-copy pattern as
+  // Day-19 ShowImage). Idempotent.
+  void EnsureRing();
+
+  // Append one record. Drops the record (returns false) if the ring
+  // is full — the consumer is behind; better to skip a frame's
+  // commands than block the video pthread.
+  bool Push(const CmdRecord& rec);
+
+  // Convenience for the Day-27 opcode.
+  void PushClear(float r, float g, float b, float a);
+
+  // Day-28: allocate a shared-heap blob, copy `data` into it, and
+  // emit CreateShader(id, blobPtr, blobLen, stage). The blob is
+  // owned by the stream (persistent — shaders are bounded & cached
+  // by Dolphin). Returns the producer-assigned shader id, or 0 if
+  // the ring isn't ready / allocation failed (0 = "no shader").
+  u32 PushCreateShader(const char* wgsl, size_t len, u32 stage);
+
+  // Day-32: emit CreatePipeline(id, vsShaderId, fsShaderId, topology)
+  // — the proven shader-pair test pipeline. Returns the id (0 if ring
+  // not ready).
+  u32 PushCreatePipeline(u32 vs_shader_id, u32 fs_shader_id, u32 topology);
+  // Day-32: emit DrawTest(pipelineId, vertexCount) — the per-frame
+  // render pass + draw + present test path.
+  void PushDrawTest(u32 pipeline_id, u32 vertex_count);
+
+  // ---- Phase A producer API --------------------------------------
+  // Bump-allocate `len` bytes into the per-frame upload arena, copy
+  // `data` in, and return the ABSOLUTE wasm-heap offset of the copy
+  // (what the consumer reads from for UploadBuffer/UploadTexture), or
+  // 0 on failure. Offsets recycle (the arena wraps) — sized so the
+  // consumer (1-2 frames behind) never reads a recycled region.
+  u32 UploadAlloc(const void* data, size_t len, u32 align = 4);
+
+  u32 PushCreateBuffer(u32 size, u32 usage_flags);
+  void PushUploadBuffer(u32 id, u32 dst_offset, u32 src_heap_ptr, u32 len);
+  u32 PushCreateTexture(u32 w, u32 h, u32 wgpu_format, u32 usage_flags, u32 layers = 1);
+  void PushUploadTexture(u32 id, u32 src_heap_ptr, u32 bytes_per_row, u32 w, u32 h,
+                         u32 mip_level = 0, u32 layer = 0);
+  // Serialized AbstractPipelineConfig blob (owned/persistent, like
+  // shaders — Dolphin caches pipelines). Returns the pipeline id.
+  u32 PushCreatePipelineCfg(const void* blob, size_t len);
+  u32 PushCreateSampler(u32 packed);
+  // `blob` = N×{u32 binding,u32 kind,u32 resId,u32 offset,u32 size}.
+  u32 PushCreateBindGroup(const void* blob, size_t len, u32 layout_key);
+
+  void PushBeginPass(u32 fb_id, float r, float g, float b, float a, u32 load_op,
+                     u32 depth_fb_id);
+  void PushSetPipeline(u32 pipeline_id);
+  // dyn_offsets: per-draw uniform-ring byte offsets, one per
+  // dynamic-offset layout entry (group0: 4; groups 1/2: 0). Each must
+  // be a multiple of minUniformBufferOffsetAlignment (256).
+  void PushSetBindGroup(u32 slot, u32 bg_id, const u32* dyn_offsets = nullptr,
+                        u32 num_dyn = 0);
+  void PushSetVertexBuffer(u32 slot, u32 buf_id, u32 offset);
+  void PushSetIndexBuffer(u32 buf_id, u32 fmt, u32 offset);
+  void PushSetViewport(float x, float y, float w, float h, float min_d, float max_d);
+  void PushSetScissor(u32 x, u32 y, u32 w, u32 h);
+  void PushDraw(u32 vtx_count, u32 inst_count, u32 first_vtx);
+  void PushDrawIndexed(u32 idx_count, u32 inst_count, u32 first_idx, u32 base_vtx);
+  void PushEndPass();
+  void PushSubmitPresent();
+  void PushDestroy(u32 class_tag, u32 id);
+  // GPU texture blit. Coords/dims are clamped to 16 bits (EFB/XFB
+  // never exceed that); layers/levels to 8 bits. No-op if either id
+  // is 0 (CPU-only fallback path still ran the memcpy).
+  void PushBlitTexture(u32 src_id, u32 dst_id, u32 src_x, u32 src_y, u32 src_w,
+                       u32 src_h, u32 dst_x, u32 dst_y, u32 dst_w, u32 dst_h,
+                       u32 src_layer, u32 src_level, u32 dst_layer, u32 dst_level);
+
+  bool ready() const { return m_header != nullptr; }
+
+  // Producer-assigned id for the next resource of any class (opcode
+  // implies class on the consumer). Exposed so callers that need an
+  // id before the Push (e.g. forward-referencing it in a blob) can
+  // reserve one.
+  u32 AllocId() { return m_next_id++; }
+
+private:
+  CmdRingHeader* m_header = nullptr;
+  CmdRecord* m_slots = nullptr;
+  u32 m_capacity = 0;
+
+  // Per-frame upload arena (DESIGN §payload). Bump-allocated, wraps.
+  u8* m_upload_base = nullptr;
+  u32 m_upload_size = 0;
+  u32 m_upload_head = 0;
+
+  // Producer-assigned resource ids. One space is fine — opcode
+  // implies class on the consumer. Starts at 1 (0 = none/sentinel).
+  u32 m_next_id = 1;
+
+  // Telemetry: records dropped because the ring was full. Any drop
+  // permanently loses a resource/state op (missBg/missPipe). Logged
+  // (first + periodic) so the probe can confirm the ring is sized.
+  u32 m_dropped = 0;
+};
+
+// Day-33 A3: the command stream is produced into by BOTH WebGPUGfx
+// (AbstractGfx state/draw overrides) and WebGPU::VertexManager
+// (buffers + draws). Single-producer holds — everything runs on the
+// one video pthread. A process-global accessor avoids threading a
+// reference through VideoCommon. EnsureRing() is idempotent.
+WebGPUCommandStream& GetCommandStream();
+}  // namespace WebGPU
