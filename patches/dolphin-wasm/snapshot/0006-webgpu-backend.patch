diff --git a/Externals/glslang/CMakeLists.txt b/Externals/glslang/CMakeLists.txt
index 23e9aa6b11..d7fbb5b7bd 100644
--- a/Externals/glslang/CMakeLists.txt
+++ b/Externals/glslang/CMakeLists.txt
@@ -1,9 +1,22 @@
 set(ENABLE_PCH OFF)
-set(BUILD_EXTERNAL OFF)
+# Day-30 (wasm-dolphin): ON so glslang processes its External/ dir
+# (CMakeLists:275) and add_subdirectory(spirv-tools), creating the
+# SPIRV-Tools-opt target ENABLE_OPT needs. googletest is
+# IS_DIRECTORY-gated (not vendored → skipped); spirv-tools is
+# ENABLE_OPT+dir-gated with SPIRV_SKIP_TESTS ON.
+set(BUILD_EXTERNAL ON)
 set(SKIP_GLSLANG_INSTALL ON)
 set(ENABLE_GLSLANG_BINARIES OFF)
 set(ENABLE_HLSL OFF)
-set(ENABLE_OPT OFF)
+# Day-30 (wasm-dolphin): ON so glslang compiles in its SPIRV-Tools
+# optimizer bridge (SpvTools.cpp). SPIRV-Tools + SPIRV-Headers are
+# vendored at glslang's known-good commits under
+# glslang/External/spirv-tools{,/external/spirv-headers}. With this
+# on, Spirv.cpp's `disableOptimizer=false` path actually runs
+# spirv-opt, canonicalising glslang's raw SPIR-V into the subset
+# Naga's spv frontend accepts (raw glslang output was tripping Naga's
+# "invalid id %N" on ~80% of Dolphin's pixel shaders — Day-30 finding).
+set(ENABLE_OPT ON)
 set(ENABLE_CTEST OFF)
 set(ENABLE_EXCEPTIONS OFF)
 add_subdirectory(glslang)
diff --git a/Source/Core/VideoBackends/CMakeLists.txt b/Source/Core/VideoBackends/CMakeLists.txt
index 9d20d6d2b5..adcf4e0433 100644
