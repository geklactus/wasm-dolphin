diff --git a/Source/Core/VideoBackends/WebGPU/VideoBackend.cpp b/Source/Core/VideoBackends/WebGPU/VideoBackend.cpp
new file mode 100644
index 0000000000..358640fae0
--- /dev/null
+++ b/Source/Core/VideoBackends/WebGPU/VideoBackend.cpp
@@ -0,0 +1,332 @@
+// Copyright 2026 Dolphin Emulator Project (wasm-dolphin fork)
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// WebGPU Backend Documentation
+//
+// Day-14 scaffold. Identical to Null at the moment — Initialize()
+// reports success, all factory methods return placeholder objects.
+// Real WebGPU API integration (device acquisition, swapchain
+// configuration, command encoder + render pass machinery, WGSL shader
+// pipelines, EFB readback via copyTextureToBuffer) arrives in Day 15+.
+//
+// The goal of Day 14 is plumbing: prove that we can register a new
+// VideoBackend, plumb `?video=webgpu` through the URL → core-host →
+// worker → C++ chain, and have the wasm build accept the new files.
+// Once that compiles and selects, every subsequent day adds one real
+// WebGPU API call without breaking the build or the existing backends.
+
+#include "VideoBackends/WebGPU/VideoBackend.h"
+
+#include "Common/Common.h"
+#include "Common/Logging/Log.h"
+
+#include "VideoBackends/WebGPU/WebGPUGfx.h"
+#include "VideoBackends/WebGPU/WebGPUShaderTranslator.h"
+#include "VideoBackends/WebGPU/WebGPUVertexManager.h"
+
+#include "VideoCommon/AbstractShader.h"
+
+// Day-18: reuse Software's CPU rasteriser. Clipper / Rasterizer /
+// SWVertexLoader / SWBoundingBox / SWEFBInterface + SW's TextureCache
+// run the FIFO commands and populate SWTextures that VideoCommon then
+// hands to our `WebGPUGfx::ShowImage` for wgpu-side blit.
+#include "VideoBackends/Software/Clipper.h"
+#include "VideoBackends/Software/Rasterizer.h"
+#include "VideoBackends/Software/SWBoundingBox.h"
+#include "VideoBackends/Software/SWEfbInterface.h"
+#include "VideoBackends/Software/SWVertexLoader.h"
+#include "VideoBackends/Software/TextureCache.h"
+
+#include "VideoCommon/PerfQueryBase.h"
+#include "VideoCommon/VideoCommon.h"
+#include "VideoCommon/VideoConfig.h"
+
+// Day-15 (wasm-dolphin): pull in the emdawnwebgpu C bindings. Linked
+// via `--use-port=emdawnwebgpu` in the dolphin_web_core CMakeLists.
+// This is the first place WebGPU symbols enter the binary.
+#include <webgpu/webgpu.h>
+#include <emscripten/emscripten.h>
+
+namespace WebGPU
+{
+void VideoBackend::InitBackendInfo(const WindowSystemInfo& /* wsi */)
+{
+  // Day-30 CUTOVER. api_type drives BOTH FramebufferShaderGen/
+  // PixelShaderGen/VertexShaderGen completeness AND VideoCommon's
+  // vertex-transform conventions (Day-24/26 finding). At
+  // APIType::Nothing shadergen emits declaration-less stubs (the
+  // Software renderer never compiles GLSL) so only ~6/64 shaders
+  // translate. Flipping to APIType::Vulkan makes shadergen emit
+  // complete Vulkan-dialect GLSL — matching the Day-22 SHADER_HEADER
+  // (API_VULKAN, set/binding layout) — so the real Dolphin shader set
+  // can go through glslang→Naga→WGSL. This necessarily breaks the
+  // Software-hybrid geometry (its transform wants api_type=Nothing —
+  // the reverse of the Day-21 fix); that's expected — this is the
+  // cutover to the real GPU path, Software delegation is retired in
+  // the same arc. Step 1 measures translation coverage of the REAL
+  // shader set; the rest of the cutover follows.
+  g_backend_info.api_type = APIType::Vulkan;
+  g_backend_info.MaxTextureSize = 16384;
+  g_backend_info.bUsesLowerLeftOrigin = false;
+  g_backend_info.bSupports3DVision = false;
+  // Day-30: WebGPU/WGSL has no dual-source blend. With this true,
+  // Dolphin emits a second blend output at `location=0, index=1`;
+  // Naga's validator then rejects the fragment entry point
+  // ("Multiple bindings at location 0 are present"). False ⇒ Dolphin
+  // uses the single-output path. (Was copied true from Software's
+  // InitBackendInfo; wrong for WebGPU.)
+  g_backend_info.bSupportsDualSourceBlend = false;
+  g_backend_info.bSupportsEarlyZ = true;
+  g_backend_info.bSupportsPrimitiveRestart = false;
+  g_backend_info.bSupportsMultithreading = false;
+  g_backend_info.bSupportsComputeShaders = false;
+  g_backend_info.bSupportsGPUTextureDecoding = false;
+  g_backend_info.bSupportsST3CTextures = false;
+  g_backend_info.bSupportsBPTCTextures = false;
+  // Day-33 §12 ROOT CAUSE: false (Software clone) forces
+  // TextureCacheBase down copy_to_ram for EVERY EFB copy
+  // (TextureCacheBase.cpp:2194-2197) — encode EFB→GameCube RAM via the
+  // texture encoder + WebGPUStagingTexture, both no-op stubs here. So
+  // the game's EFB-copy/XFB textures are read back from stale RAM as
+  // the uniform green tex#69 (sampled at b1 nearly everywhere) →
+  // green normal-present AND textured-black geometry. WebGPU has real
+  // GPU render-to-texture (variant pipelines, WebGPUFramebuffer,
+  // RENDER_ATTACHMENT), so copy_to_vram is the correct path: EFB is
+  // scaled/rendered straight into the cache GPUTexture and sampled
+  // from there — no RAM round-trip, no staging stub. true.
+  g_backend_info.bSupportsCopyToVram = true;
+  g_backend_info.bSupportsLargePoints = false;
+  g_backend_info.bSupportsDepthReadback = false;
+  g_backend_info.bSupportsPartialDepthCopies = false;
+  g_backend_info.bSupportsFramebufferFetch = false;
+  g_backend_info.bSupportsBackgroundCompiling = false;
+  g_backend_info.bSupportsLogicOp = true;
+  g_backend_info.bSupportsShaderBinaries = false;
+  g_backend_info.bSupportsPipelineCacheData = false;
+  g_backend_info.bSupportsBBox = true;
+  g_backend_info.bSupportsCoarseDerivatives = false;
+  g_backend_info.bSupportsTextureQueryLevels = false;
+  g_backend_info.bSupportsLodBiasInSampler = false;
+  g_backend_info.bSupportsSettingObjectNames = false;
+  g_backend_info.bSupportsPartialMultisampleResolve = true;
+  g_backend_info.bSupportsDynamicVertexLoader = false;
+  // Day-30: the Vulkan dialect emits `#version 450`, which has a
+  // native bitfieldExtract. Leaving this false makes ShaderGenCommon
+  // emit Dolphin's polyfill, which then collides with glslang's
+  // builtin ("overloaded functions must have the same parameter
+  // precision qualifiers"), failing every TEV pixel shader. True ⇒
+  // skip the polyfill, use the native op.
+  g_backend_info.bSupportsBitfield = true;
+
+  // Day-33 first-light ROOT CAUSE: WebGPU NDC depth is [0,1] (like
+  // Vulkan/D3D), not OpenGL's [-1,1]. With this false (never set →
+  // default false, as in the Software clone), ShaderGenCommon sets
+  // host_config.backend_clip_control=false, so VertexShaderGen emits
+  // the GL depth remap `o.pos.z = o.pos.z * 2.0 - o.pos.w;`
+  // (VertexShaderGen.cpp:824-829). That maps the projected [0,w] depth
+  // to [-w,w]; in WebGPU every fragment with ndc_z<0 (the near half of
+  // ALL geometry) is then outside the clip volume and discarded —
+  // exactly the probe-confirmed "EFB renders uniform-black, no
+  // geometry, everything else verified correct". WebGPU supports
+  // clip-control depth, so set it true → the GL remap is skipped and
+  // the native [0,1] projected depth is used.
+  g_backend_info.bSupportsClipControl = true;
+
+  // §28b: WebGPU clip space is Vulkan-like (NDC z in [0,1], NOT GL
+  // [-1,1]); with bSupportsClipControl the VS emits native [0,1]
+  // projected depth. The default bSupportsReversedDepthRange=false
+  // makes PixelShaderGen's fog derive zCoord as
+  // int((1.0 - rawpos.z) * 2^24) — the GL-paired branch — which
+  // INVERTS our [0,1] window depth, saturating the fog factor so the
+  // (untextured, GX-fogged) difficulty-select backdrop collapses to
+  // the black fog colour (probe §28b: backdrop FS = lerp(tev,
+  // fogcolor=0, factor); factor pinned full). WebGPU can reverse the
+  // depth range like Vulkan, so report it true → fog uses the
+  // matching int(rawpos.z * 2^24) branch and VertexShaderManager's
+  // depth-range path stays consistent with the [0,1] convention.
+  // §28ar: REVERTED to true. §28aq proved false eliminates the
+  // mixed-pass flicker ([s28aq-MISMATCH] 120→0) BUT regressed the
+  // whole render to BLACK — this flag is COUPLED to the §28b/c fog
+  // path: false makes PixelShaderGen's fog use the (1.0-rawpos.z)
+  // branch which saturates the fog factor → every draw fogged to the
+  // black fog colour (the exact §28b regression true was set to fix).
+  // So flicker (mixed-pass depth) and rendering (fog branch) are
+  // entangled through this single flag. Keeping true (renders +
+  // §28ao-smooth, flickers) until the fog branch is fixed
+  // INDEPENDENTLY for a non-reverse convention (PixelShaderGen,
+  // api_type==Vulkan-gated) — then false becomes viable and the
+  // flicker goes structurally. Documented in SESSION §28ar.
+  // §28as RESULT: false STILL renders dark + hangs the core even
+  // with the fog zCoord decoupled (§28as PixelShaderGen) — so the
+  // §28b fog branch was necessary but NOT the only thing coupled to
+  // this flag (a second depth/projection-convention breakage remains
+  // under flag=false, beyond fog). Reverted to true = the verified
+  // §28ao state (renders + §28ao-smooth, flickers on mixed passes).
+  // The §28as PixelShaderGen decouple is a NO-OP with flag=true
+  // (both branches pick rawpos.z) so it is kept, ready for the
+  // eventual full flag=false untangle. Flicker root remains proven
+  // (§28aq mixed-pass); fixing it needs the second coupling found.
+  // 28at: coupling-(2) FOUND & decoupled. The [s28at-vp] JS
+  // measurement falsified the tracer's BPFunctions "zero-width"
+  // theory (flag=false yields a UNIFORM normal-Z [0,1] viewport, not
+  // a collapse). The real 2nd coupling = the C++ depth-INVERSION
+  // cluster (EFBInterface peek/poke, AbstractGfx + FramebufferManager
+  // EFB clear, Texture[Conversion|ConverterShaderGen] EFB-copy,
+  // UberShaderPixel fast-depth) all flipping 1-x at flag=false while
+  // the VS geometry depth is NOT flag-keyed -> convention split =
+  // dark; the blocking EFBInterface peek inversion = the frame-781
+  // hang. All now api_type==Vulkan-gated (NO-OP at flag=true) so the
+  // WebGPU path keeps ONE non-inverted [0,1] convention regardless of
+  // the flag. flag=false's only net WebGPU effect is then the
+  // BPFunctions viewport remap -> uniform normal-Z [0,1] -> no mixed
+  // reverse/normal pass -> the 28aq flicker is gone STRUCTURALLY.
+  // Consumer paired: REVZ_COMPARE_FLIP=false + constant
+  // depthClearValue=1.0 (normal-Z far + unflipped GX compare).
+  // Documented SESSION 28at.
+  g_backend_info.bSupportsReversedDepthRange = false;
+
+  g_backend_info.Adapters.clear();
+  g_backend_info.AAModes = {1};
+}
+
+bool VideoBackend::Initialize(const WindowSystemInfo& /* wsi */)
+{
+  // Day-15 smoke: prove the emdawnwebgpu binding is actually linked into
+  // the binary. wgpuCreateInstance is the cheapest call we can make — it
+  // hits the Dawn shim, returns a handle, and we release it immediately.
+  // If this links and runs, we know the rest of the C API is available.
+  WGPUInstance instance = wgpuCreateInstance(nullptr);
+  INFO_LOG_FMT(VIDEO, "WebGPU smoke: wgpuCreateInstance = {}",
+               static_cast<void*>(instance));
+  if (instance)
+    wgpuInstanceRelease(instance);
+
+  // Day-26 device acquisition. The Day-15 preinitialized path is a
+  // dead end here: that device belongs to the discio-worker thread,
+  // but this code runs on a Dolphin video pthread (proven Day-25,
+  // discioWorker=0). WebGPU objects don't cross Emscripten pthreads,
+  // so we request a *fresh* headless device on THIS pthread instead
+  // (pthreads are dedicated Web Workers — they have navigator.gpu).
+  //
+  // It's async and Initialize is sync, so we only kick the request
+  // here; WebGPUGfx::EnsureDevice() polls per-frame and imports the
+  // device into this thread's emdawnwebgpu table once it resolves.
+  // Until then the Software path renders (Day-18 fallback). The kick
+  // is idempotent (guarded by self.__dolphinPthreadWgpuStatus).
+  EM_ASM({
+    if (typeof self === 'undefined') return;
+    if (self.__dolphinPthreadWgpuStatus) return;  // once per thread
+    if (!self.navigator || !self.navigator.gpu) {
+      self.__dolphinPthreadWgpuStatus = 'unavailable';
+      if (typeof console !== 'undefined')
+        console.log('[webgpu-dev] navigator.gpu unavailable on video pthread');
+      return;
+    }
+    self.__dolphinPthreadWgpuStatus = 'pending';
+    (async function() {
+      try {
+        const adapter = await self.navigator.gpu.requestAdapter(
+            { powerPreference: 'high-performance' });
+        if (!adapter) { self.__dolphinPthreadWgpuStatus = 'no-adapter'; return; }
+        const device = await adapter.requestDevice();
+        self.__dolphinPthreadWgpuDevice = device;
+        self.__dolphinPthreadWgpuStatus = 'ready';
+        if (typeof console !== 'undefined')
+          console.log('[webgpu-dev] pthread device acquired');
+        device.lost.then(function(info) {
+          self.__dolphinPthreadWgpuStatus = 'lost';
+          self.__dolphinPthreadWgpuDevice = null;
+          if (typeof console !== 'undefined')
+            console.log('[webgpu-dev] pthread device lost: ' +
+                        (info && (info.message || info.reason)));
+        });
+      } catch (e) {
+        self.__dolphinPthreadWgpuStatus = 'error';
+        if (typeof console !== 'undefined')
+          console.log('[webgpu-dev] pthread device error: ' + (e && e.message));
+      }
+    })();
+  });
+
+  // Day-22 shader-translation smoke: prove glslang GLSL→SPIR-V works
+  // inside the wasm build (it's linked for the Vulkan backend; this
+  // confirms it's reachable + functional from the WebGPU backend's
+  // future hardware path). A trivial-but-representative fragment
+  // shader: Vulkan-dialect GLSL with explicit location, the shape
+  // Dolphin's PixelShaderGen emits. SpirvToWgsl is still a stub, so
+  // GlslToWgsl returns nullopt — expected until the Naga transpiler
+  // sub-project lands. This is the seam everything else builds on.
+  {
+    // Header-less, like real Dolphin shader-gen output — GlslToSpirv
+    // now prepends Dolphin's SHADER_HEADER itself (a second #version
+    // would make glslang error).
+    constexpr std::string_view kSmokeFs =
+        "FRAGMENT_OUTPUT_LOCATION(0) out vec4 ocol0;\n"
+        "void main() { ocol0 = float4(1.0, 0.0, 0.0, 1.0); }\n";
+    auto spirv = GlslToSpirv(ShaderStage::Pixel, kSmokeFs);
+    const int spirv_words = spirv ? static_cast<int>(spirv->code.size()) : -1;
+    // Day-23: exercise the full GLSL→SPIR-V→WGSL pipeline. wgsl_len
+    // > 0 proves the linked Naga staticlib produced valid WGSL inside
+    // the wasm build — the back half of the hardware-renderer shader
+    // path is now live.
+    auto wgsl = GlslToWgsl(ShaderStage::Pixel, kSmokeFs);
+    const int wgsl_len = wgsl ? static_cast<int>(wgsl->size()) : -1;
+    INFO_LOG_FMT(VIDEO, "WebGPU shader-xlat smoke: SPIR-V words={} WGSL bytes={}",
+                 spirv_words, wgsl_len);
+    // Dolphin's LogManager isn't wired to the browser console in this
+    // wasm build, so mirror through EM_ASM console.log (captured as a
+    // [worker:...] line by the validator). -1 == that stage failed.
+    EM_ASM(
+        {
+          if (typeof console !== 'undefined')
+            console.log('[webgpu-shader-xlat] GLSL->SPIR-V words=' + $0 +
+                        ' SPIR-V->WGSL bytes=' + $1);
+        },
+        spirv_words, wgsl_len);
+  }
+
+  // Day-18: spin up Software's CPU rasteriser. Clipper / Rasterizer
+  // are global Init() singletons; SWVertexLoader / SWBoundingBox /
+  // SWEFBInterface / SW::TextureCache are the per-backend pieces
+  // that hook into VideoCommon's FIFO + EFB pipeline. We pair them
+  // with our WebGPUGfx, which gives VideoCommon back SWTextures from
+  // CreateTexture so the rasteriser's static_casts stay valid.
+  // Clipper / Rasterizer / SWVertexLoader live at global scope; the
+  // rest of SW's classes live inside namespace SW. Matches how
+  // VideoSoftware::Initialize names them.
+  // Day-25 thread probe: is VideoBackend::Initialize running on the
+  // discio-worker thread (the WebGPU device owner)? Determines whether
+  // the real GPU pipeline can issue wgpu calls here directly or needs
+  // a thread bridge.
+  EM_ASM({
+    if (typeof console !== 'undefined')
+      console.log('[webgpu-thread] Initialize on discioWorker=' +
+                  ((typeof self !== 'undefined' && self.__dolphinDiscioWorker) ? 1 : 0));
+  });
+
+  // Day-33 Phase C: retire the Software-rasteriser delegation. Use the
+  // hardware InitializeShared overload — VideoCommon supplies the
+  // generic HardwareEFBInterface + TextureCacheBase (both drive the
+  // real AbstractGfx path we now record as opcodes). The real
+  // VertexManager replaces SWVertexLoader; Clipper/Rasterizer/
+  // SWEFBInterface/SW::TextureCache are gone. SWBoundingBox stays as
+  // the bbox impl for now (self-contained CPU bbox, not the
+  // rasteriser; a GPU bbox is a post-cutover refinement).
+  return InitializeShared(std::make_unique<WebGPUGfx>(),
+                          std::make_unique<WebGPU::VertexManager>(),
+                          std::make_unique<PerfQueryBase>(),
+                          std::make_unique<SW::SWBoundingBox>());
+}
+
+void VideoBackend::Shutdown()
+{
+  ShutdownShared();
+}
+
+std::string VideoBackend::GetDisplayName() const
+{
+  // i18n note: scaffold name. Day-15 will likely change this to
+  // "WebGPU (Experimental)" once it actually renders.
+  return _trans("WebGPU");
+}
+}  // namespace WebGPU
