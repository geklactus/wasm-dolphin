 namespace detail
 {
 struct DecodedCmprBlock
@@ -115,8 +184,55 @@ constexpr u32 Channel(u32 color, unsigned int channel)
 {
   return (color >> (channel * 8)) & 0xff;
 }
+
+inline u8 DecodeI4Texel(std::span<const u8> source, int s, int t, int image_width_minus_1)
+{
+  const u16 s_block = static_cast<u16>(s >> 3);
+  const u16 t_block = static_cast<u16>(t >> 3);
+  const u16 width_blocks = static_cast<u16>((image_width_minus_1 >> 3) + 1);
+  const u32 base = (t_block * width_blocks + s_block) << 5;
+  const u16 block_s = static_cast<u16>(s & 7);
+  const u16 block_t = static_cast<u16>(t & 7);
+  const u32 block_offset = (block_t << 3) + block_s;
+  const int shift = (block_offset & 1) != 0 ? 0 : 4;
+  const u32 offset = base + (block_offset >> 1);
+  const u8 nibble = (Common::SafeSpanRead<u8>(source, offset) >> shift) & 0xf;
+  return Convert4To8(nibble);
+}
 }  // namespace detail
 
+// The caller supplies the four coordinates after the canonical WrapCoord calls in SampleMip.
+// I4 produces identical RGBA channels, so one scalar interpolation is bit-identical to the four
+// generic SetTexel/AddTexel channel accumulators. SafeSpanRead retains zero-fill semantics for
+// truncated source spans.
+inline void SampleI4LinearCanonical(std::span<const u8> source, int image_width_minus_1,
+                                    int image_s, int image_t, int image_s_plus_1,
+                                    int image_t_plus_1, u32 fract_s, u32 fract_t, u8* sample)
+{
+  const u32 texels[4] = {
+      detail::DecodeI4Texel(source, image_s, image_t, image_width_minus_1),
+      detail::DecodeI4Texel(source, image_s_plus_1, image_t, image_width_minus_1),
+      detail::DecodeI4Texel(source, image_s, image_t_plus_1, image_width_minus_1),
+      detail::DecodeI4Texel(source, image_s_plus_1, image_t_plus_1, image_width_minus_1),
+  };
+  const u32 weights[4] = {
+      (128 - fract_s) * (128 - fract_t),
+      fract_s * (128 - fract_t),
+      (128 - fract_s) * fract_t,
+      fract_s * fract_t,
+  };
+
+  u32 value = texels[0] * weights[0];
+  value += texels[1] * weights[1];
+  value += texels[2] * weights[2];
+  value += texels[3] * weights[3];
+  const u8 result = static_cast<u8>(value >> 14);
+  sample[0] = result;
+  sample[1] = result;
+  sample[2] = result;
+  sample[3] = result;
+}
+
