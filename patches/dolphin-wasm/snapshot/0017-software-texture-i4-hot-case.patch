diff --git a/Source/Core/VideoBackends/Software/TextureSamplerHotCase.h b/Source/Core/VideoBackends/Software/TextureSamplerHotCase.h
index 1d5e66c695..2a8056daf9 100644
--- a/Source/Core/VideoBackends/Software/TextureSamplerHotCase.h
+++ b/Source/Core/VideoBackends/Software/TextureSamplerHotCase.h
@@ -11,10 +11,79 @@
 #include "Common/SpanUtils.h"
 #include "Common/Swap.h"
 #include "VideoCommon/LookUpTables.h"
+#include "VideoCommon/TextureDecoder.h"
 #include "VideoCommon/TextureDecoder_Util.h"
 
 namespace TextureSampler::HotCase
 {
+// Raw register fields are retained here so this predicate can be tested without constructing global
+// BP state. The numeric encodings are the GX encodings used by PackTextureCaseKey.
+struct I4LinearCaseState
+{
+  TextureFormat texture_format;
+  bool linear;
+  s32 mip;
+  u32 mipmap_filter;
+  u32 wrap_s;
+  u32 wrap_t;
+  bool manually_managed;
+  TLUTFormat tlut_format;
+  bool width_power_of_two;
+  bool height_power_of_two;
+  u32 min_filter;
+  u32 mag_filter;
+};
+
+inline constexpr std::array<u64, 6> MEASURED_I4_LINEAR_CASE_KEYS = {
+    0x05340010, 0x05300010, 0x0d34a010, 0x0d000010, 0x0d280010, 0x0d240010,
+};
+
+// Exact union of the six I4 cases measured in three fixed-save Melee runs. Do not broaden this
+// predicate based only on format equivalence: wrap, dimensions, filtering, TLUT register state, and
+// memory ownership are all deliberately part of the dispatch contract.
+constexpr bool IsMeasuredI4LinearCase(const I4LinearCaseState& state)
+{
+  constexpr u32 mip_none = 0;
+  constexpr u32 wrap_clamp = 0;
+  constexpr u32 wrap_repeat = 1;
+  constexpr u32 filter_near = 0;
+  constexpr u32 filter_linear = 1;
+
+  if (state.texture_format != TextureFormat::I4 || !state.linear || state.mip != 0 ||
+      state.mipmap_filter != mip_none || state.manually_managed ||
+      state.min_filter != filter_linear)
+  {
+    return false;
+  }
+
+  if (state.mag_filter == filter_near)
+  {
+    return state.wrap_s == wrap_clamp && state.wrap_t == wrap_clamp &&
+           state.width_power_of_two && state.height_power_of_two &&
+           (state.tlut_format == TLUTFormat::IA8 || state.tlut_format == TLUTFormat::RGB565);
+  }
+
+  if (state.mag_filter != filter_linear)
+    return false;
+
+  if (state.wrap_s == wrap_repeat && state.wrap_t == wrap_repeat)
+  {
+    return state.width_power_of_two && state.height_power_of_two &&
+           state.tlut_format == TLUTFormat::RGB565;
+  }
+
+  if (state.wrap_s != wrap_clamp || state.wrap_t != wrap_clamp ||
+      state.width_power_of_two)
+  {
+    return false;
+  }
+
+  if (!state.height_power_of_two)
+    return state.tlut_format == TLUTFormat::IA8;
+
+  return state.tlut_format == TLUTFormat::RGB565 || state.tlut_format == TLUTFormat::RGB5A3;
+}
