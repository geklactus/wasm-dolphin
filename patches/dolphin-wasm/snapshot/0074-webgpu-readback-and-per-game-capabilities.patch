diff --git a/Source/Core/VideoBackends/WebGPU/WebGPUReadback.cpp b/Source/Core/VideoBackends/WebGPU/WebGPUReadback.cpp
new file mode 100644
index 0000000000..cd5e8e63b6
--- /dev/null
+++ b/Source/Core/VideoBackends/WebGPU/WebGPUReadback.cpp
@@ -0,0 +1,78 @@
+// Copyright 2026 Dolphin Emulator Project (wasm-dolphin fork)
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "VideoBackends/WebGPU/WebGPUReadback.h"
+
+#include <chrono>
+
+#include <emscripten/emscripten.h>
+#include <emscripten/threading.h>
+
+namespace WebGPU
+{
+namespace
+{
+WebGPUReadbackStats s_stats;
+u32 s_serial = 0;
+
+// The consumer drains the ring on its presentation tick and replay pump, maps
+// the readback buffer asynchronously, and copies on the next event-loop turn.
+// One frame of latency is normal; a quarter of a second means the consumer is
+// not coming (device lost, page hidden, replay fatal), and the video thread
+// must not hang the core on it.
+constexpr double kReadbackTimeoutMs = 250.0;
+constexpr double kFutexSliceMs = 2.0;
+}  // namespace
+
+u32 ArmReadback(WebGPUReadbackFlag& flag)
+{
+  u32 serial = ++s_serial;
+  if (serial == 0)
+    serial = ++s_serial;
+  flag.expected.store(serial, std::memory_order_release);
+  s_stats.requested++;
+  return serial;
+}
+
+bool WaitForReadback(WebGPUReadbackFlag& flag, u32 serial)
+{
+  const auto start = std::chrono::steady_clock::now();
+  while (true)
+  {
+    const u32 done = flag.done.load(std::memory_order_acquire);
+    if (done == serial)
+    {
+      s_stats.completed++;
+      return true;
+    }
+    const double waited_ms =
+        std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start)
+            .count();
+    if (waited_ms >= kReadbackTimeoutMs)
+      break;
+    emscripten_futex_wait(reinterpret_cast<volatile void*>(&flag.done), done, kFutexSliceMs);
+  }
+  s_stats.timed_out++;
+  if (s_stats.timed_out <= 4 || (s_stats.timed_out % 256) == 0)
+  {
+    EM_ASM(
+        {
+          if (typeof console !== 'undefined')
+            console.log('[webgpu-readback] timed out waiting for the consumer (serial ' + $0 +
+                        ', timeouts ' + $1 + ' of ' + $2 + ' requests)');
+        },
+        serial, s_stats.timed_out, s_stats.requested);
+  }
+  return false;
+}
+
+const WebGPUReadbackStats& GetReadbackStats()
+{
+  return s_stats;
+}
+
+void CountSkippedReadback()
+{
+  s_stats.skipped++;
+}
+}  // namespace WebGPU
