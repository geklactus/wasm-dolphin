@@ -0,0 +1,73 @@
+// Copyright 2026 Dolphin Emulator Project (wasm-dolphin fork)
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "VideoBackends/WebGPU/WebGPUBoundingBox.h"
+
+#include <algorithm>
+#include <cstring>
+
+#include "VideoBackends/WebGPU/WebGPUCommandStream.h"
+#include "VideoBackends/WebGPU/WebGPUGfx.h"
+#include "VideoBackends/WebGPU/WebGPURendererFeatures.h"
+#include "VideoCommon/AbstractGfx.h"
+
+namespace WebGPU
+{
+std::vector<BBoxType> WebGPUBoundingBox::Read(u32 index, u32 length)
+{
+  std::vector<BBoxType> values(length);
+  if (length == 0 || index >= NUM_BBOX_VALUES)
+    return values;
+  length = std::min(length, NUM_BBOX_VALUES - index);
+
+  auto* gfx = static_cast<WebGPUGfx*>(g_gfx.get());
+  const u32 buffer = gfx ? gfx->EnsureBoundingBoxBuffer() : 0;
+  if (buffer != 0 && RendererFeatureEnabled(DOLPHIN_WEB_RENDERER_FEATURE_READBACK))
+  {
+    // The shaders that update the buffer ran in the pass being recorded.
+    gfx->EndPassForImmediateOp();
+    const u32 serial = ArmReadback(m_flag);
+    if (GetCommandStream().PushReadbackBuffer(
+            buffer, index * sizeof(BBoxType), length * sizeof(BBoxType),
+            HeapPointer(&m_readback[index]), HeapPointer(&m_flag)) &&
+        WebGPU::WaitForReadback(m_flag, serial))
+    {
+      for (u32 i = 0; i < length; i++)
+        m_shadow[index + i] = m_readback[index + i];
+    }
+    else
+    {
+      m_flag.expected.store(0, std::memory_order_release);
+      CountSkippedReadback();
+    }
+  }
+  else
+  {
+    CountSkippedReadback();
+  }
+  for (u32 i = 0; i < length; i++)
+    values[i] = m_shadow[index + i];
+  return values;
+}
+
+void WebGPUBoundingBox::Write(u32 index, std::span<const BBoxType> values)
+{
+  if (values.empty() || index >= NUM_BBOX_VALUES)
+    return;
+  const u32 length = std::min<u32>(static_cast<u32>(values.size()), NUM_BBOX_VALUES - index);
+  for (u32 i = 0; i < length; i++)
+    m_shadow[index + i] = values[i];
+
+  auto* gfx = static_cast<WebGPUGfx*>(g_gfx.get());
+  const u32 buffer = gfx ? gfx->EnsureBoundingBoxBuffer() : 0;
+  if (buffer == 0)
+    return;
+  WebGPUCommandStream& cs = GetCommandStream();
+  const u32 src = cs.UploadAlloc(values.data(), length * sizeof(BBoxType), 4);
+  if (src != 0)
+  {
+    cs.PushUploadBuffer(buffer, index * sizeof(BBoxType), src, length * sizeof(BBoxType),
+                        BufferUploadRole::Utility);
+  }
+}
+}  // namespace WebGPU
