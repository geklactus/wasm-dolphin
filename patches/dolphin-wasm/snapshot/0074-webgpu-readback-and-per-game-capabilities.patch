 #pragma once
 
+#include <array>
+#include <span>
+#include <vector>
+
 #include "Common/CommonTypes.h"
 
+#include "VideoBackends/WebGPU/WebGPUReadback.h"
 #include "VideoCommon/BoundingBox.h"
 
 namespace WebGPU
 {
+// Bounding box over the storage buffer the pixel shaders atomically update
+// (WebGPUGfx bind group 2, binding 0). Write uploads the game's values into
+// it; Read copies the four words back into the heap through
+// CmdOp::ReadbackBuffer and waits for the consumer, like every other
+// hardware backend waits for its GPU. Only reached when the readback feature
+// is on: VideoBackend reports bSupportsBBox from that bit, and VideoCommon
+// falls back to the game's own values otherwise.
 class WebGPUBoundingBox final : public BoundingBox
 {
 public:
   bool Initialize() override { return true; }
 
 protected:
-  // Day-14 scaffold: no GPU storage; reads always zero. Real BBox
-  // support needs a storage buffer + readback path under WebGPU.
-  std::vector<BBoxType> Read(u32 /* index */, u32 length) override
-  {
-    return std::vector<BBoxType>(length);
-  }
-  void Write(u32 /* index */, std::span<const BBoxType> /* values */) override {}
+  std::vector<BBoxType> Read(u32 index, u32 length) override;
+  void Write(u32 index, std::span<const BBoxType> values) override;
+
+private:
+  // The consumer stores into m_readback; stable address for the object's life.
+  alignas(16) std::array<BBoxType, NUM_BBOX_VALUES> m_readback{};
+  // Last values seen (written or read), served when the GPU cannot be asked.
+  std::array<BBoxType, NUM_BBOX_VALUES> m_shadow{};
+  WebGPUReadbackFlag m_flag;
 };
 
 }  // namespace WebGPU
diff --git a/Source/Core/VideoBackends/WebGPU/WebGPUCommandStream.cpp b/Source/Core/VideoBackends/WebGPU/WebGPUCommandStream.cpp
index f1ecf610fe..7fa1f472ae 100644
--- a/Source/Core/VideoBackends/WebGPU/WebGPUCommandStream.cpp
+++ b/Source/Core/VideoBackends/WebGPU/WebGPUCommandStream.cpp
@@ -1470,6 +1470,54 @@ bool WebGPUCommandStream::PushBlitTexture(u32 src_id, u32 dst_id, u32 src_x, u32
   return Push(rec);
 }
 
+bool WebGPUCommandStream::PushReadbackTexture(u32 tex_id, u32 x, u32 y, u32 w, u32 h,
+                                              u32 layer, u32 level, u32 texel_size,
+                                              u32 dst_heap_ptr, u32 dst_stride,
+                                              u32 flag_heap_ptr)
+{
+  if (!m_header || tex_id == 0 || w == 0 || h == 0 || texel_size == 0 || texel_size > 0xFFu ||
+      dst_heap_ptr == 0 || flag_heap_ptr == 0)
+    return false;
+  // Like BLIT_TEXTURE: an immediate encoder operation cannot execute ahead
+  // of an unpublished pass that produces its source. Callers end the open
+  // pass first (WebGPUGfx::EndPassForImmediateOp); this is the backstop.
+  if (m_pass_staging)
+  {
+    PoisonPass();
+    return false;
+  }
+  CmdRecord rec{};
+  rec.op = static_cast<u32>(CmdOp::ReadbackTexture);
+  rec.arg.u[0] = tex_id;
+  rec.arg.u[1] = Pack16(x, y);
+  rec.arg.u[2] = Pack16(w, h);
+  rec.arg.u[3] = (layer & 0xFFu) | ((level & 0xFFu) << 8) | ((texel_size & 0xFFu) << 16);
+  rec.arg.u[4] = dst_heap_ptr;
+  rec.arg.u[5] = dst_stride;
+  rec.arg.u[6] = flag_heap_ptr;
+  return Push(rec);
+}
+
+bool WebGPUCommandStream::PushReadbackBuffer(u32 buf_id, u32 src_offset, u32 len,
+                                             u32 dst_heap_ptr, u32 flag_heap_ptr)
+{
+  if (!m_header || buf_id == 0 || len == 0 || dst_heap_ptr == 0 || flag_heap_ptr == 0)
+    return false;
+  if (m_pass_staging)
+  {
+    PoisonPass();
+    return false;
+  }
+  CmdRecord rec{};
+  rec.op = static_cast<u32>(CmdOp::ReadbackBuffer);
+  rec.arg.u[0] = buf_id;
+  rec.arg.u[1] = src_offset;
+  rec.arg.u[2] = len;
+  rec.arg.u[3] = dst_heap_ptr;
+  rec.arg.u[4] = flag_heap_ptr;
+  return Push(rec);
+}
+
 WebGPUCommandStream& GetCommandStream()
 {
   static WebGPUCommandStream s_stream;
