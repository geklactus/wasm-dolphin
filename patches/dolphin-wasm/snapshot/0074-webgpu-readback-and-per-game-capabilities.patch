+// Copyright 2026 Dolphin Emulator Project (wasm-dolphin fork)
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+// Renderer feature mask for the WebGPU backend. ENABLE polarity: a set bit
+// turns the feature on. The storage and the exported accessors live in
+// WebGPUGfx.cpp; the host sets the mask before the core boots, and the
+// per-game profile table in src/game-profiles.js decides which bits a title
+// gets. Every bit here is a choice between two ways of serving VideoCommon,
+// so each one is documented against what upstream's other backends do.
+
+// Bit 0: partial and independent-channel EFB clears are emitted as a scissored
+// solid-quad draw inside the open pass (CmdOp::ClearRect) instead of a
+// whole-attachment loadOp clear. Mario Kart Wii does not render without it.
+inline constexpr unsigned int DOLPHIN_WEB_RENDERER_FEATURE_SCISSORED_CLEAR_RECT = 1u << 0;
+
+// Bit 1: report no early-Z support, so VideoCommon applies its zcomploc hack
+// (PipelineUtils.cpp: alpha test forced to pass on zcomploc draws that write
+// depth) instead of emitting FORCE_EARLY_Z. The shader path here is
+// GLSL -> SPIR-V -> Naga -> WGSL, and Naga's WGSL writer has no spelling for
+// the EarlyFragmentTests execution mode (WGSL has none), so the mode is
+// dropped silently: a discarded fragment then skips its depth write, which
+// is the exact failure FORCE_EARLY_Z exists to prevent. Upstream backends
+// without early-Z (GLES without the extension, old D3D) run the same hack.
+inline constexpr unsigned int DOLPHIN_WEB_RENDERER_FEATURE_ZCOMPLOC_HACK = 1u << 1;
+
+// Bit 2: report no logic-op support, so VideoCommon approximates logic ops
+// with blending itself (ShaderCache.cpp / PipelineUtils.cpp), including the
+// shader-side help for the modes blending alone cannot express. WebGPU has no
+// logic ops; the producer used to approximate on its own copy of the blend
+// state after the shader was already generated, so that help was never
+// available. This is what the Metal and GLES backends report.
+inline constexpr unsigned int DOLPHIN_WEB_RENDERER_FEATURE_LOGIC_OP_IN_VIDEOCOMMON = 1u << 2;
+
+// Bit 3: GPU readback. Staging textures copy their texels back into the wasm
+// heap (CmdOp::ReadbackTexture) and the bounding-box storage buffer is read
+// (CmdOp::ReadbackBuffer), with the video thread waiting on a heap flag the
+// consumer sets after mapAsync resolves. This is what makes EFB copies to RAM
+// (EFBToTextureEnable = False in upstream's GameSettings), EFB peeks and the
+// bounding box real on this backend; without it they read back zeros, which
+// is what every title in upstream's "needs EFB to RAM" list saw here. Off by
+// default because every readback is a pipeline stall the title must be shown
+// to need; src/game-profiles.js turns it on per game.
+inline constexpr unsigned int DOLPHIN_WEB_RENDERER_FEATURE_READBACK = 1u << 3;
+
+inline constexpr unsigned int DOLPHIN_WEB_RENDERER_FEATURE_DEFAULT =
+    DOLPHIN_WEB_RENDERER_FEATURE_SCISSORED_CLEAR_RECT |
+    DOLPHIN_WEB_RENDERER_FEATURE_ZCOMPLOC_HACK |
+    DOLPHIN_WEB_RENDERER_FEATURE_LOGIC_OP_IN_VIDEOCOMMON;
+
+extern "C" unsigned int DolphinWeb_SetRendererFeatureMask(unsigned int mask);
+extern "C" unsigned int DolphinWeb_GetRendererFeatureMask();
+
+namespace WebGPU
+{
+inline bool RendererFeatureEnabled(unsigned int bit)
+{
+  return (DolphinWeb_GetRendererFeatureMask() & bit) != 0;
+}
+}  // namespace WebGPU
