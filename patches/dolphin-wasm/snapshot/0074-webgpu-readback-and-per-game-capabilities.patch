+{
+// Completion word pair for a GPU -> heap readback (CmdOp::ReadbackTexture /
+// ReadbackBuffer). Lives inside the requesting object, so its address is
+// stable for as long as the request can complete:
+//   expected -- the serial of the request in flight, stored by the producer
+//               (video thread) before the record is pushed;
+//   done     -- stored by the JS consumer, with the serial it read from
+//               `expected` at replay time, after the mapped bytes have been
+//               copied into the heap; then Atomics.notify'd.
+// A serial rather than a boolean, so a completion that arrives after the
+// producer gave up on it (timeout) can never satisfy the next request.
+struct alignas(8) WebGPUReadbackFlag
+{
+  std::atomic<u32> done{0};
+  std::atomic<u32> expected{0};
+};
+
+// Arms `flag` for a new request and returns the serial to wait for.
+u32 ArmReadback(WebGPUReadbackFlag& flag);
+
+// Waits (futex, bounded) until the consumer completes the armed request.
+// Returns false on timeout, in which case the destination holds whatever it
+// held before (zeros for a fresh staging buffer). Logs the first few
+// timeouts to the console so a stuck consumer is visible, and counts them.
+bool WaitForReadback(WebGPUReadbackFlag& flag, u32 serial);
+
+// Readback statistics, for the status line and the bug log.
+struct WebGPUReadbackStats
+{
+  u32 requested = 0;
+  u32 completed = 0;
+  u32 timed_out = 0;
+  u32 skipped = 0;  // feature off, ring not live, or empty request
+};
+const WebGPUReadbackStats& GetReadbackStats();
+void CountSkippedReadback();
+
+inline u32 HeapPointer(const void* p)
+{
+  return static_cast<u32>(reinterpret_cast<uintptr_t>(p));
+}
+}  // namespace WebGPU
