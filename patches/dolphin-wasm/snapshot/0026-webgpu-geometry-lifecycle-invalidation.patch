From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: wasm-dolphin patch snapshot <snapshot@local.invalid>
Date: Thu, 22 Oct 2026 14:17:32 +0000
Subject: [PATCH] 0026-webgpu-geometry-lifecycle-invalidation


diff --git a/Source/Core/VideoBackends/WebGPU/WebGPUGfx.cpp b/Source/Core/VideoBackends/WebGPU/WebGPUGfx.cpp
index 1e1bd4c85a..a8b7921ec4 100644
--- a/Source/Core/VideoBackends/WebGPU/WebGPUGfx.cpp
+++ b/Source/Core/VideoBackends/WebGPU/WebGPUGfx.cpp
@@ -95,7 +95,7 @@ extern "C" EMSCRIPTEN_KEEPALIVE void SetWebGpuGeometryPackEnabled(int enabled)
   // Re-applying the setting around reset/save-load is an invalidation event.
   // The vertex manager observes this epoch and starts a fresh buffer id rather
   // than reusing destination bytes that an old command suffix may reference.
-  s_geometry_upload_pack_epoch.fetch_add(1, std::memory_order_release);
+  InvalidateGeometryUploadPack();
 }
 
 extern "C" EMSCRIPTEN_KEEPALIVE void SetWebGpuUploadArenaMiB(int mib, int metrics_enabled)
@@ -113,6 +113,11 @@ u64 GetGeometryUploadPackEpoch()
   return s_geometry_upload_pack_epoch.load(std::memory_order_acquire);
 }
 
+void InvalidateGeometryUploadPack()
+{
+  s_geometry_upload_pack_epoch.fetch_add(1, std::memory_order_release);
+}
+
 void RecordUboPrepareCpu(u32 class_index, double start_ms)
 {
   if (!s_ubo_cache_metrics_enabled.load(std::memory_order_relaxed))
@@ -1023,6 +1028,7 @@ void WebGPUGfx::AbortRecordedPass()
 {
   m_cmd_stream.AbortPass();
   m_pass_open = false;
+  InvalidateGeometryUploadPack();
   if (m_ubo_cache_active)
     InvalidateUboSlices();
   ResetRecordedPassState();
@@ -1041,6 +1047,7 @@ bool WebGPUGfx::EndPassIfOpen()
     return true;
   }
   m_cmd_stream.AbortPass();
+  InvalidateGeometryUploadPack();
   if (m_ubo_cache_active)
     InvalidateUboSlices();
   return false;
diff --git a/Source/Core/VideoBackends/WebGPU/WebGPUVertexManager.h b/Source/Core/VideoBackends/WebGPU/WebGPUVertexManager.h
index 1e4686c87c..0cb2ee3674 100644
--- a/Source/Core/VideoBackends/WebGPU/WebGPUVertexManager.h
+++ b/Source/Core/VideoBackends/WebGPU/WebGPUVertexManager.h
@@ -10,6 +10,7 @@ namespace WebGPU
 {
 bool IsGeometryUploadPackEnabled();
 u64 GetGeometryUploadPackEpoch();
+void InvalidateGeometryUploadPack();
 
 // Day-33 A3: a real VertexManagerBase for the remote WebGPU backend.
 //
