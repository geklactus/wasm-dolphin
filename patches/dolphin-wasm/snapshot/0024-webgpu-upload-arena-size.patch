diff --git a/Source/Core/VideoBackends/WebGPU/WebGPUCommandStream.cpp b/Source/Core/VideoBackends/WebGPU/WebGPUCommandStream.cpp
index f2a5a9f877..49c5ca15fe 100644
--- a/Source/Core/VideoBackends/WebGPU/WebGPUCommandStream.cpp
+++ b/Source/Core/VideoBackends/WebGPU/WebGPUCommandStream.cpp
@@ -46,9 +46,26 @@ static constexpr u32 kRingCapacity = 262144;
 // consumer (1-2 frames behind) ~tens of frames of recycle headroom
 // before the bump pointer wraps back over a region it might still be
 // reading. Mirrors the Day-20 XFB-ring idea (no per-frame malloc).
-static constexpr u32 kUploadArenaBytes = 32u * 1024u * 1024u;
 static constexpr u32 kProtocolUploadWatermark = 1u << 0;
 
+bool WebGPUCommandStream::ConfigureUploadArenaMiB(u32 mib, bool metrics_enabled)
+{
+  const u32 requested = mib == 64 ? kLargeUploadArenaBytes : kDefaultUploadArenaBytes;
+  if (m_upload_allocation_finalized.load(std::memory_order_acquire))
+  {
+    if (m_upload_requested_bytes.load(std::memory_order_relaxed) == requested)
+    {
+      m_upload_metrics_enabled.store(metrics_enabled, std::memory_order_relaxed);
+      return true;
+    }
+    m_upload_late_reject_count.fetch_add(1, std::memory_order_relaxed);
+    return false;
+  }
+  m_upload_requested_bytes.store(requested, std::memory_order_release);
+  m_upload_metrics_enabled.store(metrics_enabled, std::memory_order_relaxed);
+  return true;
+}
+
 void WebGPUCommandStream::EnsureRing()
 {
   if (m_header)
@@ -72,9 +89,21 @@ void WebGPUCommandStream::EnsureRing()
   // Per-frame upload arena (DESIGN §payload). Allocated once, never
   // freed; the producer bump-allocates into it and the consumer
   // reads straight from the shared heap (zero-copy).
-  m_upload_base = static_cast<u8*>(std::malloc(kUploadArenaBytes));
-  m_upload_size = m_upload_base ? kUploadArenaBytes : 0;
+  // Freeze configuration before reading it so a concurrent late setter can
+  // never relabel an already-started allocation.
+  m_upload_allocation_finalized.store(true, std::memory_order_release);
+  const u32 requested_upload_bytes =
+      m_upload_requested_bytes.load(std::memory_order_acquire);
+  m_upload_base = static_cast<u8*>(std::malloc(requested_upload_bytes));
+  m_upload_size = m_upload_base ? requested_upload_bytes : 0;
+  if (!m_upload_base && requested_upload_bytes == kLargeUploadArenaBytes)
+  {
+    m_upload_fallback_count.fetch_add(1, std::memory_order_relaxed);
+    m_upload_base = static_cast<u8*>(std::malloc(kDefaultUploadArenaBytes));
+    m_upload_size = m_upload_base ? kDefaultUploadArenaBytes : 0;
+  }
   m_upload_write = 0;
+  m_upload_configured_bytes.store(m_upload_size, std::memory_order_release);
 
   // Hand the ring + upload arena to the discio worker. The wasm heap
   // is a SharedArrayBuffer (USE_PTHREADS), so passing pointers is
@@ -322,10 +351,12 @@ u32 WebGPUCommandStream::ReserveUpload(size_t len, u32 align)
   const u32 offset = m_upload_write % m_upload_size;
   u32 aligned_offset = (offset + (align - 1)) & ~(align - 1);
   u32 padding = aligned_offset - offset;
+  bool wrapped = false;
   if (aligned_offset + len > m_upload_size)
   {
     padding += m_upload_size - aligned_offset;
     aligned_offset = 0;
+    wrapped = true;
   }
   const u32 begin = m_upload_write + padding;
   const u32 end = begin + static_cast<u32>(len);
@@ -400,6 +431,20 @@ u32 WebGPUCommandStream::ReserveUpload(size_t len, u32 align)
     }
   }
 
+  if (wrapped)
+    m_upload_wrap_count.fetch_add(1, std::memory_order_relaxed);
+  if (m_upload_metrics_enabled.load(std::memory_order_relaxed))
+  {
+    const u64 inflight = static_cast<u32>(
+        end - m_header->upload_read.load(std::memory_order_acquire));
+    u64 high_water = m_upload_high_water_bytes.load(std::memory_order_relaxed);
+    while (inflight > high_water &&
+           !m_upload_high_water_bytes.compare_exchange_weak(
+               high_water, inflight, std::memory_order_relaxed))
+    {
+    }
+  }
+
   m_last_upload_write_before = m_upload_write;
   m_last_upload_write_after = end;
   m_last_upload_ptr =
diff --git a/Source/Core/VideoBackends/WebGPU/WebGPUCommandStream.h b/Source/Core/VideoBackends/WebGPU/WebGPUCommandStream.h
index 4ffe7c21a5..f9dba06ff1 100644
--- a/Source/Core/VideoBackends/WebGPU/WebGPUCommandStream.h
+++ b/Source/Core/VideoBackends/WebGPU/WebGPUCommandStream.h
@@ -205,6 +205,12 @@ public:
   // Day-19 ShowImage). Idempotent.
   void EnsureRing();
 
+  // Select the upload arena before EnsureRing allocates it. Only 64 MiB is
+  // opt-in; every other value selects the 32 MiB default. Once the arena has
+  // been handed to JS, same-value reapplication is a no-op and a different
+  // request is rejected rather than invalidating the shared pointer.
+  bool ConfigureUploadArenaMiB(u32 mib, bool metrics_enabled);
+
   // Append one record. Drops the record (returns false) if the ring
   // is full — the consumer is behind; better to skip a frame's
   // commands than block the video pthread.
@@ -312,6 +318,34 @@ public:
   // Successful publication of SUBMIT_PRESENT is a FIFO reuse barrier: the
   // consumer submits all earlier encoded draws before replaying later uploads.
   u64 GetSubmitSerial() const { return m_submit_serial; }
+  u32 GetUploadArenaRequestedBytes() const
+  {
+    return m_upload_requested_bytes.load(std::memory_order_relaxed);
+  }
+  u32 GetUploadArenaConfiguredBytes() const
+  {
+    return m_upload_configured_bytes.load(std::memory_order_relaxed);
+  }
+  u64 GetUploadArenaFallbackCount() const
+  {
+    return m_upload_fallback_count.load(std::memory_order_relaxed);
+  }
+  u64 GetUploadArenaLateRejectCount() const
+  {
+    return m_upload_late_reject_count.load(std::memory_order_relaxed);
+  }
+  u64 GetUploadArenaWrapCount() const
+  {
+    return m_upload_wrap_count.load(std::memory_order_relaxed);
+  }
+  u64 GetUploadArenaHighWaterBytes() const
+  {
+    return m_upload_high_water_bytes.load(std::memory_order_relaxed);
+  }
+  bool GetUploadArenaMetricsEnabled() const
+  {
+    return m_upload_metrics_enabled.load(std::memory_order_relaxed);
+  }
 
   bool ready() const { return m_header != nullptr; }
 
@@ -345,6 +379,16 @@ private:
   u32 m_last_upload_ptr = 0;
   u32 m_last_upload_len = 0;
   u64 m_submit_serial = 0;
+  static constexpr u32 kDefaultUploadArenaBytes = 32u * 1024u * 1024u;
+  static constexpr u32 kLargeUploadArenaBytes = 64u * 1024u * 1024u;
+  std::atomic<u32> m_upload_requested_bytes{kDefaultUploadArenaBytes};
+  std::atomic<u32> m_upload_configured_bytes{0};
+  std::atomic<bool> m_upload_allocation_finalized{false};
+  std::atomic<bool> m_upload_metrics_enabled{false};
+  std::atomic<u64> m_upload_fallback_count{0};
+  std::atomic<u64> m_upload_late_reject_count{0};
+  std::atomic<u64> m_upload_wrap_count{0};
+  std::atomic<u64> m_upload_high_water_bytes{0};
 
   // BEGIN_PASS..END_PASS records stay private until END_PASS can publish the
   // entire batch. Resource creation/uploads remain immediate so the consumer
diff --git a/Source/Core/VideoBackends/WebGPU/WebGPUGfx.cpp b/Source/Core/VideoBackends/WebGPU/WebGPUGfx.cpp
