 }
 
+extern "C" EMSCRIPTEN_KEEPALIVE void SetWebGpuUploadArenaMiB(int mib, int metrics_enabled)
+{
+  GetCommandStream().ConfigureUploadArenaMiB(static_cast<u32>(mib), metrics_enabled != 0);
+}
+
 bool IsGeometryUploadPackEnabled()
 {
   return s_geometry_upload_pack_enabled.load(std::memory_order_relaxed);
@@ -135,7 +140,13 @@ extern "C" EMSCRIPTEN_KEEPALIVE const char* GetWebGpuStateCacheStats()
       << s_ubo_upload_bytes_suppressed[1].load(std::memory_order_relaxed) << ","
       << s_ubo_upload_bytes_suppressed[2].load(std::memory_order_relaxed)
       << " wggeom:" << (s_geometry_upload_pack_enabled.load(std::memory_order_relaxed) ? 1 : 0)
-      << " wggeomepoch:" << s_geometry_upload_pack_epoch.load(std::memory_order_relaxed);
+      << " wggeomepoch:" << s_geometry_upload_pack_epoch.load(std::memory_order_relaxed)
+      << " wgarena:" << GetCommandStream().GetUploadArenaRequestedBytes() << ","
+      << GetCommandStream().GetUploadArenaConfiguredBytes() << ","
+      << GetCommandStream().GetUploadArenaFallbackCount() << ","
+      << GetCommandStream().GetUploadArenaLateRejectCount() << ","
+      << GetCommandStream().GetUploadArenaWrapCount() << ","
+      << GetCommandStream().GetUploadArenaHighWaterBytes();
   stats = out.str();
   return stats.c_str();
 }
