+
   bool ProtocolV3Active() const;
   bool ConsumerFailed() const;
   bool WaitForRingSpace(u32 write, u32 count);
@@ -425,4 +427,13 @@ private:
 // one video pthread. A process-global accessor avoids threading a
 // reference through VideoCommon. EnsureRing() is idempotent.
 WebGPUCommandStream& GetCommandStream();
+
+// Native wasm regression seams. These execute the real command-stream upload,
+// publication, pass-staging, and rollback methods against an isolated tiny
+// ring; they do not require a browser GPU device or mutate the live stream.
+// Return 0 on success, otherwise a stable error code described by
+// GetWebGpuCommandStreamGeometrySmokeError().
+extern "C" int RunWebGpuCommandStreamGeometryParitySmoke(int indexed);
+extern "C" int RunWebGpuCommandStreamGeometryRollbackSmoke();
+extern "C" const char* GetWebGpuCommandStreamGeometrySmokeError();
 }  // namespace WebGPU
