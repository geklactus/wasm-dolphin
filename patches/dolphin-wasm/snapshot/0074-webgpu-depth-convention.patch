   }
   m_pending_clear_color = color_enable;
   m_pending_clear_depth = z_enable;
+  if (z_enable)
+    m_clear_depth = clear_depth;
   m_pending_clear = color_enable || z_enable;
   if (!m_pending_clear)
   {
@@ -1604,6 +1628,14 @@ u32 WebGPUGfx::PendingClearMask() const
     mask |= 2u;
   if (m_pending_clear_depth)
     mask |= 4u;
+  // Bit 3 plus bits 8..31: the depth clear value in the window convention, as a 24-bit
+  // fraction of 16777215. A consumer that does not know bit 3 keeps its hard-coded far clear,
+  // which is also what the legacy depth convention relies on, so it is not sent in that mode.
+  if (m_pending_clear_depth && !RendererFeatureLegacyDepth())
+  {
+    const float depth = std::clamp(m_clear_depth, 0.0f, 1.0f);
+    mask |= 8u | (static_cast<u32>(depth * 16777215.0f + 0.5f) << 8);
+  }
   return mask;
 }
 bool WebGPUGfx::BeginPassIfNeeded()
