+  const bool legacy_depth =
+      (renderer_features & DOLPHIN_WEB_RENDERER_FEATURE_LEGACY_DEPTH) != 0;
+  const float console_depth = static_cast<float>(z & 0xFFFFFF) / 16777216.0f;
+  const float clear_depth = legacy_depth ? console_depth : 1.0f - console_depth;
   const bool covers_efb = target_rc.left <= 0 && target_rc.top <= 0 &&
                           static_cast<u32>(std::max(0, target_rc.GetWidth())) >= efb_w &&
                           static_cast<u32>(std::max(0, target_rc.GetHeight())) >= efb_h;
@@ -1382,14 +1403,15 @@ void WebGPUGfx::ClearRegion(const MathUtil::Rectangle<int>& target_rc, bool colo
                      static_cast<u32>((color >> 24) & 0xff);
     // Flag 8 distinguishes independent RGB/alpha enables from legacy flag 1,
     // which enabled all four channels together.
+    // Flag 16 tells the consumer the depth is already in the window convention and is to be
+    // written as sent. Without it the consumer substitutes its hard-coded far clear.
     const u32 flags = 8u | (color_enable ? 1u : 0u) | (z_enable ? 2u : 0u) |
-                      (alpha_enable ? 4u : 0u);
+                      (alpha_enable ? 4u : 0u) | (legacy_depth ? 0u : 16u);
     const u32 cx = static_cast<u32>(std::max(0, target_rc.left));
     const u32 cy = static_cast<u32>(std::max(0, target_rc.top));
     const u32 cw = static_cast<u32>(std::max(0, target_rc.GetWidth()));
     const u32 ch = static_cast<u32>(std::max(0, target_rc.GetHeight()));
-    if (m_cmd_stream.PushClearRect(cx, cy, cw, ch, rgba,
-                                   static_cast<float>(z & 0xFFFFFF) / 16777216.0f, flags))
+    if (m_cmd_stream.PushClearRect(cx, cy, cw, ch, rgba, clear_depth, flags))
       return;
     // Fall through to the legacy over-clear if the record could not be staged.
   }
