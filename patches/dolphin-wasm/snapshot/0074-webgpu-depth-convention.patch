@@ -136,6 +136,18 @@ bool VertexShaderManager::UseVertexDepthRange()
   if (g_backend_info.bSupportsUnrestrictedDepthRange)
     return false;
 
+  // wasm-dolphin: a backend with neither depth clamping nor reversed depth ranges (WebGPU:
+  // Dawn rejects minDepth > maxDepth, and the consumer would otherwise swap the two and draw
+  // the range inside out) still carries an inverted console range in the vertex shader.
+  // Without depth clamping the GPU keeps clipping at the [0, 1] window, which coincides with
+  // the console's near and far planes for a full-range inverted viewport and clips a little
+  // wide for a partial one; oversized ranges stay clamped by BPFunctions as before.
+  if (!g_backend_info.bSupportsDepthClamp && !g_backend_info.bSupportsReversedDepthRange &&
+      !g_backend_info.bWebGPULegacyDepthConvention && xfmem.viewport.zRange < 0.0f)
+  {
+    return true;
+  }
+
   // We can't compute the depth range in the vertex shader if we don't support depth clamp.
   if (!g_backend_info.bSupportsDepthClamp)
     return false;
