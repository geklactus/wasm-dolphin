@@ -1283,6 +1295,15 @@ void WebGPUGfx::ClearRegion(const MathUtil::Rectangle<int>& target_rc, bool colo
   const u32 efb_w = g_framebuffer_manager ? g_framebuffer_manager->GetEFBWidth() : 0;
   const u32 efb_h = g_framebuffer_manager ? g_framebuffer_manager->GetEFBHeight() : 0;
   const unsigned int renderer_features = DolphinWeb_GetRendererFeatureMask();
+  // The game's 24-bit clear depth in this backend's window convention. It is reverse-Z (see
+  // VideoBackend::InitBackendInfo), so the console's far, 0xFFFFFF, becomes 0.0 -- the value
+  // the consumer used to hard-code for every clear. A game that clears to something else (the
